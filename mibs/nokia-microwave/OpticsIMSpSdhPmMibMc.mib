OPTICSIM-SDH-PM-MIB DEFINITIONS ::= BEGIN
       IMPORTS
       MODULE-IDENTITY, OBJECT-TYPE, 
       Integer32, Unsigned32, Gauge32 FROM SNMPv2-SMI
       RowStatus FROM SNMPv2-TC
       ifIndex FROM IF-MIB
       MODULE-COMPLIANCE, OBJECT-GROUP FROM SNMPv2-CONF
       OpticsIMPmIndex, OpticsIMPmElapsedTime, OpticsIMPmGranularityPeriod,
       OpticsIMPmMaxSuppressedIntervals, OpticsIMPmNumSuppressedIntervals, 
       OpticsIMPmSuspectIntervalFlag, OpticsIMPmThresholdDataInstance, 
       OpticsIMPmPeriodTime, OpticsIMThrIndexNext2 FROM  OPTICSIM-COMMON-TC
       opticsimSdhPdhMib,opticsimSdhPdhMC FROM OPTICSIM-RADIOREG-MIB
       TsdimManagerType, OpticsIMUserLabel FROM TSDIM-SNMP-TC;

 opticsIMSdhPmMib MODULE-IDENTITY
       LAST-UPDATED "1509040000Z"
       ORGANIZATION "Alcatel TND"
       CONTACT-INFO "Alcatel TND"
       DESCRIPTION
        "	D.Spreafico: 
	- added pmRsMonitoringCDLps to opticsIMRsMonitoringCurrentDataTable
     - added pmRsMonitoringHDLps to opticsIMRsMonitoringHistoryDataTable
	- added pmRsMonitoringLpsHighThr and pmRsMonitoringLpsLowThr          to opticsIMRsMonitoringThresholdDataTable 
	- added pmRsMonitoringOfsHighThr, pmRsMonitoringOfsLowThr, pmRsMonitoringLpsHighThr and pmRsMonitoringLpsLowhThr on 
opticsIMRsMonitoringThresholdDataTable "

       REVISION "1009300000Z"
       DESCRIPTION
                "Updating for some compilation bugs"

       REVISION "1004010000Z"
       DESCRIPTION
                "Added opticsIMRsMonitoringCurrentDataTable, opticsIMRsMonitoringHistoryDataTable and opticsIMRsMonitoringThresholdDataTable"

       REVISION "0808070000Z"
       DESCRIPTION
                "Fixed inconsistency in GROUP name"

       REVISION "0404300000Z"
       DESCRIPTION
                "Added new table for Multiplex Section and SDH Vc4 and Vc3 Performance Monitoring."

       REVISION "0303140000Z"
       DESCRIPTION
                "Change of some syntax types due to renaming of Common PM Textual Conventions."

       REVISION "0201250000Z"
       DESCRIPTION
                "Import of TSDIM-PM-MIB substituted by OPTICSIM-COMMON-TC, deletion of  
                 pmRsUasHighThr,  pmRsUasLowThr, pmRsOfsHighThr and pmRsOfsLowThr objects"

       REVISION "0110190000Z"
       DESCRIPTION
                "Initial Release of SDH PM MIB"
 ::= {  opticsimSdhPdhMib  5}


opticsIMSdhPmMibObject      OBJECT IDENTIFIER ::= { opticsIMSdhPmMib 1 }


opticsIMRsCurrentDataTable OBJECT-TYPE
       SYNTAX SEQUENCE OF OpticsIMRsCurrentDataEntry
       MAX-ACCESS not-accessible
       STATUS current
       DESCRIPTION
             "This table contains the current data for the SDH Regenerator  Section. "
::= { opticsIMSdhPmMibObject 1 }

opticsIMRsCurrentDataEntry OBJECT-TYPE
       SYNTAX OpticsIMRsCurrentDataEntry
       MAX-ACCESS not-accessible
       STATUS current
       DESCRIPTION
            "An entry of the SDH regenerator section current data table. 

            An unavailable condition starts when 10 consecutive severely errored seconds have been 
            detected; these 10 seconds belong to the unavailable time. An unavailable condition 
            ends when 10 consecutive seconds with no severely errored second are detected. 
            These 10 seconds belong to  the available time.   
            If an unavailable period is ending then the UAT Clear shall be sent.

            These performance event counts are inhibited during unavailable time.

            In the objects where a Default Value is specified, the write operation is allowed only to the 
            indicated default value.
            The write operation to one counter is applied to all the counters of all the the associated objects, 
            which have a defined default."
       INDEX          {  ifIndex, pmRsCDIndex}
       ::= { opticsIMRsCurrentDataTable 1 }   

OpticsIMRsCurrentDataEntry ::= SEQUENCE {
   pmRsCDIndex                                OpticsIMPmIndex,
   pmRsCDElapsedTime                    OpticsIMPmElapsedTime,
   pmRsCDGranularityPeriod             OpticsIMPmGranularityPeriod, 
   pmRsCDMaxSuppressedIntervals OpticsIMPmMaxSuppressedIntervals, 
   pmRsCDNumSuppressedIntervals OpticsIMPmNumSuppressedIntervals,
   pmRsCDSuspectIntervalFlag         OpticsIMPmSuspectIntervalFlag,
   pmRsCDThresholdDataInstance   OpticsIMPmThresholdDataInstance,
   pmRsCDStartByOS                       TsdimManagerType,
   pmRsCDSes                                  Gauge32,
   pmRsCDUas                                  Gauge32,
   pmRsCDBbe                                  Gauge32,
   pmRsCDEs                                    Gauge32,
   pmRsCDOfs                                   Gauge32,
   pmRsCDRowStatus                       RowStatus,
   pmRsCDAsapIndex                       Integer32
   }

pmRsCDIndex OBJECT-TYPE
       SYNTAX OpticsIMPmIndex
       MAX-ACCESS not-accessible
       STATUS current
       DESCRIPTION
           "See Textual Conventions."
::= { opticsIMRsCurrentDataEntry 1 }

pmRsCDElapsedTime OBJECT-TYPE
       SYNTAX OpticsIMPmElapsedTime
       MAX-ACCESS read-only
       STATUS current
       DESCRIPTION
            "See Textual Conventions."
::= { opticsIMRsCurrentDataEntry 2 }

pmRsCDGranularityPeriod OBJECT-TYPE
       SYNTAX OpticsIMPmGranularityPeriod
       MAX-ACCESS read-only
       STATUS current
       DESCRIPTION
            "See Textual Conventions."
::= { opticsIMRsCurrentDataEntry 3 }

pmRsCDMaxSuppressedIntervals OBJECT-TYPE
       SYNTAX OpticsIMPmMaxSuppressedIntervals
       MAX-ACCESS read-create
       STATUS current
       DESCRIPTION
            "See Textual Conventions."
::= { opticsIMRsCurrentDataEntry 4 }

pmRsCDNumSuppressedIntervals OBJECT-TYPE
       SYNTAX OpticsIMPmNumSuppressedIntervals
       MAX-ACCESS read-only
       STATUS current
       DESCRIPTION
            "See Textual Conventions."
::= { opticsIMRsCurrentDataEntry 5 }

pmRsCDSuspectIntervalFlag OBJECT-TYPE
       SYNTAX OpticsIMPmSuspectIntervalFlag
       MAX-ACCESS read-create
       STATUS current
       DESCRIPTION
            "See Textual Conventions."
       DEFVAL {1} -- True
::= { opticsIMRsCurrentDataEntry 6 }

pmRsCDThresholdDataInstance OBJECT-TYPE
       SYNTAX  OpticsIMPmThresholdDataInstance
       MAX-ACCESS read-create
       STATUS current
       DESCRIPTION
            "See Textual Conventions."
::= { opticsIMRsCurrentDataEntry 7 }

pmRsCDStartByOS OBJECT-TYPE
       SYNTAX TsdimManagerType
       MAX-ACCESS read-only
       STATUS current
       DESCRIPTION
            " See Textual Conventions."
::= { opticsIMRsCurrentDataEntry 8 }

pmRsCDSes OBJECT-TYPE
       SYNTAX Gauge32
       MAX-ACCESS read-create
       STATUS current
       DESCRIPTION
            "The number of SES. "
       DEFVAL {0} 
::= { opticsIMRsCurrentDataEntry 9 }

pmRsCDUas OBJECT-TYPE
       SYNTAX Gauge32
       MAX-ACCESS read-create
       STATUS current
       DESCRIPTION
            "The number of UAS. "
       DEFVAL {0} 
::= { opticsIMRsCurrentDataEntry 10 }

pmRsCDBbe OBJECT-TYPE
       SYNTAX Gauge32
       MAX-ACCESS read-create
       STATUS current
       DESCRIPTION
            "The number of BBE."
       DEFVAL {0} 
::= { opticsIMRsCurrentDataEntry 11 }

pmRsCDEs  OBJECT-TYPE
       SYNTAX Gauge32
       MAX-ACCESS read-create
       STATUS current
       DESCRIPTION
            "The number of ES."
       DEFVAL {0} 
::= { opticsIMRsCurrentDataEntry 12 }

pmRsCDOfs OBJECT-TYPE
       SYNTAX Gauge32
       MAX-ACCESS read-create
       STATUS current
       DESCRIPTION
            "The number of OFS."
       DEFVAL {0} 
::= { opticsIMRsCurrentDataEntry 13 }

pmRsCDRowStatus OBJECT-TYPE
       SYNTAX RowStatus
       MAX-ACCESS read-create
       STATUS current
       DESCRIPTION
         "When an entry of this table is deleted the corresponding entries of HD table are deleted.

          When an entry of this table is put to not in service, the measures of this CD are frozen, that is all
          the counters are stopped."
::= { opticsIMRsCurrentDataEntry 14 }

pmRsCDAsapIndex OBJECT-TYPE
       SYNTAX Integer32 
       MAX-ACCESS read-create 
       STATUS current
       DESCRIPTION
         "It indicates the ASAP object associated to this CD."
::= { opticsIMRsCurrentDataEntry 15 }

opticsIMRsHistoryDataTable OBJECT-TYPE
       SYNTAX SEQUENCE OF OpticsIMRsHistoryDataEntry
       MAX-ACCESS not-accessible
       STATUS current
       DESCRIPTION
            "This table contains the History data for the SDH Regenerator Section. "
::= { opticsIMSdhPmMibObject 2 }

opticsIMRsHistoryDataEntry OBJECT-TYPE
       SYNTAX OpticsIMRsHistoryDataEntry
       MAX-ACCESS not-accessible
       STATUS current
       DESCRIPTION
            "One entry of this table is created at the end of the time interval of the related CD (defined by 
            granularity Period).

            At most n entries of opticsIMRsHistoryDataTable can be created indexed by the indexes of the 
            corresponding CD entry and by the time of the measure (pmRsHDPeriodEndTime). 

            This set of n entries is wrapped, when the n+1 measure is provided. 
            The n+1 measure is written in the row of the table indexed by the smallest value of 
             PeriodEndTime. "
       INDEX       { ifIndex, pmRsCDIndex, pmRsHDPeriodEndTime }
::= { opticsIMRsHistoryDataTable 1 }

OpticsIMRsHistoryDataEntry ::= SEQUENCE {
   pmRsHDElapsedTime                    OpticsIMPmElapsedTime,
   pmRsHDGranularityPeriod             OpticsIMPmGranularityPeriod, 
   pmRsHDNumSuppressedIntervals OpticsIMPmNumSuppressedIntervals, 
   pmRsHDPeriodEndTime                OpticsIMPmPeriodTime,
   pmRsHDSuspectIntervalFlag         OpticsIMPmSuspectIntervalFlag,
   pmRsHDStartByOS                        TsdimManagerType,
   pmRsHDSes                                   Gauge32,
   pmRsHDUas                                   Gauge32,
   pmRsHDBbe                                   Gauge32,
   pmRsHDEs                                     Gauge32,
   pmRsHDOfs                                    Gauge32
   }

pmRsHDElapsedTime OBJECT-TYPE
     SYNTAX OpticsIMPmElapsedTime
     MAX-ACCESS read-only
     STATUS current
     DESCRIPTION
          "See Textual Conventions."
::= { opticsIMRsHistoryDataEntry 1 }

