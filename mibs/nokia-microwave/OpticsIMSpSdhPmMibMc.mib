opticsIMMsFECurrentDataTable OBJECT-TYPE
       SYNTAX SEQUENCE OF OpticsIMMsFECurrentDataEntry
       MAX-ACCESS not-accessible
       STATUS current
       DESCRIPTION
             "This table contains the current data for the SDH Multiplex Section Far End."
::= { opticsIMSdhPmMibObject 11 }

opticsIMMsFECurrentDataEntry OBJECT-TYPE
       SYNTAX OpticsIMMsFECurrentDataEntry
       MAX-ACCESS not-accessible
       STATUS current
       DESCRIPTION
            "An entry of the SDH multiplex section Far End current data table. 

            An unavailable condition starts when 10 consecutive severely errored seconds have been 
            detected; these 10 seconds belong to the unavailable time. An unavailable condition 
            ends when 10 consecutive seconds with no severely errored second are detected. 
            These 10 seconds belong to  the available time.   
            If an unavailable period is ending then the UAT Clear shall be sent.

            These performance event counts are inhibited during unavailable time.

            In the objects where a Default Value is specified, the write operation is allowed only to the 
            indicated default value.
            The write operation to one counter is applied to all the counters of all the the associated objects, 
            which have a defined default."
       INDEX          {  ifIndex, pmMsFECDIndex}
       ::= { opticsIMMsFECurrentDataTable 1 }   

OpticsIMMsFECurrentDataEntry ::= SEQUENCE {
   pmMsFECDIndex                                OpticsIMPmIndex,
   pmMsFECDElapsedTime                    OpticsIMPmElapsedTime,
   pmMsFECDGranularityPeriod             OpticsIMPmGranularityPeriod, 
   pmMsFECDMaxSuppressedIntervals OpticsIMPmMaxSuppressedIntervals, 
   pmMsFECDNumSuppressedIntervals OpticsIMPmNumSuppressedIntervals,
   pmMsFECDSuspectIntervalFlag         OpticsIMPmSuspectIntervalFlag,
   pmMsFECDThresholdDataInstance   OpticsIMPmThresholdDataInstance,
   pmMsFECDStartByOS                       TsdimManagerType,
   pmMsFECDSes                                  Gauge32,
   pmMsFECDUas                                  Gauge32,
   pmMsFECDBbe                                  Gauge32,
   pmMsFECDEs                                    Gauge32,
   pmMsFECDRowStatus                       RowStatus,
   pmMsFECDAsapIndex                       Integer32
   }

pmMsFECDIndex OBJECT-TYPE
       SYNTAX OpticsIMPmIndex
       MAX-ACCESS not-accessible
       STATUS current
       DESCRIPTION
           "See Textual Conventions."
