opticsIMVc3FECurrentDataTable OBJECT-TYPE
       SYNTAX SEQUENCE OF OpticsIMVc3FECurrentDataEntry
       MAX-ACCESS not-accessible
       STATUS current
       DESCRIPTION
             "This table contains the current data for the SDH Vc3 Far End."
::= { opticsIMSdhPmMibObject 27 }

opticsIMVc3FECurrentDataEntry OBJECT-TYPE
       SYNTAX OpticsIMVc3FECurrentDataEntry
       MAX-ACCESS not-accessible
       STATUS current
       DESCRIPTION
            "An entry of the SDH Vc3 Far End current data table. 
            An unavailable condition starts when 10 consecutive severely errored seconds have been 
            detected; these 10 seconds belong to the unavailable time. An unavailable condition 
            ends when 10 consecutive seconds with no severely errored second are detected. 
            These 10 seconds belong to  the available time.   
            If an unavailable period is ending then the UAT Clear shall be sent.
            These performance event counts are inhibited during unavailable time.
            In the objects where a Default Value is specified, the write operation is allowed only to the 
            indicated default value.
            The write operation to one counter is applied to all the counters of all the the associated objects, 
            which have a defined default."
       INDEX          {  ifIndex, pmVc3FECDIndex}
       ::= { opticsIMVc3FECurrentDataTable 1 }   

OpticsIMVc3FECurrentDataEntry ::= SEQUENCE {
   pmVc3FECDIndex                                OpticsIMPmIndex,
   pmVc3FECDElapsedTime                    OpticsIMPmElapsedTime,
   pmVc3FECDGranularityPeriod             OpticsIMPmGranularityPeriod, 
   pmVc3FECDMaxSuppressedIntervals OpticsIMPmMaxSuppressedIntervals, 
   pmVc3FECDNumSuppressedIntervals OpticsIMPmNumSuppressedIntervals,
   pmVc3FECDSuspectIntervalFlag         OpticsIMPmSuspectIntervalFlag,
   pmVc3FECDThresholdDataInstance   OpticsIMPmThresholdDataInstance,
   pmVc3FECDStartByOS                       TsdimManagerType,
   pmVc3FECDSes                                  Gauge32,
   pmVc3FECDUas                                  Gauge32,
   pmVc3FECDBbe                                  Gauge32,
   pmVc3FECDEs                                    Gauge32,
   pmVc3FECDRowStatus                       RowStatus,
   pmVc3FECDAsapIndex                       Integer32
   }

pmVc3FECDIndex OBJECT-TYPE
       SYNTAX OpticsIMPmIndex
       MAX-ACCESS not-accessible
       STATUS current
       DESCRIPTION
           "See Textual Conventions."
