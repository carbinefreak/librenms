   pmVc3FEHDPeriodEndTime                OpticsIMPmPeriodTime,
   pmVc3FEHDSuspectIntervalFlag         OpticsIMPmSuspectIntervalFlag,
   pmVc3FEHDStartByOS                        TsdimManagerType,
   pmVc3FEHDSes                                   Gauge32,
   pmVc3FEHDUas                                   Gauge32,
   pmVc3FEHDBbe                                   Gauge32,
   pmVc3FEHDEs                                     Gauge32
}

