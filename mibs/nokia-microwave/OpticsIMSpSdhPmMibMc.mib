   pmRsMonitoringOfsLowThr          	Unsigned32,
   pmRsMonitoringLpsHighThr         	Unsigned32,
   pmRsMonitoringLpsLowThr          	Unsigned32,
   pmRsMonitoringUserLabel         	OpticsIMUserLabel,
   pmRsMonitoringRowStatus         	RowStatus
   }

