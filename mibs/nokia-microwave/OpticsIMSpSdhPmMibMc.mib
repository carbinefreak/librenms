   pmVc4FECDNumSuppressedIntervals OpticsIMPmNumSuppressedIntervals,
   pmVc4FECDSuspectIntervalFlag         OpticsIMPmSuspectIntervalFlag,
   pmVc4FECDThresholdDataInstance   OpticsIMPmThresholdDataInstance,
   pmVc4FECDStartByOS                       TsdimManagerType,
   pmVc4FECDSes                                  Gauge32,
   pmVc4FECDUas                                  Gauge32,
   pmVc4FECDBbe                                  Gauge32,
   pmVc4FECDEs                                    Gauge32,
   pmVc4FECDRowStatus                       RowStatus,
   pmVc4FECDAsapIndex                       Integer32
   }

