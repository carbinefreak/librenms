allowedDs3LineLengthMin OBJECT-TYPE
     SYNTAX 					Integer32
     MAX-ACCESS			read-only
     STATUS					current
     DESCRIPTION
       " This object contains the minimum value allowed for the length of the ds3 line expressed in feet. "
::= { opticsIMAllowedDs3LineLengthsEntry 2 }

allowedDs3LineLengthMax OBJECT-TYPE
     SYNTAX 					Integer32
     MAX-ACCESS			read-only
     STATUS					current
     DESCRIPTION
       " This object contains the maximum value allowed for the length of the ds3 line expressed in feet. "
::= { opticsIMAllowedDs3LineLengthsEntry 3 }

allowedDs3LineLengthId OBJECT-TYPE
     SYNTAX 					OpticsIMDs3pPILineLength
     MAX-ACCESS			read-only
     STATUS					current
     DESCRIPTION
       " This object contains the identifier of a range of ds3 lines lengths. It contains the same value of
         allowedDs3LineLengthIndex  but it’s readable by the user."
::= { opticsIMAllowedDs3LineLengthsEntry 4 }

opticsIMPdhRAIInsertionTable OBJECT-TYPE
     SYNTAX SEQUENCE OF	OpticsIMPdhRAIInsertionEntry
     MAX-ACCESS					not-accessible
     STATUS							current
     DESCRIPTION
          "This table contains the information related to the RAI insertion management in PDH signals. "
::= { opticsIMTrsCommonMibObject 6 }

opticsIMPdhRAIInsertionEntry OBJECT-TYPE
     SYNTAX				OpticsIMPdhRAIInsertionEntry
     MAX-ACCESS		not-accessible
     STATUS				current
     DESCRIPTION
          " An entry of the opticsIMPdhRAIInsertionTable. "
     INDEX  { ifIndex, pdhRAIInsertionSignalType }
::= { opticsIMPdhRAIInsertionTable 1 } 

OpticsIMPdhRAIInsertionEntry ::= SEQUENCE {
   pdhRAIInsertionSignalType	INTEGER,
   pdhRAIInsertionStatus			INTEGER
   }

pdhRAIInsertionSignalType OBJECT-TYPE
     SYNTAX INTEGER {
          e1pPI  (1),
          e1Path  (2),
          ds3pPI  (3),
          ds3Path  (4)
          }
     MAX-ACCESS		not-accessible 
     STATUS				current
     DESCRIPTION
        " This object specifies the PDH signal (E1 or DS3) and the direction (pPI or path) on which the RAI 
          insertion management is performed. "
::= { opticsIMPdhRAIInsertionEntry 1 }

pdhRAIInsertionStatus OBJECT-TYPE
     SYNTAX INTEGER {
          enabled  (1),
          inhibited  (2),
          forced  (3)
          }
     MAX-ACCESS		read-write 
     STATUS				current
     DESCRIPTION
        " This object specifies the status of the RAI insertion. "
::= { opticsIMPdhRAIInsertionEntry 2 }


opticsIMAllDs1LineCoding OBJECT-TYPE
     SYNTAX INTEGER {
          idle  (1),
          setAllDs1ToAMI (2),
          setAllDs1ToB8ZS (3)
          }
     MAX-ACCESS		read-write 
     STATUS				current
     DESCRIPTION
        " This object is used to specify, in one shot, the code of all the ds1 lines. As consequence of a set 
          operation on this object,  the agent has to set to the required value (AMI or B8ZS) the LineCoding
          columnar object of all the entries present in the opticsIMDs1pPITTPTable. 
          At the end of this operation the agent has to change the value of this object back to idle.  "
::= { opticsIMTrsCommonMibObject 7 }


opticsIMAllDs1LineLength OBJECT-TYPE
     SYNTAX				OpticsIMDs1pPILineLength
     MAX-ACCESS		read-write 
     STATUS				current
     DESCRIPTION
        " This object is used to specify, in one shot, the length of all the ds1 lines. As consequence of a set 
          operation on this object,  the agent has to set to the required value the LineLength columnar object 
          of all the entries present in the opticsIMDs1pPITTPTable."
::= { opticsIMTrsCommonMibObject 8 }


opticsIMAllDs1AISSignalType OBJECT-TYPE
     SYNTAX				OpticsIMDs1E1AISSignalType
     MAX-ACCESS		read-write 
     STATUS				current
     DESCRIPTION
        " This object is used to specify, in one shot, the type of AIS signal to be inserted (if enabled) 
        on all the ds1 lines. As consequence of a set operation on this object,  the agent has to set to the
        required value the AISSignalType columnar object of all the entries present in the
        opticsIMDs1pPITTPTable."
::= { opticsIMTrsCommonMibObject 11 }


opticsIMAllDs1pPIAISInsertion OBJECT-TYPE
     SYNTAX				OpticsIMAISInsertion
     MAX-ACCESS		read-write 
     STATUS				current
     DESCRIPTION
        " This object is used to specify, in one shot, whether the AIS (Alarm Indication Signal) insertion
         is allowed on pPI direction on all the ds1 lines. As consequence of a set operation on this object,
         the agent has to set to the required value the AISInsertion columnar object of all the entries present 
         in the opticsIMDs1pPITTPTable."
::= { opticsIMTrsCommonMibObject 12 }


opticsIMAllDs1PathAISInsertion OBJECT-TYPE
     SYNTAX				OpticsIMAISInsertion
     MAX-ACCESS		read-write 
     STATUS				current
     DESCRIPTION
        " This object is used to specify, in one shot, whether the AIS (Alarm Indication Signal) insertion
         is allowed on path direction on all the ds1 lines. As consequence of a set operation on this object,
         the agent has to set to the required value the AISInsertion columnar object of all the entries present 
         in the opticsIMDs1PathTTPTable."
::= { opticsIMTrsCommonMibObject 13 }


opticsIMAllE1AISSignalType OBJECT-TYPE
     SYNTAX				OpticsIMDs1E1AISSignalType
     MAX-ACCESS		read-write 
     STATUS				current
     DESCRIPTION
        " This object is used to specify, in one shot, the type of AIS signal to be inserted (if enabled) 
        on all the e1 lines. As consequence of a set operation on this object,  the agent has to set to the
        required value the AISSignalType columnar object of all the entries present in the
        opticsIME1pPITTPTable."
::= { opticsIMTrsCommonMibObject 14 }


opticsIMAllE1pPIAISInsertion OBJECT-TYPE
     SYNTAX				OpticsIMAISInsertion
     MAX-ACCESS		read-write 
     STATUS				current
     DESCRIPTION
        " This object is used to specify, in one shot, whether the AIS (Alarm Indication Signal) insertion
         is allowed on pPI direction on all the e1 lines. As consequence of a set operation on this object,
         the agent has to set to the required value the AISInsertion columnar object of all the entries present 
         in the opticsIME1pPITTPTable."
::= { opticsIMTrsCommonMibObject 15 }


opticsIMAllE1PathAISInsertion OBJECT-TYPE
     SYNTAX				OpticsIMAISInsertion
     MAX-ACCESS		read-write 
     STATUS				current
     DESCRIPTION
        " This object is used to specify, in one shot, whether the AIS (Alarm Indication Signal) insertion
         is allowed on path direction on all the e1 lines. As consequence of a set operation on this object,
         the agent has to set to the required value the AISInsertion columnar object of all the entries present 
         in the opticsIME1PathTTPTable."
::= { opticsIMTrsCommonMibObject 16 }



opticsIMAllDs3pPIParityViolationMonitoringRemoving OBJECT-TYPE
     SYNTAX				OpticsIMDs3ParityViolationMonitoringRemoving
     MAX-ACCESS		read-write 
     STATUS				current
     DESCRIPTION
        " This object is used to specify, in one shot, whether the Parity Violation Monitoring Removing
