OPTICSIM-TRS-COMMON-MIB DEFINITIONS ::= BEGIN
       IMPORTS
       MODULE-IDENTITY, OBJECT-TYPE, NOTIFICATION-TYPE,
       Integer32, Unsigned32 FROM SNMPv2-SMI
       TruthValue, TimeInterval, TimeStamp, DisplayString, RowStatus, TEXTUAL-CONVENTION FROM SNMPv2-TC
       ifIndex FROM IF-MIB
       MODULE-COMPLIANCE, OBJECT-GROUP, NOTIFICATION-GROUP FROM SNMPv2-CONF
       tsdimEventObjectClassIdentifier, tsdimEventObjectInstanceIdentifier,
       tsdimEventNotificationId, tsdimEventTime, tsdimAlarmSeverity,
       tsdimAlarmSpecProblem, opticsIMAdditionalText, opticsIMAlarmType FROM TSDIM-SUPPORT-MIB
       opticsimSdhPdhMib, opticsimSdhPdhMC FROM OPTICSIM-RADIOREG-MIB
       TsdimOperationalState FROM TSDIM-SNMP-TC;

 opticsIMTrsCommonMib MODULE-IDENTITY


       LAST-UPDATED "0904230000Z"
       ORGANIZATION "Alcatel TND"
       CONTACT-INFO "Alcatel TND"
       DESCRIPTION 
                "Added the value 'none' to e1pPITTPClockSource and ds1pPITTPClockSource  "

       REVISION "0808070000Z"
       DESCRIPTION 
                "The opticsIME1pPITTPTable has been modified adding the following attributes:
                 - e1pPPITTPClockSource
                 - e1pPPITTPClockCapability
                 - e1pPPITTPDs0ChanIndexNext
                 - e1pPPITTPBoundleNumber
                 - e1pPPITTPEncapsType

                 The opticsIMDs1pPITTPTable has been modified adding the following attributes:
                 - ds1pPPITTPClockSource
                 - ds1pPPITTPClockCapability
                 - ds1pPPITTPDs0ChanIndexNext
                 - ds1pPPITTPBoundleNumber
                 - ds1pPPITTPEncapsType

                 The opticsIMTrsDS0Mngt branch has been added including the following object:
                 - opticsIMDS0ChanGroupTable

                 S. Winslow:
                 - Fixed inconsistent OBJECT-GROUP name (opticsIMAllowedDs1LineLengthsGroup, 
                                                         opticsIMAllowedDs3LineLengthsGroup)
"

       REVISION "0710110000Z"
       DESCRIPTION
                "The columnar object TimeSlotTMN has been added to opticsIME1pPITTPTable"

       REVISION "0510270000Z"
       DESCRIPTION
                "The columnar object xxCrossConnectIdentifier has been added to opticsIME1pPITTPTable, 
                 opticsIMDs1pPITTPTable, opticsIME3pPITTPTable, opticsIMDs3pPITTPTable "

       REVISION "0504070000Z"
       DESCRIPTION
                "For each alarm notification (raise and clear) the following objects have been added:
                - opticsIMAdditionalText
                - opticsIMAlarmType"

       REVISION "0410150000Z"
       DESCRIPTION
                "Added opticsIMAllowedDs3LineLengthsTable and ds3pPITTPLineLength columnar object on
                 opticsIMDs3pPITTPTable ."

       REVISION "0409300000Z"
       DESCRIPTION
                "Added e1pPITTPPseudoRandSeqInsertion columnar object
                 on OpticsIME1pPITTPEntry  and e3pPITTPPseudoRandSeqInsertion columnar object on
                 OpticsIME3pPITTPEntry.
                Added ds3pPITTPInputBridgeEnabled columnar objet on opticsIMDs3pPITTPEntry.
                Deprecated index berMeasureMonitoredSignal on opticsIMBERMeasuresTable."

       REVISION "0406150000Z"
       DESCRIPTION
                " In opticsIMTrsCommonMib: added new columnar objects in OpticsIMDs3pPITTPEntry,
                  in OpticsIMDs3PathTTPEntry, in OpticsIMDs1pPITTPEntry, in OpticsIMDs1PathTTPEntry,
                  in OpticsIME1pPITTPEntry and in OpticsIME1PathTTPEntry 
                  for AIS management (signal type and insertion enable, timing), Parity Violation Monitoring 
                  Removing and idle signal insertion both for single and for all lines;
                  added new index in opticsIMBERMeasuresTable (opticsIMBERMeasureMonitoringType)."

       REVISION "0404300000Z"
       DESCRIPTION
                "Added opticsIMAllowedDs1LineLengthTable and changed the behaviour of
                 OpticsIMDs1pPILineLength  textual-convention"

       REVISION "0310100000Z"
       DESCRIPTION
                "Removal of opticsIMGMAUTTPBidTable. "

       REVISION "0303140000Z"
       DESCRIPTION
                "Addition of BER Measures table. "

       REVISION "0303140000Z"
       DESCRIPTION
                "Addition of RAI insertion table, line length object in ds1pPITTPTable, line code and line length  
                 scalar objects, deletion of PDH tributaries unidirectional tables, regrouping of PDH 
                 tributaries tables. LAPD fail and URU traps moved in tsdimSnmpNEMib. "

       REVISION "0211050000Z"
       DESCRIPTION
                "Addition of PDH tributaries unidirectional TPs objects. "

       REVISION "0207240000Z"
       DESCRIPTION
                "Added the Ds1TTPBidLineCoding columnar object."

       REVISION "0205100000Z"
       DESCRIPTION
                "Added the tables e1PathTTPBid, ds1PathTTPBid, e3PathTTPBid, ds3PathTTPBid. Updated 
                  the already existing tables."

       REVISION "0201250000Z"
       DESCRIPTION
                "Initial Release of Common SDH/PDH TRS MIB."

 ::= {  opticsimSdhPdhMib 3}


opticsIMTrsCommonMibObject      OBJECT IDENTIFIER ::= { opticsIMTrsCommonMib 1 }

opticsIMTrsE1Mngt           OBJECT IDENTIFIER ::= { opticsIMTrsCommonMibObject 2 }
opticsIMTrsDs1Mngt         OBJECT IDENTIFIER ::= { opticsIMTrsCommonMibObject 3 }
opticsIMTrsE3Mngt           OBJECT IDENTIFIER ::= { opticsIMTrsCommonMibObject 4 }
opticsIMTrsDs3Mngt         OBJECT IDENTIFIER ::= { opticsIMTrsCommonMibObject 5 }


OpticsIMPdhFrameStatus ::= TEXTUAL-CONVENTION
     STATUS current
     DESCRIPTION
       " This object contains the information whether a CRC indication is detected on a PDH signal when 
          the processing of a framed signal is activated."
     SYNTAX  TruthValue

OpticsIMDs1pPILineLength ::= TEXTUAL-CONVENTION
STATUS current
     DESCRIPTION
       " This object contains the identifier of the range of the lengths where the length of the ds1 line is
          included . 
         The identifier must be included in one of the entries of the opticsIMAllowedLineLengthsTable.
         It provides information for Line Build Out (LBO) circuitry."
     SYNTAX  Integer32

OpticsIMDs3pPILineLength ::= TEXTUAL-CONVENTION
STATUS current
     DESCRIPTION
       " This object contains the identifier of the range of the lengths where the length of the ds3 line is
          included . 
         The identifier must be included in one of the entries of the opticsIMAllowedDs3LineLengthsTable.
         It provides information for Line Build Out (LBO) circuitry."
     SYNTAX  Integer32

OpticsIMDs3ParityViolationMonitoringRemoving ::= TEXTUAL-CONVENTION
STATUS  current
     DESCRIPTION
       "This object specifies whether the Parity Violation Monitoring Removing (PVMR)
       is enabled.
       The true value enables correction of DS3 Parity Errors.
       The false value disables correction of DS3 Parity Errors: 
       DS3 Parity Errors are not removed and are passed on to next section."
     SYNTAX  TruthValue

 OpticsIMDs3AISSignalType ::= TEXTUAL-CONVENTION
STATUS  current
     DESCRIPTION
       "This object specifies the type of AIS signal to be inserted for Ds3 signal in framed mode.
         In unframed mode the AIS signal type is not configurable by manager (AIS signal type is allOnes)."
     SYNTAX  INTEGER {
          allOnes  (1),
          blueSignal  (2)
          }

 OpticsIMDs1E1AISSignalType ::= TEXTUAL-CONVENTION
STATUS  current
     DESCRIPTION
       "This object specifies the type of AIS signal to be inserted for Ds1 and E1 signal."
     SYNTAX  INTEGER {
          allOnes  (1),
          allZeroes  (2)
          }

 OpticsIMPseudoRandSeqInsertion ::= TEXTUAL-CONVENTION
STATUS  current
     DESCRIPTION
       "This object specifies whether the insertion of pseudoRandom pattern on tributary x is 
        allowed (‘on’ value) or not (‘off’ value). The insertion has to be allowed only if the tributary x is
        not disabled (operationalState)"
     SYNTAX  INTEGER {
          on  (1),
          off  (2)
          }

OpticsIMAISInsertion ::= TEXTUAL-CONVENTION
STATUS  current
     DESCRIPTION
       "This object specifies whether the AIS (Alarm Indication Signal) insertion is allowed.
       The true value enables the AIS insertion."
     SYNTAX  TruthValue

OpticsIMDs3AISSignalTiming ::= TEXTUAL-CONVENTION
     STATUS  current
     DESCRIPTION
        " This object is used to specify two time (t1-t2): the t1 time is the time within to insert an AIS when
          an alarm occurs; the t2 time is the time to remove the AIS after the alarm has cleared."
     SYNTAX  INTEGER {
          ms3-3  (1),
          ms10-350  (2)
          }

 OpticsIMDs3IdleInsertion ::= TEXTUAL-CONVENTION
     STATUS  current
DESCRIPTION
       "This object specifies whether the idle signal has to be insert.
       The true value enables the idle signal insertion."
     SYNTAX  TruthValue

 OpticsIMDs3IdleDetection ::= TEXTUAL-CONVENTION
     STATUS  current
DESCRIPTION
       "This object specifies whether the idle signal is inserted."
     SYNTAX  TruthValue

OpticsIMDs0ChannelList ::= TEXTUAL-CONVENTION
	STATUS     current
	DESCRIPTION 
		"A list of ds0 timeslots on a DS1 line.
		
		            The list is specified as an OCTET STRING in which each ds0
		            timeslot is represented by a single bit, where  timeslots 1
		            through 8 are represented by the bits in the first octet,
		            timeslots 9 through 16 by the bits in the second octet,
		            etc.  In each octet, the lowest numbered timeslot is
		            represented by the most significant bit, and the highest
		            numbered timeslot by the least significant bit.  A timeslot
		            is present in the list when its bit is 1, and absent
		            when its bit is 0. 
		
		            If the OCTET STRING value has more bits than required to 
		            represent the timeslots on a DS1, then the extra bits 
		            are ignored."
	SYNTAX  OCTET STRING (SIZE(0..4))


OpticsIMDs1E1ClockSource ::= TEXTUAL-CONVENTION
	STATUS     current
	DESCRIPTION 
		"The OpticsIMDs1E1ClockSource data type is an enumerated type
		         that indicates the clock for transmitted data on a DS3 or DS1 channel.
		         loopTimed(1)     - The clock is recovered from the line's receive
		                            data stream
		         nodeTimed(2)     - The clock is internal
		         adaptive(4)      - The clock is adaptively recovered from the rate at
		                            which data is received and not from the physical
		                            layer.
		         differential(8)  - The clock is recovered from differential RTP
		                            timestamp header."
	SYNTAX  INTEGER {
		loopTimed (1),
		nodeTimed (2),
		adaptive (4),
		differential (8),
                none (0)
	}


OpticsIMDs1E1IdleCycleFlags ::= TEXTUAL-CONVENTION
	STATUS     current
	DESCRIPTION 
		"The OpticsIMDs1E1IdleCycleFlags data type is an enumerated integer that 
		         indicates the value that the DS3/DS1 port/channel or a DS0 channel
		         group transmits during idle cycle.
		
		         The value of 'none' is applicable to an ATM port/channel only,
		         which transmits idle cells and not octets defined by the below values.
		 
		         If the value is set to 'flags', a value of 0x7E is used.
		         If the value is set to 'ones', a value of 0xFF is used."
	SYNTAX  INTEGER {
		none (0),
		flags (1),
		ones (2)
	}


opticsIMGMAUTTPBidTable OBJECT-TYPE
     SYNTAX SEQUENCE OF	OpticsIMGMAUTTPBidEntry
     MAX-ACCESS					not-accessible
     STATUS							deprecated
     DESCRIPTION
          "This table contains the information related to the termination and to the origination of generic 
           physical interfaces for data applications. "
::= { opticsIMTrsCommonMibObject 1 }

opticsIMGMAUTTPBidEntry OBJECT-TYPE
     SYNTAX						OpticsIMGMAUTTPBidEntry
     MAX-ACCESS				not-accessible
     STATUS						deprecated
     DESCRIPTION
          " An entry of the gMAUTTPBidTable. Each entry corresponds to a generic data physical interface."
     INDEX  { ifIndex }
::= { opticsIMGMAUTTPBidTable 1 }  

OpticsIMGMAUTTPBidEntry ::= SEQUENCE {
  gMAUTTPBidInterfaceType								INTEGER,
  gMAUTTPBidMediaStatus									INTEGER,
  gMAUTTPBidAutoNegotiationConf						INTEGER,
  gMAUTTPBidAutoNegotiationRate						INTEGER,
  gMAUTTPBidAutoNegotiationFlowDirectionality		INTEGER,
  gMAUTTPBidAutoNegotiationFlowControlActive		TruthValue,
  gMAUTTPBidAutoNegotiationCurrentStatus			INTEGER,
  gMAUTTPBidAutoNegotiationRemoteSignalling		TruthValue,
  gMAUTTPBidAutoNegotiationRemoteStatus			INTEGER,
  gMAUTTPBidManualConfRate								INTEGER,
  gMAUTTPBidManualConfFlowDirectionality			INTEGER,
  gMAUTTPBidOperationalState								TsdimOperationalState,
  gMAUTTPBidAsapIndex									Integer32
  }

gMAUTTPBidInterfaceType OBJECT-TYPE
     SYNTAX INTEGER {
   s1000BaseSX  (1),
   s1000BaseLX  (2),
   s1000BaseCX  (3),
   s100BaseTX  (4),
   s100BaseFX  (5),
   unknown   (6),
   s10BaseT  (7)
   }
     MAX-ACCESS			read-only
     STATUS					deprecated
     DESCRIPTION
       " The value of this  object indicates the physical interface supported."
::= { opticsIMGMAUTTPBidEntry 1 }

gMAUTTPBidMediaStatus OBJECT-TYPE
     SYNTAX INTEGER {
   available  (1),
   initializing (2),
   lossOfSignal  (3),
   offLine  (4),
   autoNegotiationError  (5),
   remoteFault  (6)
   }
     MAX-ACCESS			read-only
     STATUS					deprecated
     DESCRIPTION
       " This object is used to indicate the availability status of the MAU media."
::= { opticsIMGMAUTTPBidEntry 2 }

gMAUTTPBidAutoNegotiationConf OBJECT-TYPE
     SYNTAX INTEGER {
   enabled  (1),
   disabled  (2)
   }
     MAX-ACCESS			read-write
     STATUS					deprecated
     DESCRIPTION
       " This object is used to configure the auto-negotiation. In case enabled value is selected the auto-
         negotiation is enabled and the bit rate (10/100 Mbit/s) and the directionality (half/full duplex) are 
         automatically detected. 
         In case disabled value is selected the auto-negotiation is disabled (manual configuration) and the 
         operator has to specify the bit rate (10/100 Mbit/s) and the directionality (half/full duplex)."
::= { opticsIMGMAUTTPBidEntry 3 } 

gMAUTTPBidAutoNegotiationRate OBJECT-TYPE
     SYNTAX INTEGER {
   	eth10BaseT   (1),
   	eth100BaseTX  (2)
   }
     MAX-ACCESS			read-write
     STATUS					deprecated
     DESCRIPTION
       " This object is used to configure the rate parameter for the auto-negotiation process. This parameter  
          is effective only if autoNegotiation process is enabled."
::= { opticsIMGMAUTTPBidEntry 4 } 

gMAUTTPBidAutoNegotiationFlowDirectionality OBJECT-TYPE
     SYNTAX INTEGER {
   halfDuplex  (1),
   fullDuplex  (2)
   }
     MAX-ACCESS			read-write
     STATUS					deprecated
     DESCRIPTION
       " This object is used to configure the directionality parameter for the auto-negotiation process. This 
         parameter is effective only if autoNegotiation process is enabled."
::= { opticsIMGMAUTTPBidEntry 5 } 

gMAUTTPBidAutoNegotiationFlowControlActive OBJECT-TYPE
     SYNTAX					TruthValue
     MAX-ACCESS			read-write
     STATUS					deprecated
     DESCRIPTION
       " This object is used to configure the flow control parameter for the auto-negotiation process. This 
         parameter is effective only if autoNegotiation process is enabled."
::= { opticsIMGMAUTTPBidEntry 6 } 

gMAUTTPBidAutoNegotiationCurrentStatus OBJECT-TYPE
     SYNTAX 	INTEGER {
   completedOK  (1),
completedKO  (2),
          configuring  (3),
          deactivated  (4),
          parallelDetectFail  (5),
          other  (6)
   }
     MAX-ACCESS			read-only
     STATUS					deprecated
     DESCRIPTION
       " This object is used to indicate the current status of the auto-negotiation. "
::= { opticsIMGMAUTTPBidEntry 7 }

gMAUTTPBidAutoNegotiationRemoteSignalling OBJECT-TYPE
     SYNTAX					TruthValue
     MAX-ACCESS			read-only
     STATUS					deprecated
     DESCRIPTION
       " This object is used to indicate if the remote peer is operating the auto-negotiation."
::= { opticsIMGMAUTTPBidEntry 8 } 

gMAUTTPBidAutoNegotiationRemoteStatus OBJECT-TYPE
     SYNTAX INTEGER {
          otherOrUnknown  (1),
          e10BaseTHD  (2),
          e10BaseTFD  (3),
          e100BaseTxHD  (4),
          e100BaseTxFD  (5)
          }
     MAX-ACCESS			read-only
     STATUS					deprecated
     DESCRIPTION
       " This object is used to report information about the parameters negotiable by the remote node. The 
          value otherOrUnknown is raised in abnormal condition of the autonegotiation process , this value i
          is also assumed as default until the autonegotiation process finishes."
::= { opticsIMGMAUTTPBidEntry 9 } 

gMAUTTPBidManualConfRate OBJECT-TYPE
     SYNTAX INTEGER {
          eth10BaseT  (1),
          eth100BaseTX  (2)
          }
     MAX-ACCESS			read-write
     STATUS					deprecated
     DESCRIPTION
       " This object is used to configure in a manual way the rate parameter of the interface. This object is 
         used only if the auto-negotiation is not available or disabled."
::= { opticsIMGMAUTTPBidEntry 10 } 

gMAUTTPBidManualConfFlowDirectionality OBJECT-TYPE
     SYNTAX 	INTEGER {
          halfDuplex   (1),
          fullDuplex   (2)
          }
     MAX-ACCESS			read-write
     STATUS					deprecated
     DESCRIPTION
       " This object is used to configure in a manual way the directionality parameter of the interface. This 
         object is used only if the auto-negotiation is not available or disabled."
::= { opticsIMGMAUTTPBidEntry 11 } 


gMAUTTPBidOperationalState OBJECT-TYPE
     SYNTAX					TsdimOperationalState 
     MAX-ACCESS			read-only
     STATUS					deprecated
     DESCRIPTION
       " See Textual Conventions."
::= { opticsIMGMAUTTPBidEntry 12 }

gMAUTTPBidAsapIndex OBJECT-TYPE
     SYNTAX					Integer32 
     MAX-ACCESS			read-write 
     STATUS					deprecated
     DESCRIPTION
       "This object defines the ASAP object associated to this entry."
::= { opticsIMGMAUTTPBidEntry 13 }




opticsIME1pPITTPTable OBJECT-TYPE
     SYNTAX SEQUENCE OF	OpticsIME1pPITTPEntry
     MAX-ACCESS					not-accessible
     STATUS							current
     DESCRIPTION
          "This table contains the information related to the termination of the 2 Mbit/s PDH trails. "
::= { opticsIMTrsE1Mngt 1 }

opticsIME1pPITTPEntry OBJECT-TYPE
     SYNTAX						OpticsIME1pPITTPEntry
     MAX-ACCESS				not-accessible
     STATUS						current
     DESCRIPTION
          " An entry of the e1pPITTPTable. Each entry corresponds to a 2 Mbit/s PDH trail. "
     INDEX  { ifIndex }
::= { opticsIME1pPITTPTable 1 }   

OpticsIME1pPITTPEntry ::= SEQUENCE {
   e1pPITTPSignalMode                               INTEGER,
   e1pPITTPFrameStatus                              OpticsIMPdhFrameStatus,
   e1pPITTPOperationalState                         TsdimOperationalState,
   e1pPITTPAsapIndex                                Integer32,
   e1pPITTPAISSignalType                            OpticsIMDs1E1AISSignalType,
   e1pPITTPAISInsertion                             OpticsIMAISInsertion,
   e1pPITTPPseudoRandSeqInsertion                   OpticsIMPseudoRandSeqInsertion,
   e1pPITTPCrossConnectIdentifier                   Integer32,
   e1pPITTPTimeSlotTMN                              INTEGER,
   e1pPITTPClockSource                              OpticsIMDs1E1ClockSource,
   e1pPITTPDs0ChanIndexNext                         Integer32,
   e1pPITTPBundleNumber                             Integer32,
   e1pPITTPEncapsType                               INTEGER
   }

e1pPITTPSignalMode OBJECT-TYPE
     SYNTAX  INTEGER {
          unframed  (1),
          framed  (2),
          framedIsdnPra  (3),
          disabled  (4)
          }
     MAX-ACCESS			read-write
     STATUS					current
     DESCRIPTION
       " This object contains the modality to manage the E1 PDH signal. If the framed mode is selected 
          then the processing of a framed signal is provisioned and the detection of the LOF and RDI 
          defects is enabled. 
          If the unframed mode is selected  the reception of an unframed signal is assumed. 
          When the associated physical port is not used the object has to be set to disabled mode."
::= { opticsIME1pPITTPEntry 1 }

e1pPITTPFrameStatus OBJECT-TYPE
     SYNTAX					OpticsIMPdhFrameStatus
     MAX-ACCESS			read-only
     STATUS					current
     DESCRIPTION
       " See Textual Conventions."
::= { opticsIME1pPITTPEntry 2 }

e1pPITTPOperationalState OBJECT-TYPE
     SYNTAX					TsdimOperationalState 
     MAX-ACCESS			read-only
     STATUS					current
     DESCRIPTION
       " See Textual Conventions."
::= { opticsIME1pPITTPEntry 3 }

e1pPITTPAsapIndex OBJECT-TYPE
     SYNTAX					Integer32 
     MAX-ACCESS			read-write 
     STATUS					current
     DESCRIPTION
       "This object defines the ASAP object associated to this entry."
::= { opticsIME1pPITTPEntry 4 }

e1pPITTPAISSignalType OBJECT-TYPE
     SYNTAX OpticsIMDs1E1AISSignalType
     MAX-ACCESS			read-write 
     STATUS					current
     DESCRIPTION
     " See Textual Conventions."
::= { opticsIME1pPITTPEntry 5}

e1pPITTPAISInsertion OBJECT-TYPE
     SYNTAX OpticsIMAISInsertion
     MAX-ACCESS			read-write 
     STATUS					current
     DESCRIPTION
     " See Textual Conventions."
::= { opticsIME1pPITTPEntry 6}

e1pPITTPPseudoRandSeqInsertion OBJECT-TYPE
     SYNTAX OpticsIMPseudoRandSeqInsertion
     MAX-ACCESS			read-write 
     STATUS					current
     DESCRIPTION
     " See Textual Conventions."
::= { opticsIME1pPITTPEntry 7}

e1pPITTPCrossConnectIdentifier  OBJECT-TYPE
     SYNTAX Integer32 (0..2147483647)
     MAX-ACCESS read-only
     STATUS current
     DESCRIPTION
        "This object allows to identify the cross-connection in which the e1 port is involved.
         It is automatically set by the agent when the e1 port is cross-connected. Its value is the one 
         that identify the cross-connection index (opticsIMCrossConnectIndex object of the 
         opticsIMCrossConnectTable).
         The value of the connection identifier is the same for all the objects making part of the same cross-
         connection.
         The value '0' indicates that the e1 port is not involved in any cross-connection."
::= { opticsIME1pPITTPEntry 8}

e1pPITTPTimeSlotTMN  OBJECT-TYPE
     SYNTAX INTEGER (-1|1..31)
     MAX-ACCESS read-write 
     STATUS current
     DESCRIPTION
        "This object allows to define the time slot used for TMN transport on this e1 port.
         The '-1' value indicates that this e1 port is not used to transport the TMN signal.
         The '0' value is not a valide value for time slot to transport TMN signal. "
     DEFVAL { -1 }
::= { opticsIME1pPITTPEntry 9}

e1pPITTPClockSource  OBJECT-TYPE
	SYNTAX     OpticsIMDs1E1ClockSource
	MAX-ACCESS read-write
	STATUS     current
	DESCRIPTION 
		"opticsIMIfClockSource configures the clock for transmitted data from
		         either the internal clock ('nodeTimed'), or from a clock recovered
		         from the line's receive data stream ('loopTimed'), or recovered
		         adaptively from the rate at which the data that is received and not
		         from the physical layer ('adaptive'), or recovered from the
		         differential timestamp in the RTP header ('differential').
		"
	DEFVAL  { nodeTimed }
	::= { opticsIME1pPITTPEntry 10 }

e1pPITTPDs0ChanIndexNext  OBJECT-TYPE
	SYNTAX     Integer32
	MAX-ACCESS read-only
	STATUS     current
	DESCRIPTION 
		"This object contains an appropriate value to be used for 
				ds0ChanGroupIndex when creating entries in
				the opticsIMDS0ChanGroupTable.
				The value 0 indicates that no unassigned entries are 
				available.
				To obtain the ds0ChanGroupIndex value for a
				new entry, the manager issues a management protocol
				retrieval operation to obtain the current value of this 
				object.  After each retrieval, the agent should modify 
				the value to the next unassigned index."
	::= { opticsIME1pPITTPEntry 11 }

e1pPITTPBundleNumber  OBJECT-TYPE
	SYNTAX     Integer32 (0..1280)
	MAX-ACCESS read-only
	STATUS     current
	DESCRIPTION 
		"opticsIMIfBundleNumber identifies the bundle for which this port is
		         a member. If this port is not a member of any bundle, the value of
		         opticsIMIfBundleNumber will be zero."
	::= { opticsIME1pPITTPEntry 12 }

e1pPITTPEncapsType  OBJECT-TYPE
	SYNTAX     INTEGER {
		cesUnstructured (1),
		cesStructured (2),
		atm (3),
		atmIma (4)
	}
	MAX-ACCESS read-write
	STATUS     current
	DESCRIPTION 
		"The type of encapsulation protocol configured on this interface. 
		Possible values are 'cesUnstructured', 'cesStructured', 'atm' and 'atmIma'.
		encapsType is constrained by the signalMode value based on the following rules:
		signalMode = 'unframed' --> ' encapsType = 'cesUnstructured'
		signalMode = 'framed'     --> ' encapsType = 'cesUnstructured' | 'cesStructured' | 'atm'
		"
	::= { opticsIME1pPITTPEntry 13 }

--

opticsIME1PathTTPTable OBJECT-TYPE
     SYNTAX SEQUENCE OF	OpticsIME1PathTTPEntry
     MAX-ACCESS					not-accessible
     STATUS							current
     DESCRIPTION
          "This table contains the information related to the termination of 2 the Mbit/s paths. "
::= { opticsIMTrsE1Mngt 2 }

opticsIME1PathTTPEntry OBJECT-TYPE
     SYNTAX					OpticsIME1PathTTPEntry
     MAX-ACCESS			not-accessible
     STATUS					current
     DESCRIPTION
          " An entry of the e1PathTTPTable. Each entry corresponds to a 2 Mbit/s path. The signal 
             processing mode of each entry is the same of the associated entry in the e1pPITTPTable.
            The same thing for AIS signal type."
     INDEX  { ifIndex }
::= { opticsIME1PathTTPTable 1 } 

OpticsIME1PathTTPEntry ::= SEQUENCE {
   e1PathTTPFrameStatus                   OpticsIMPdhFrameStatus,
   e1PathTTPOperationalState             TsdimOperationalState,
   e1PathTTPAsapIndex                        Integer32,
   e1PathTTPAISInsertion                     OpticsIMAISInsertion
   }

e1PathTTPFrameStatus OBJECT-TYPE
     SYNTAX					OpticsIMPdhFrameStatus
     MAX-ACCESS			read-only
     STATUS					current
     DESCRIPTION
       " See Textual Conventions."
::= { opticsIME1PathTTPEntry 1 }

e1PathTTPOperationalState OBJECT-TYPE
     SYNTAX					TsdimOperationalState 
     MAX-ACCESS			read-only
     STATUS					current
     DESCRIPTION
       " See Textual Conventions."
::= { opticsIME1PathTTPEntry 2 }

e1PathTTPAsapIndex OBJECT-TYPE
     SYNTAX					Integer32 
     MAX-ACCESS			read-write 
     STATUS					current
     DESCRIPTION
       "This object defines the ASAP object associated to this entry."
::= { opticsIME1PathTTPEntry 3 }

e1PathTTPAISInsertion OBJECT-TYPE
     SYNTAX                      OpticsIMAISInsertion
     MAX-ACCESS             read-write 
     STATUS                      current
     DESCRIPTION
     " See Textual Conventions."
::= { opticsIME1PathTTPEntry 4}

opticsIMDs1pPITTPTable OBJECT-TYPE
     SYNTAX SEQUENCE OF	OpticsIMDs1pPITTPEntry
     MAX-ACCESS					not-accessible
     STATUS							current
     DESCRIPTION
          "This table contains the information related to the termination of the 1,5 Mbit/s PDH trails. "
::= { opticsIMTrsDs1Mngt 1 }

opticsIMDs1pPITTPEntry OBJECT-TYPE
     SYNTAX						OpticsIMDs1pPITTPEntry
     MAX-ACCESS				not-accessible
     STATUS						current
     DESCRIPTION
          " An entry of the ds1pPITTPTable. Each entry corresponds to a 1,5 Mbit/s PDH trail. "
     INDEX  { ifIndex }
::= { opticsIMDs1pPITTPTable 1 }   

OpticsIMDs1pPITTPEntry ::= SEQUENCE {
   ds1pPITTPSignalMode               INTEGER,
   ds1pPITTPLineCoding                 INTEGER,
   ds1pPITTPLineLength                 OpticsIMDs1pPILineLength,
   ds1pPITTPOperationalState           TsdimOperationalState,
   ds1pPITTPAsapIndex                  Integer32,
   ds1pPITTPAISSignalType              OpticsIMDs1E1AISSignalType,
   ds1pPITTPAISInsertion               OpticsIMAISInsertion,
   ds1pPITTPCrossConnectIdentifier     Integer32, 
   ds1pPITTPClockSource                OpticsIMDs1E1ClockSource,
   ds1pPITTPDs0ChanIndexNext           Integer32,
   ds1pPITTPBundleNumber               Integer32,
   ds1pPITTPEncapsType                 INTEGER
}

ds1pPITTPSignalMode OBJECT-TYPE
     SYNTAX  INTEGER {
          unframed  (1),
          framed12MF  (2),
          framed24MF (3),
          disabled  (4)
          }
     MAX-ACCESS			read-write
     STATUS					current
     DESCRIPTION
       " This object contains the modality to manage the DS1 PDH signal. Two different modes are 
         selectable for a framed signal: 12-frame multiframe or 24-frame multiframe.
         If one of these framed modes is selected then the processing of a framed signal is provisioned and 
         the detection of the LOF defect is enabled. 
         If the value unframed is selected the reception of an unframed signal is assumed. 
         When the associated physical port is not used the object has to be set to disabled mode. "
::= { opticsIMDs1pPITTPEntry 1 }

ds1pPITTPLineCoding OBJECT-TYPE
     SYNTAX  INTEGER {
          ami  (1),
          b8zs  (2) 
          }
     MAX-ACCESS			read-write
     STATUS					current
     DESCRIPTION
       " This object defines the line coding used on DS1 interface."
::= { opticsIMDs1pPITTPEntry 2 }

ds1pPITTPLineLength OBJECT-TYPE
     SYNTAX					OpticsIMDs1pPILineLength
     MAX-ACCESS			read-write 
     STATUS					current
     DESCRIPTION
       "See Textual Conventions."
::= { opticsIMDs1pPITTPEntry 3 }

ds1pPITTPOperationalState OBJECT-TYPE
     SYNTAX					TsdimOperationalState 
     MAX-ACCESS			read-only
     STATUS					current
     DESCRIPTION
       " See Textual Conventions."
::= { opticsIMDs1pPITTPEntry 4 }

ds1pPITTPAsapIndex OBJECT-TYPE
     SYNTAX					Integer32 
     MAX-ACCESS			read-write 
     STATUS					current
     DESCRIPTION
       "This object defines the ASAP object associated to this entry."
::= { opticsIMDs1pPITTPEntry 5 }

ds1pPITTPAISSignalType OBJECT-TYPE
     SYNTAX OpticsIMDs1E1AISSignalType
     MAX-ACCESS			read-write 
     STATUS					current
     DESCRIPTION
     " See Textual Conventions."
::= { opticsIMDs1pPITTPEntry 6}

ds1pPITTPAISInsertion OBJECT-TYPE
     SYNTAX OpticsIMAISInsertion
     MAX-ACCESS			read-write 
     STATUS					current
     DESCRIPTION
     " See Textual Conventions."
::= { opticsIMDs1pPITTPEntry 7}

ds1pPITTPCrossConnectIdentifier  OBJECT-TYPE
     SYNTAX Integer32 (0..2147483647)
     MAX-ACCESS read-only
     STATUS current
     DESCRIPTION
        "This object allows to identify the cross-connection in which the ds1 port is involved.
         It is automatically set by the agent when the ds1 port is cross-connected. Its value is the one 
         that identify the cross-connection index (opticsIMCrossConnectIndex object of the 
         opticsIMCrossConnectTable).
         The value of the connection identifier is the same for all the objects making part of the same cross-
         connection.
         The value '0' indicates that the ds1 port is not involved in any cross-connection."
::= { opticsIMDs1pPITTPEntry 8}

ds1pPITTPClockSource  OBJECT-TYPE
	SYNTAX     OpticsIMDs1E1ClockSource
	MAX-ACCESS read-write
	STATUS     current
	DESCRIPTION 
		"ds1pPITTPClockSource  configures the clock for transmitted data from
		         either the internal clock ('nodeTimed'), or from a clock recovered
		         from the line's receive data stream ('loopTimed'), or recovered
		         adaptively from the rate at which the data that is received and not
		         from the physical layer ('adaptive'), or recovered from the
		         differential timestamp in the RTP header ('differential').
		"
	DEFVAL  { loopTimed }
	::= { opticsIMDs1pPITTPEntry 9 }

ds1pPITTPDs0ChanIndexNext  OBJECT-TYPE
	SYNTAX     Integer32
	MAX-ACCESS read-only
	STATUS     current
	DESCRIPTION 
		"This object contains an appropriate value to be used for 
				ds0ChanGroupIndex when creating entries in
				the opticsIMDS0ChanGroupTable.
				The value 0 indicates that no unassigned entries are 
				available.
				To obtain the ds0ChanGroupIndex value for a
				new entry, the manager issues a management protocol
				retrieval operation to obtain the current value of this 
				object.  After each retrieval, the agent should modify 
				the value to the next unassigned index."
	::= { opticsIMDs1pPITTPEntry 10 }

ds1pPITTPBundleNumber  OBJECT-TYPE
	SYNTAX     Integer32 (0..1280)
	MAX-ACCESS read-only
	STATUS     current
	DESCRIPTION 
		"ds1pPITTPBundleNumber identifies the bundle for which this port is
		         a member. If this port is not a member of any bundle, the value of
		         ds1pPITTPBundleNumber will be zero."
	::= { opticsIMDs1pPITTPEntry 11 }

ds1pPITTPEncapsType  OBJECT-TYPE
	SYNTAX     INTEGER {
		cesUnstructured (1),
		cesStructured (2),
		atm (3),
		atmIma (4)
	}
	MAX-ACCESS read-write
	STATUS     current
	DESCRIPTION 
		"The type of encapsulation protocol configured on this interface. 
		Possible values are 'cesUnstructured', 'cesStructured', 'atm' and 'atmIma'.
		encapsType is constrained by the signalMode value based on the following rules:
		signalMode = 'unframed' --> ' encapsType = 'cesUnstructured'
		signalMode = 'framed'     --> ' encapsType = 'cesUnstructured' | 'cesStructured' | 'atm'
		"
	::= { opticsIMDs1pPITTPEntry 12 }

