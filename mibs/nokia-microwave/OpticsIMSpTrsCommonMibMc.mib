     SYNTAX OpticsIMDs3IdleDetection
     MAX-ACCESS			read-write 
     STATUS					current
     DESCRIPTION
     " See Textual Conventions."
::= { opticsIMDs3pPITTPEntry  9}

ds3pPITTPInputBridgeEnabled OBJECT-TYPE
     SYNTAX  INTEGER {
          notApplicable  (1),
          enabled  (2),
          disabled  (3)
          }
     MAX-ACCESS			read-write
     STATUS					current
     DESCRIPTION
       " This object indicates if this DS3 line is selected to bridge (‘enabled’ value) an other DS3 line
         (equipment dependent).
          The ‘notApplicable’ value is used to indicate that a DS3 line not support the bridge (or is used as
          input to bridge"
::= { opticsIMDs3pPITTPEntry 10 }

ds3pPITTPLineLength OBJECT-TYPE
     SYNTAX					OpticsIMDs3pPILineLength
     MAX-ACCESS			read-write 
     STATUS					current
     DESCRIPTION
       "See Textual Conventions."
::= { opticsIMDs3pPITTPEntry 11 }

ds3pPITTPCrossConnectIdentifier  OBJECT-TYPE
     SYNTAX Integer32 (0..2147483647)
     MAX-ACCESS read-only
     STATUS current
     DESCRIPTION
        "This object allows to identify the cross-connection in which the ds3 port is involved.
         It is automatically set by the agent when the ds3 port is cross-connected. Its value is the one 
         that identify the cross-connection index (opticsIMCrossConnectIndex object of the 
         opticsIMCrossConnectTable).
         The value of the connection identifier is the same for all the objects making part of the same cross-
         connection.
         The value '0' indicates that the ds3 port is not involved in any cross-connection."
::= { opticsIMDs3pPITTPEntry 12}

