     SYNTAX						OpticsIMAllowedDs3LineLengthsEntry
     MAX-ACCESS				not-accessible
     STATUS						current
     DESCRIPTION
          " An entry of the opticsIMAllowedDs3LineLengthsTable. Each entry corresponds to a range of ds3
            lines lengths. "
     INDEX  {allowedDs3LineLengthIndex }
::= { opticsIMAllowedDs3LineLengthsTable 1 }   

OpticsIMAllowedDs3LineLengthsEntry ::= SEQUENCE {
          allowedDs3LineLengthIndex           OpticsIMDs3pPILineLength,
          allowedDs3LineLengthMin              Integer32,
          allowedDs3LineLengthMax             Integer32,
          allowedDs3LineLengthId                 OpticsIMDs3pPILineLength
}

allowedDs3LineLengthIndex OBJECT-TYPE
     SYNTAX 					OpticsIMDs3pPILineLength
     MAX-ACCESS			not-accessible
     STATUS					current
     DESCRIPTION
       " This object contains the identifier of a range of ds3 lines lengths."
