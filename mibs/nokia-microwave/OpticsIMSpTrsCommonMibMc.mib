opticsIMDs3pPITTPEntry OBJECT-TYPE
     SYNTAX					OpticsIMDs3pPITTPEntry
     MAX-ACCESS			not-accessible
     STATUS					current
     DESCRIPTION
          " An entry of the ds3pPITTPTable. Each entry corresponds to a  45 Mbit/s PDH trail. "
     INDEX  { ifIndex }
::= { opticsIMDs3pPITTPTable 1 } 

OpticsIMDs3pPITTPEntry ::= SEQUENCE {
   ds3pPITTPSignalMode                             INTEGER,
   ds3pPITTPOperationalState                       TsdimOperationalState,
   ds3pPITTPAsapIndex                              Integer32,
   ds3pPITTPParityViolationMonitoringRemoving      OpticsIMDs3ParityViolationMonitoringRemoving,
   ds3pPITTPAISSignalType                          OpticsIMDs3AISSignalType,
   ds3pPITTPAISInsertion                           OpticsIMAISInsertion,
   ds3pPITTPAISSignalTiming                        OpticsIMDs3AISSignalTiming,
   ds3pPITTPIdleInsertion                          OpticsIMDs3IdleInsertion,
   ds3pPITTPIdleDetection                          OpticsIMDs3IdleDetection,
   ds3pPITTPInputBridgeEnabled                     INTEGER,
   ds3pPITTPLineLength                             OpticsIMDs3pPILineLength,
   ds3pPITTPCrossConnectIdentifier                 Integer32 
}

ds3pPITTPSignalMode OBJECT-TYPE
     SYNTAX  INTEGER {
          unframed  (1),
          framed  (2),
          disabled  (3)
          }
     MAX-ACCESS			read-write
     STATUS					current
     DESCRIPTION
       " This object contains the modality to manage the DS3 PDH signal. If the framed mode is selected 
          then the processing of a framed signal is provisioned and the detection of the LOF and RDI 
          defects is enabled. 
          If the unframed mode is selected the reception of an unframed signal is assumed. 
          When the associated physical port is not used the object has to be set to disabled mode."
::= { opticsIMDs3pPITTPEntry 1 }

ds3pPITTPOperationalState OBJECT-TYPE
     SYNTAX					TsdimOperationalState 
     MAX-ACCESS			read-only
     STATUS					current
     DESCRIPTION
       " See Textual Conventions."
::= { opticsIMDs3pPITTPEntry 2 }

ds3pPITTPAsapIndex OBJECT-TYPE
     SYNTAX					Integer32 
     MAX-ACCESS			read-write 
     STATUS					current
     DESCRIPTION
       "This object defines the ASAP object associated to this entry."
::= { opticsIMDs3pPITTPEntry  3}

ds3pPITTPParityViolationMonitoringRemoving OBJECT-TYPE
     SYNTAX OpticsIMDs3ParityViolationMonitoringRemoving
     MAX-ACCESS			read-write 
     STATUS					current
     DESCRIPTION
     " See Textual Conventions."
::= { opticsIMDs3pPITTPEntry  4}

ds3pPITTPAISSignalType OBJECT-TYPE
     SYNTAX OpticsIMDs3AISSignalType
     MAX-ACCESS			read-write 
     STATUS					current
     DESCRIPTION
     " See Textual Conventions."
::= { opticsIMDs3pPITTPEntry  5}

ds3pPITTPAISInsertion OBJECT-TYPE
     SYNTAX OpticsIMAISInsertion
     MAX-ACCESS			read-write 
     STATUS					current
     DESCRIPTION
     " See Textual Conventions."
::= { opticsIMDs3pPITTPEntry  6}

ds3pPITTPAISSignalTiming OBJECT-TYPE
     SYNTAX OpticsIMDs3AISSignalTiming
     MAX-ACCESS			read-write 
     STATUS					current
     DESCRIPTION
     " See Textual Conventions."
::= { opticsIMDs3pPITTPEntry  7}

ds3pPITTPIdleInsertion OBJECT-TYPE
     SYNTAX OpticsIMDs3IdleInsertion
     MAX-ACCESS			read-write 
     STATUS					current
     DESCRIPTION
     " See Textual Conventions."
::= { opticsIMDs3pPITTPEntry  8}

