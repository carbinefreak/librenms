::= { opticsIMTrsCommonMibObject 22 }


opticsIMBERMeasureTable OBJECT-TYPE
       SYNTAX SEQUENCE OF	OpticsIMBERMeasureEntry
       MAX-ACCESS		not-accessible
       STATUS			current
       DESCRIPTION
             "This table contains the BER measures. The evaluation of the BER is performed counting the 
               number of violations since the activation of the measure. "
::= { opticsIMTrsCommonMibObject 9 }

opticsIMBERMeasureEntry OBJECT-TYPE
       SYNTAX		OpticsIMBERMeasureEntry
       MAX-ACCESS	not-accessible
       STATUS		current
       DESCRIPTION
            "An entry of the opticsIMBERMeasureTable table. "
       INDEX    {  ifIndex }
::= { opticsIMBERMeasureTable 1 }   

OpticsIMBERMeasureEntry ::= SEQUENCE {
   berMeasureElapsedTime            TimeInterval,
   berMeasureSuspectIntervalFlag TruthValue,
   berMeasureViolations                 Integer32,
   berMeasureValue                        DisplayString,
   berMeasureRowStatus                RowStatus
}
       
berMeasureElapsedTime OBJECT-TYPE
       SYNTAX		TimeInterval
       MAX-ACCESS	read-only
       STATUS		current
       DESCRIPTION
           "This object provides the time since the activation of the measure."
::= { opticsIMBERMeasureEntry 1 }

berMeasureSuspectIntervalFlag OBJECT-TYPE
       SYNTAX		TruthValue
       MAX-ACCESS	read-only
       STATUS		current
       DESCRIPTION
           "This object is used to indicate that the measure is not reliable ."
::= { opticsIMBERMeasureEntry 2 }

berMeasureViolations OBJECT-TYPE
       SYNTAX		Integer32
       MAX-ACCESS	read-only
       STATUS		current
       DESCRIPTION
           "This object provides the number of violations detected since the activation of the measure."
::= { opticsIMBERMeasureEntry 3 }

berMeasureValue OBJECT-TYPE
       SYNTAX		DisplayString
       MAX-ACCESS	read-only
       STATUS		current
       DESCRIPTION
           "This object provides the BER calculated using the number of violations during the elapsed time. 
            It is expressed as a string with the following format: Mx10E-N, where M and N are integer.
            The string (notAvailable) is used to indicate that the measure is not available (i.e. in case of an 
            overflow). "
::= { opticsIMBERMeasureEntry 4 }

berMeasureRowStatus OBJECT-TYPE
       SYNTAX		RowStatus
       MAX-ACCESS	read-create
       STATUS		current
       DESCRIPTION
         "See Textual Conventions.  "
::= { opticsIMBERMeasureEntry 5 }



opticsIMTrsAlarms OBJECT IDENTIFIER ::= { opticsIMTrsCommonMibObject 10 }



-- Section Trace Mismatch (alias TIM) alarm

opticsIMAlarmSectionTraceMismatchRaise NOTIFICATION-TYPE
      OBJECTS { tsdimEventObjectClassIdentifier,
                          tsdimEventObjectInstanceIdentifier, 
                          tsdimEventNotificationId,
                          tsdimEventTime,
                          tsdimAlarmSeverity,
                          tsdimAlarmSpecProblem,
                          opticsIMAdditionalText,
                          opticsIMAlarmType}
      STATUS current
      DESCRIPTION 
          "This notification reports the Section Trace Mismatch (STM) defect raise."
::= { opticsIMTrsAlarms 1 }

opticsIMAlarmSectionTraceMismatchClear NOTIFICATION-TYPE
      OBJECTS { tsdimEventObjectClassIdentifier,
                          tsdimEventObjectInstanceIdentifier, 
                          tsdimEventNotificationId,
                          tsdimEventTime,
                          tsdimAlarmSeverity,
                          tsdimAlarmSpecProblem,
                          opticsIMAdditionalText,
                          opticsIMAlarmType}
      STATUS current
      DESCRIPTION 
          " This notification reports the Section Trace Mismatch (STM) defect clear."
::= { opticsIMTrsAlarms 2 }


-- Link Identifier Mismatch alarm

opticsIMAlarmLinkIdentifierMismatchRaise NOTIFICATION-TYPE
      OBJECTS { tsdimEventObjectClassIdentifier,
                          tsdimEventObjectInstanceIdentifier, 
                          tsdimEventNotificationId,
                          tsdimEventTime,
                          tsdimAlarmSeverity,
                          tsdimAlarmSpecProblem,
                          opticsIMAdditionalText,
                          opticsIMAlarmType}
      STATUS current
      DESCRIPTION 
          "This notification reports the Link Identifier Mismatch (LIM) defect raise."
::= { opticsIMTrsAlarms 3 }

opticsIMAlarmLinkIdentifierMismatchClear NOTIFICATION-TYPE
      OBJECTS { tsdimEventObjectClassIdentifier,
                          tsdimEventObjectInstanceIdentifier, 
                          tsdimEventNotificationId,
                          tsdimEventTime,
                          tsdimAlarmSeverity,
                          tsdimAlarmSpecProblem,
                          opticsIMAdditionalText,
                          opticsIMAlarmType}
      STATUS current
      DESCRIPTION 
          " This notification reports the Link Identifier Mismatch (LIM) defect clear."
::= { opticsIMTrsAlarms 4 }

-- PDH Loss Due To Switch alarm

opticsIMAlarmPdhLossDueToSwitchRaise NOTIFICATION-TYPE
      OBJECTS { tsdimEventObjectClassIdentifier,
                          tsdimEventObjectInstanceIdentifier, 
                          tsdimEventNotificationId,
                          tsdimEventTime,
                          tsdimAlarmSeverity,
                          tsdimAlarmSpecProblem,
                          opticsIMAdditionalText,
                          opticsIMAlarmType}
      STATUS current
      DESCRIPTION 
          "This notification reports the PDH Loss Due To Switch defect raise."
::= { opticsIMTrsAlarms 5 }

opticsIMAlarmPdhLossDueToSwitchClear NOTIFICATION-TYPE
      OBJECTS { tsdimEventObjectClassIdentifier,
                          tsdimEventObjectInstanceIdentifier, 
                          tsdimEventNotificationId,
                          tsdimEventTime,
                          tsdimAlarmSeverity,
                          tsdimAlarmSpecProblem,
                          opticsIMAdditionalText,
                          opticsIMAlarmType}
      STATUS current
      DESCRIPTION 
          " This notification reports the PDH Loss Due To Switch defect clear."
::= { opticsIMTrsAlarms 6 }


opticsIMTrsDS0Mngt   OBJECT IDENTIFIER ::= { opticsIMTrsCommonMibObject 30 }

-- 
-- DS0 Channel Group Table 
-- 

opticsIMDS0ChanGroupTable  OBJECT-TYPE
	SYNTAX SEQUENCE OF OpticsIMDS0ChanGroupEntry
	MAX-ACCESS not-accessible
	STATUS     current
	DESCRIPTION 
		"The opticsIMDS0ChanGroupTable has an entry for DS0 channels 
		         grouped together and belonging to a particular DS1 channel."
	::= { opticsIMTrsDS0Mngt 1 }

opticsIMDS0ChanGroupEntry  OBJECT-TYPE
	SYNTAX 	OpticsIMDS0ChanGroupEntry
	MAX-ACCESS not-accessible
	STATUS     current
	DESCRIPTION 
		"Each row entry represents one or more DS0 channels on a 
		         E1/DS1 interface.  opticsIMDS0ChanGroupTimeSlots object is used to add or
		         remove DS0 channels from the group.
		         
		         Entries can be created and deleted via SNMP SET operations 
		         using the opticsIMDS0ChanGroupRowStatus object. 
		
		         For each opticsIMDS0ChanGroupEntry, there should be a corresponding entry 
		         in the ifTable."
	INDEX { ds0ChanGroupIndex }
	::= { opticsIMDS0ChanGroupTable 1 }

OpticsIMDS0ChanGroupEntry ::= SEQUENCE {
	ds0ChanGroupIndex
		Unsigned32,
	ds0ChanGroupRowStatus
		RowStatus,
	ds0ChanGroupTimeSlots
		OpticsIMDs0ChannelList,
	ds0ChanGroupSpeed
		INTEGER,
	ds0ChanGroupCRC
		INTEGER,
	ds0ChanGroupMTU
		Unsigned32,
	ds0ChanGroupOperMTU
		Unsigned32,
	ds0ChanGroupLastChangeTime
		TimeStamp,
	ds0ChanGroupIdleCycleFlags
		OpticsIMDs1E1IdleCycleFlags,
	ds0ChanGroupScramble
		TruthValue,
	ds0ChanGroupAcctPolicyId
		Unsigned32,
	ds0ChanGroupCollectStats
		TruthValue,
	ds0ChanGroupE1DS1Index
		Unsigned32,
	ds0ChanGroupCrossConnectIdentifier
		Integer32
}


ds0ChanGroupIndex OBJECT-TYPE
			SYNTAX Unsigned32
			MAX-ACCESS not-accessible
			STATUS current
			DESCRIPTION
				"This object is used by the ds0ChanGroupTable to
				identify the row of this table.
				When creating a new row in the table the value of this
				index may be obtained by retrieving the value of
				ds0ChanGroupIndexNext.
				The range is 1..32, where 32 is the maximum number of DS0
				slots available in a E1 stream."
			::= { opticsIMDS0ChanGroupEntry 1 }

ds0ChanGroupRowStatus  OBJECT-TYPE
	SYNTAX     RowStatus
	MAX-ACCESS read-write
	STATUS     current
	DESCRIPTION 
		"ds0ChanGroupRowStatus controls the creation and deletion of
		         row entries in the opticsIMDS0ChanGroupTable. The ifIndex 
		         for a channel group has to be calculated based on the
		         given encoding scheme."
	::= { opticsIMDS0ChanGroupEntry 2 }

ds0ChanGroupTimeSlots  OBJECT-TYPE
	SYNTAX     OpticsIMDs0ChannelList
	MAX-ACCESS read-write
	STATUS     current
	DESCRIPTION 
		"ds0ChanGroupTimeSlots is a bitmap which is used to 
		         add/remove DS0 timeslots from a channel group. 
		         The description for TmnxDs0ChannelList contains details of the
		         bitmap organization.
		
		         When a channel group is created on unframed DS1/E1, all timeslots
		         as applicable to a given speed are auto-allocated and cannot be 
		         changed.
		
		         When a channel group is created on a framed DS1/E1 or
		         existing channel group's encapsulation is changed from ATM,
		         the default of no timeslots is auto-assigned to the group.
		
		         When a channel group  on a framed DS1/E1 is configured for 
		         ATM encapsulation, the ATM defaults of 0x00FFFFFF (DS1) 
		         and 0XFFFEFFFE (E1) are auto-assigned and cannot be changed."
	::= { opticsIMDS0ChanGroupEntry 3 }

ds0ChanGroupSpeed  OBJECT-TYPE
	SYNTAX     INTEGER {
		speed-56 (1),
		speed-64 (2)
	}
	MAX-ACCESS read-write
	STATUS     current
	DESCRIPTION 
		"ds0ChanGroupSpeed configures the required link speed 
		         for all the time slots included in this channel group."
	::= { opticsIMDS0ChanGroupEntry 4 }

ds0ChanGroupCRC  OBJECT-TYPE
	SYNTAX     INTEGER {
		crc16 (1),
		crc32 (2)
	}
	MAX-ACCESS read-write
	STATUS     current
	DESCRIPTION 
		"The value of ds0ChanGroupCRC variable indicates the precision of
		         the cyclic redundancy check.  A value of 'crc16' is a 16-bit
		         CRC calculation.  A value of 'crc32' is a 32-bit CRC
		         calculation.  32-bit CRC increases the error detection ability,
		         but it also adds some performance overhead.
		
		         For channel groups with encapsulation set to ATM, the default and
		         only supported value is crc32 and applies to AAL5 CRC calculations
		         on that channel group."
	DEFVAL  { crc16 }
	::= { opticsIMDS0ChanGroupEntry 5 }

ds0ChanGroupMTU  OBJECT-TYPE
	SYNTAX     Unsigned32
	UNITS 	"bytes"
	MAX-ACCESS read-write
	STATUS     current
	DESCRIPTION 
		"The size of the largest packet which can be sent/received
		         on the channel group, specified in octets.  For groups that
		         are used for transmitting network datagrams, this is the
		         size of the largest network datagram that can be sent.
		            
		         Setting ds0ChanGroupMTU to a value of zero (0), causes the agent 
		         to recalculate the default MTU size which can vary based on the 
		         current setting of opticsIMIfPortMode and ifType variables.  
		         Some typical default values are:
		                1522 with mode access and if-type bcp-null
		                1526 with mode access and if-type bcp-dot1q
		                1502 with mode access and if-type ipcp
		                4474 with mode access and if-type frame-relay
		                1524 with mode access and if-type atm
		                2092 with mode access and if-type cem
		        "
	::= { opticsIMDS0ChanGroupEntry 6 }

ds0ChanGroupOperMTU  OBJECT-TYPE
	SYNTAX     Unsigned32
	UNITS 	"bytes"
	MAX-ACCESS read-only
	STATUS     current
	DESCRIPTION 
		"The negotiated size of the largest packet which can be sent on 
		         the channel group, specified in octets.  For channel groups that 
		         are used for transmitting network datagrams, this is the size of 
		         the largest network datagram that can be sent."
	::= { opticsIMDS0ChanGroupEntry 7 }

ds0ChanGroupLastChangeTime  OBJECT-TYPE
	SYNTAX     TimeStamp
	MAX-ACCESS read-write
	STATUS     current
	DESCRIPTION 
		"The ds0ChanGroupLastChangeTime variable contains the sysUpTime
		         value of the most recently modified writable variable in the
		         opticsIMDS0ChanGroupEntry row for this channel group."
	::= { opticsIMDS0ChanGroupEntry 8 }

ds0ChanGroupIdleCycleFlags  OBJECT-TYPE
	SYNTAX     OpticsIMDs1E1IdleCycleFlags
	MAX-ACCESS read-write
	STATUS     current
	DESCRIPTION 
		"ds0ChanGroupIdleCycleFlags configures the value that the
		         channel group transmits during idle cycle.
		 
		         The default value applies to HDLC channels only. For ATM
		         channels the object does not really apply so a default value
		         of 'none' is used and cannot be changed."
	DEFVAL  { flags }
	::= { opticsIMDS0ChanGroupEntry 9 }

ds0ChanGroupScramble  OBJECT-TYPE
	SYNTAX     TruthValue
	MAX-ACCESS read-write
	STATUS     current
	DESCRIPTION 
		"ds0ChanGroupScramble indicates whether payload scrambling
		         is enabled on this ATM channel.  Both ends of the connection
		         must use the same scrambling algorithm.  The default value
		         is 'true' if the ifType is atmEncap for this
		         channel, otherwise the default is 'false' and not allowed to 
		         change."
	::= { opticsIMDS0ChanGroupEntry 10 }

ds0ChanGroupAcctPolicyId  OBJECT-TYPE
	SYNTAX     Unsigned32
	MAX-ACCESS read-write
	STATUS     current
	DESCRIPTION 
		"NOT APPLICABLE
		The value of ds0ChanGroupAcctPolicyId specifies an existing accounting 
		         policy to use for the ds0 channel-group. Accounting policies can only 
		         be associated with network ports or channels.
                     A zero value indicates that there is 
		         no accounting policy associated with this channel"
	DEFVAL  { 0 }
	::= { opticsIMDS0ChanGroupEntry 11 }

ds0ChanGroupCollectStats  OBJECT-TYPE
	SYNTAX     TruthValue
	MAX-ACCESS read-write
	STATUS     current
	DESCRIPTION 
		"NOT APPLICABLE
		The value of ds0ChanGroupCollectStats specifies whether or not the 
		         collection of accounting and statistical data for the network ds0 
		         channel-group is collected.
		
		         When the value is set to false, the statistics are still accumulated 
		         by the cards, however, the results are not written into the billing file.
		
		         When applying accounting policies the data by default will be collected 
		         in the appropriate records and written to the designated billing file."
	DEFVAL  { true }
	::= { opticsIMDS0ChanGroupEntry 12 }

ds0ChanGroupE1DS1Index  OBJECT-TYPE
	SYNTAX     Unsigned32
	MAX-ACCESS read-write
	STATUS     current
	DESCRIPTION 
		"The value of ds0ChanGroupE1DS1Index links to the ifIndex of the relevant E1/DS1 port"
	::= { opticsIMDS0ChanGroupEntry 13 }

ds0ChanGroupCrossConnectIdentifier  OBJECT-TYPE
	SYNTAX     Integer32
	MAX-ACCESS read-only
	STATUS     current
	DESCRIPTION 
		"This object allows to identify the cross-connection in which the ds0 channel is involved.
		         It is automatically set by the agent when the ds0 channel is cross-connected. Its value is the one 
		         that identify the cross-connection index (opticsIMCrossConnectIndex object of the 
		         opticsIMCrossConnectTable).
		         The value of the connection identifier is the same for all the objects making part of the same cross-
		         connection.
		         The value '0' indicates that the ds0 channel is not involved in any cross-connection."
	::= { opticsIMDS0ChanGroupEntry 14 }


-- OPTICSIM-COMMON-TRS-MC DEFINITIONS ::= BEGIN
--       IMPORTS
--       MODULE-IDENTITY, OBJECT-TYPE, OBJECT-IDENTITY FROM SNMPv2-SMI
--       MODULE-COMPLIANCE, NOTIFICATION-GROUP, OBJECT-GROUP FROM SNMPv2-CONF
--       opticsimSdhPdhMC FROM OPTICSIM-RADIOREG-MIB;


-- opticsIMTrsCommonMCCompl MODULE-IDENTITY
--       LAST-UPDATED "0207240000Z"
--       ORGANIZATION "Alcatel TND"
--       CONTACT-INFO "Alcatel TND"
--       DESCRIPTION
--           "Added the Ds1TTPBidLineCoding columnar object."
--       REVISION “0205100000Z"
--       DESCRIPTION
--           " Added the tables e1PathTTPBid, ds1PathTTPBid, e3PathTTPBid, ds3PathTTPBid. 
--             Updated  the already existing groups."
--       REVISION "0201250000Z"
--       DESCRIPTION 
--           "Initial Release of COMMON Transmission Module Compliance."
    
-- ::= { opticsIMTrsCommonMCConf 1 }

opticsIMTrsCommonMCConf         OBJECT IDENTIFIER ::= { opticsimSdhPdhMC 3 }
opticsIMTrsCommonMCCompl      OBJECT IDENTIFIER ::= { opticsIMTrsCommonMCConf 1 }
opticsIMTrsCommonMCGroup      OBJECT IDENTIFIER ::= { opticsIMTrsCommonMCConf 2 }

opticsIMTrsCommonMc MODULE-COMPLIANCE
      STATUS current
      DESCRIPTION 
          "This module compliance describes a set of objects required for Optics-IM Agent 
            implementation. These objects are defined inside opticsIMTrsCommonMib. "

       MODULE -- opticsIMTrsCommonMib  

MANDATORY-GROUPS { opticsIMSdhPdhCommonAlarmsGroup }

GROUP opticsIMGMAUTTPGroup 
      DESCRIPTION
          " This group describes the objects related to the GMAU management."

GROUP opticsIME1TTPGroup 
      DESCRIPTION
          " This group describes the objects related to E1 management."

GROUP opticsIMDs1TTPGroup 
      DESCRIPTION
          " This group describes the objects related to DS1 management."

GROUP opticsIME3TTPGroup 
      DESCRIPTION
          " This group describes the objects related to E3 management."

GROUP opticsIMDs3TTPGroup 
      DESCRIPTION
          " This group describes the objects related to DS3 management. "

GROUP opticsIMRAIInsertionGroup 
      DESCRIPTION
          " This group describes the objects related to the management of the RAI insertion in PDH signals."

GROUP opticsIMAllDs1Group 
      DESCRIPTION
          " This group describes the objects related to the global management of all the DS1 signals. "

GROUP opticsIMBERMeasureGroup
      DESCRIPTION
          " This group describes the objects related to the BER measure. "

GROUP opticsIMAllowedDs1LineLengthsGroup
      DESCRIPTION
          " This group describes the objects related to the allowed ranges of lengths of the ds1 lines."

GROUP opticsIMAllE1Group
      DESCRIPTION
          " This group describes the objects related to the global management of all the E1 signals."

GROUP opticsIMAllDs3Group
      DESCRIPTION
          " This group describes the objects related to the global management of all the DS3 signals."

GROUP opticsIMAllowedDs3LineLengthsGroup
      DESCRIPTION
          " This group describes the objects related to the allowed ranges of lengths of the ds3 lines."
::= { opticsIMTrsCommonMCCompl 1 }



opticsIMGMAUTTPGroup OBJECT-GROUP
      OBJECTS { gMAUTTPBidInterfaceType,
                          gMAUTTPBidMediaStatus,
                          gMAUTTPBidAutoNegotiationConf,
                          gMAUTTPBidAutoNegotiationRate,
                          gMAUTTPBidAutoNegotiationFlowDirectionality,
                          gMAUTTPBidAutoNegotiationFlowControlActive,
                          gMAUTTPBidAutoNegotiationCurrentStatus,
                          gMAUTTPBidAutoNegotiationRemoteSignalling,
                          gMAUTTPBidAutoNegotiationRemoteStatus,
                          gMAUTTPBidManualConfRate,
                          gMAUTTPBidManualConfFlowDirectionality,
                          gMAUTTPBidOperationalState,
                          gMAUTTPBidAsapIndex 
                          }
      STATUS deprecated 
      DESCRIPTION 
          " This group describes the GMAU TTP objects." 
::= { opticsIMTrsCommonMCGroup 1 }


opticsIME1TTPGroup OBJECT-GROUP
      OBJECTS { e1pPITTPSignalMode,
                          e1pPITTPFrameStatus,
                          e1pPITTPOperationalState,
                          e1pPITTPAsapIndex,
                          e1PathTTPFrameStatus,
                          e1PathTTPOperationalState,
                          e1PathTTPAsapIndex,
                          e1pPITTPAISSignalType,
                          e1pPITTPAISInsertion,
                          e1PathTTPAISInsertion,
                          e1pPITTPPseudoRandSeqInsertion,
                          e1pPITTPCrossConnectIdentifier                 
                          }
      STATUS current 
      DESCRIPTION 
          " This group describes the objects related to the management of E1 signals." 
::= { opticsIMTrsCommonMCGroup 2 }

opticsIMDs1TTPGroup OBJECT-GROUP
      OBJECTS { ds1pPITTPSignalMode,
                          ds1pPITTPLineCoding,
                          ds1pPITTPOperationalState,
                          ds1pPITTPAsapIndex,
                          ds1pPITTPLineLength,
                          ds1PathTTPOperationalState,
                          ds1PathTTPAsapIndex,
                          ds1pPITTPAISSignalType,
                          ds1pPITTPAISInsertion,
                          ds1PathTTPAISInsertion,
                          ds1pPITTPCrossConnectIdentifier                 
                          }
      STATUS current 
      DESCRIPTION 
          " This group describes the objects related to the management of DS1 signals." 
::= { opticsIMTrsCommonMCGroup 3 }


opticsIME3TTPGroup OBJECT-GROUP
      OBJECTS { e3pPITTPSignalMode,
                          e3pPITTPOperationalState,
                          e3pPITTPAsapIndex,
                          e3PathTTPOperationalState,
                          e3PathTTPAsapIndex,
                          e3pPITTPPseudoRandSeqInsertion,
                          e3pPITTPCrossConnectIdentifier                 
                          }
      STATUS current 
      DESCRIPTION 
          " This group describes the objects related to the management of E3 signals." 
::= { opticsIMTrsCommonMCGroup 4 }


opticsIMDs3TTPGroup OBJECT-GROUP
      OBJECTS { ds3pPITTPSignalMode,
                          ds3pPITTPOperationalState,
                          ds3pPITTPAsapIndex,
                          ds3PathTTPOperationalState,
                          ds3PathTTPAsapIndex,
                          ds3pPITTPParityViolationMonitoringRemoving,
                          ds3pPITTPAISSignalType,
                          ds3pPITTPAISInsertion,
                          ds3pPITTPAISSignalTiming,
                          ds3pPITTPIdleInsertion,
                          ds3pPITTPIdleDetection,
                          ds3PathTTPParityViolationMonitoringRemoving,
                          ds3PathTTPAISInsertion,
                          ds3pPITTPInputBridgeEnabled,
                          ds3pPITTPLineLength,
                          ds3pPITTPCrossConnectIdentifier                 
                          }
      STATUS current 
      DESCRIPTION 
          " This group describes the objects related to the management of DS3 signals." 
::= { opticsIMTrsCommonMCGroup 5 }


opticsIMRAIInsertionGroup OBJECT-GROUP
      OBJECTS { pdhRAIInsertionStatus
                          }
      STATUS current 
      DESCRIPTION 
          " This group describes the objects related to the management of the RAI insertion in PDH signals."
::= { opticsIMTrsCommonMCGroup 7 }


opticsIMSdhPdhCommonAlarmsGroup NOTIFICATION-GROUP
      NOTIFICATIONS { opticsIMAlarmSectionTraceMismatchRaise,
                                     opticsIMAlarmSectionTraceMismatchClear,
                                     opticsIMAlarmLinkIdentifierMismatchRaise,
                                     opticsIMAlarmLinkIdentifierMismatchClear,
                                     opticsIMAlarmPdhLossDueToSwitchRaise,
                                     opticsIMAlarmPdhLossDueToSwitchClear
                                     }
      STATUS current 
      DESCRIPTION 
          " This group describes the SDH and PDH alarms notifications." 
::= { opticsIMTrsCommonMCGroup 6 }


opticsIMAllDs1Group OBJECT-GROUP
      OBJECTS { opticsIMAllDs1LineCoding,
                          opticsIMAllDs1LineLength,
                          opticsIMAllDs1AISSignalType,
                          opticsIMAllDs1pPIAISInsertion,
                          opticsIMAllDs1PathAISInsertion                          }
      STATUS current 
      DESCRIPTION 
          " This group describes the objects related to the global management of all the DS1 signals." 
::= { opticsIMTrsCommonMCGroup 8 }

opticsIMAllE1Group OBJECT-GROUP
      OBJECTS { opticsIMAllE1AISSignalType,
                          opticsIMAllE1pPIAISInsertion,
                          opticsIMAllE1PathAISInsertion
                          }
      STATUS current 
      DESCRIPTION 
          " This group describes the objects related to the global management of all the E1 signals." 
::= { opticsIMTrsCommonMCGroup 11 }


opticsIMAllDs3Group OBJECT-GROUP
      OBJECTS { opticsIMAllDs3pPIParityViolationMonitoringRemoving,
		    opticsIMAllDs3PathParityViolationMonitoringRemoving,
                opticsIMAllDs3AISSignalType,
                opticsIMAllDs3pPIAISInsertion,
                opticsIMAllDs3PathAISInsertion,
                opticsIMAllDs3AISSignalTiming
              }
      STATUS current 
      DESCRIPTION 
          " This group describes the objects related to the global management of all the DS3 signals." 
::= { opticsIMTrsCommonMCGroup 12 }


opticsIMBERMeasureGroup OBJECT-GROUP
      OBJECTS { berMeasureElapsedTime,
                         berMeasureSuspectIntervalFlag,
                         berMeasureViolations,
                         berMeasureValue,
                         berMeasureRowStatus
                          }
      STATUS current 
      DESCRIPTION 
          " This group describes the objects related to the BER measure." 
::= { opticsIMTrsCommonMCGroup 9 }


--
-- S. Winslow Fixed inconsistent OBJECT-GROUP name
-- opticsIMAllowedDs1LinesLengthsGroup OBJECT-GROUP
   opticsIMAllowedDs1LineLengthsGroup OBJECT-GROUP
      OBJECTS { allowedDs1LineLengthMin,
                         allowedDs1LineLengthMax,
                         allowedDs1LineLengthId
                         }
      STATUS current 
      DESCRIPTION 
          " This group describes the objects related to the allowed ranges of lengths of the ds1 lines."
::= { opticsIMTrsCommonMCGroup 10 }


--
-- S. Winslow Fixed inconsistent OBJECT-GROUP name
-- opticsIMAllowedDs3LinesLengthsGroup OBJECT-GROUP
opticsIMAllowedDs3LineLengthsGroup OBJECT-GROUP
      OBJECTS { allowedDs3LineLengthMin,
                         allowedDs3LineLengthMax,
                         allowedDs3LineLengthId
                         }
      STATUS current 
      DESCRIPTION 
          " This group describes the objects related to the allowed ranges of lengths of the ds3 lines."
::= { opticsIMTrsCommonMCGroup 13 }

END
