
ALCATEL-IND1-LAG-MIB DEFINITIONS ::= BEGIN
  IMPORTS
    MODULE-IDENTITY, OBJECT-IDENTITY, OBJECT-TYPE, Counter32, 
      TimeTicks, Gauge32                                      FROM SNMPv2-SMI
    DisplayString, MacAddress, TEXTUAL-CONVENTION, RowStatus  FROM SNMPv2-TC
    NOTIFICATION-TYPE                                         FROM SNMPv2-SMI
    NOTIFICATION-GROUP                                        FROM SNMPv2-CONF
    MODULE-COMPLIANCE, OBJECT-GROUP                           FROM SNMPv2-CONF
    InterfaceIndex                                            FROM IF-MIB
    PortList                                                  FROM Q-BRIDGE-MIB
    LacpKey,LacpState,ChurnState                              FROM IEEE8023-LAG-MIB
    lnkaggTraps, softentIND1LnkAgg                            FROM ALCATEL-IND1-BASE 
    Dot1agCfmMepIdOrZero                                      FROM IEEE8021-CFM-MIB
  ;

alcatelIND1LAGMIB MODULE-IDENTITY
  LAST-UPDATED "202211290000Z"
  ORGANIZATION "ALCATEL - Architects Of An Internet World"
  CONTACT-INFO "Please consult with Customer Service to insure the most appropriate
                version of this document is used with the products in question:
                Alcatel Internetworking, Incorporated
                (Division 1, Formerly XYLAN Corporation)
                26801 West Agoura Road
                Agoura Hills, CA  91301-5122
                United States Of America
