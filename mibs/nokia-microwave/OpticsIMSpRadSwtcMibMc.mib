            thresholds." 
::= { opticsIMRadioSwtcMCGroup 8 }


opticsIMOptRadioSwitchEnableGroup OBJECT-GROUP
      OBJECTS { opticsIMRadioSwitchEWEnabled,
                          opticsIMRadioSwitchLowBEREnabled
                        }
      STATUS current 
      DESCRIPTION 
          " This group describes the objects related to the management of RPS switch enable." 
::= { opticsIMRadioSwtcMCGroup 9 }

   
