                          opticsIMRadioAutoRxStaticDelayDirectAway,
                          opticsIMRadioAutoRxStaticDelayIndirectAway,
                          opticsIMRadioManRxStaticDelay,
                          opticsIMRadioManRxStaticDelayDirectAway,
                          opticsIMRadioManRxStaticDelayIndirectAway,
                          opticsIMRadioManRxStaticDelayAsapIndex  }
      STATUS current 
      DESCRIPTION 
          " This group describes the Radio Rx Static Delay mandatory objects." 
::= { opticsIMRadioSwtcMCGroup 6 }


opticsIMTxProtectionGroup OBJECT-GROUP
