opticsIMWSTServChProtectionUnitType OBJECT-TYPE
	SYNTAX                        OpticsIMProtectionUnitType
	MAX-ACCESS               read-only
	STATUS                         current
	DESCRIPTION
" See Textual Conventions. "
::= { opticsIMWSTServChProtectionUnitEntry 2 }

opticsIMWSTServChProtectionUnitSwitchCommand OBJECT-TYPE
	SYNTAX                        OpticsIMProtectionSwitchCommand
	MAX-ACCESS               read-write
	STATUS                         current
	DESCRIPTION
" See Textual Conventions. "
::= { opticsIMWSTServChProtectionUnitEntry 3 }

opticsIMWSTServChProtectionUnitSwitchCriteria OBJECT-TYPE
	SYNTAX 	INTEGER {
         	noOne   (0),
         	earlyWarning   (1),
         	lowBer   (2),
         	highBer   (3),
         	signalFail   (4)
         }
	MAX-ACCESS               read-only
	STATUS                         current
	DESCRIPTION
" This object contains the highest priority automatic switch request currently active on the channel. "
::= { opticsIMWSTServChProtectionUnitEntry 4 }

opticsIMWSTServChProtectionUnitSwitchStatus OBJECT-TYPE
	SYNTAX                       OpticsIMProtectionSwitchStatus
	MAX-ACCESS              read-only
	STATUS                        current
	DESCRIPTION
" See Textual Conventions. "
::= { opticsIMWSTServChProtectionUnitEntry 5 }

opticsIMWSTProtection OBJECT-TYPE
     SYNTAX  INTEGER {
         unprotected (1),
         protected (2) 
         }
     MAX-ACCESS			read-write
     STATUS					current
     DESCRIPTION
          "This object specifies if the Way Side Traffic signal is protected or unprotected.
            As a side effect to set 'protected' value for this object, the agent must create an istance of
            opticsIMWSTServChProtectionGroupEntry and related instances of
            opticsIMWSTServChProtectionUnitEntry. 
            When the WST signals are unprotected, two radio channels carry two WST signals (e1 or ds1
            unprotected); instead, when WST signals are protected, two radio channels carry only one WST
            signal (e1 or ds1 protected): in this case the signalMode of e1 or ds1 signal associated to spare 
            radio channel become disabled. For this reason as a side effect to set 'protected' value for this
            object (opticsIMWSTProtection), the agent must set the columnar object 
            e1pPITTPSignalMode of opticalIME1pPITTPTable or columnar object
            ds1pPITTPSignalMode of opticalIMDs1pPITTPTable of e1 or ds1 signal associated to spare 
            radio channel to 'disabled' value."
      DEFVAL { unprotected }
::= { opticsIMRadioSwtcMibObject 9 }



