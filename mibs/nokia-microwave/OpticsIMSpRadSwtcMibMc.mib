--       REVISION "0201250000Z"
--       DESCRIPTION 
--           "Initial Release of Radio Protections Module Compliance."
    
-- ::= { opticsIMRadioSwtcMCConf 1 }

opticsIMRadioSwtcMCConf         OBJECT IDENTIFIER ::= { opticsimRadioMC 4 }
opticsIMRadioSwtcMCCompl      OBJECT IDENTIFIER ::= { opticsIMRadioSwtcMCConf 1 }
opticsIMRadioSwtcMCGroup      OBJECT IDENTIFIER ::= { opticsIMRadioSwtcMCConf 2 }

opticsIMRadioSwtcMc MODULE-COMPLIANCE
      STATUS current
      DESCRIPTION 
          "This module compliance describes a set of objects required for Optics-IM Agent 
            implementation. These objects are defined inside opticsIMRadioSwtcMib. "

       MODULE -- opticsIMRadioSwtcMib  

MANDATORY-GROUPS { opticsIMRadioProtectionGroup,
                                           opticsIMTxProtectionGroup,
                                           opticsIMRadioRxStaticDelayGroup}

GROUP opticsIMOptRadioProtectionGroup
      DESCRIPTION 
          " This group describes the Radio Protection optional objects. "

GROUP opticsIMOptRadioCLAGroup
      DESCRIPTION 
          " This group describes the Radio optional objects related to the CLA procedure. "

GROUP opticsIMOptRadioCLAAlarmsGroup
      DESCRIPTION
          " This group describes the CLA alarms notifications."

GROUP opticsIMWSTServChProtectionGroup
      DESCRIPTION 
          " This group describes the WST and Radio Service Channels Protection objects. "

GROUP opticsIMOptRxPowerLevelThresholdGroup
      DESCRIPTION 
         " This group describes the objects related to the management of Received Power Level
            thresholds." 

GROUP opticsIMOptRadioSwitchEnableGroup
      DESCRIPTION 
         " This group describes the objects related to the management of RPS switch enable." 
::= { opticsIMRadioSwtcMCCompl 1 }

opticsIMRadioProtectionGroup OBJECT-GROUP
