                          opticsIMRadioProtectionUnitType,
                          opticsIMRadioProtectionUnitSwitchCommand,
                          opticsIMRadioProtectionUnitSwitchCriteria,
                          opticsIMRadioProtectionUnitSwitchStatus }
      STATUS current 
      DESCRIPTION 
