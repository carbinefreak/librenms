OpticsIMTxProtectionUnitEntry ::= SEQUENCE {
   opticsIMTxProtectionUnitChannelNumber       OpticsIMRadioChannelNumber,
   opticsIMTxProtectionUnitType	                         OpticsIMProtectionUnitType,
   opticsIMTxProtectionUnitSwitchCommand      OpticsIMProtectionSwitchCommand,
   opticsIMTxProtectionUnitSwitchCriteria           OpticsIMEquipmentProtectionSwitchCriteria,
   opticsIMTxProtectionUnitSwitchStatus            OpticsIMProtectionSwitchStatus
   }

opticsIMTxProtectionUnitChannelNumber OBJECT-TYPE
	SYNTAX					OpticsIMRadioChannelNumber
	MAX-ACCESS			not-accessible
	STATUS					current
	DESCRIPTION
" See Textual Conventions. "
::= { opticsIMTxProtectionUnitEntry 1 }

opticsIMTxProtectionUnitType OBJECT-TYPE
	SYNTAX					OpticsIMProtectionUnitType
	MAX-ACCESS			read-only
	STATUS					current
	DESCRIPTION
" See Textual Conventions. "
::= { opticsIMTxProtectionUnitEntry 2 }

opticsIMTxProtectionUnitSwitchCommand OBJECT-TYPE
	SYNTAX					OpticsIMProtectionSwitchCommand
	MAX-ACCESS			read-write
	STATUS					current
	DESCRIPTION
" See Textual Conventions. "
::= { opticsIMTxProtectionUnitEntry 3 }

opticsIMTxProtectionUnitSwitchCriteria OBJECT-TYPE
	SYNTAX					OpticsIMEquipmentProtectionSwitchCriteria
	MAX-ACCESS			read-only
	STATUS					current
	DESCRIPTION
" See Textual Conventions. "
::= { opticsIMTxProtectionUnitEntry 4 }

opticsIMTxProtectionUnitSwitchStatus OBJECT-TYPE
	SYNTAX					OpticsIMProtectionSwitchStatus
	MAX-ACCESS			read-only
	STATUS					current
	DESCRIPTION
" See Textual Conventions. "
::= { opticsIMTxProtectionUnitEntry 5 }


opticsIMRadioCLAMngt OBJECT IDENTIFIER ::= { opticsIMRadioSwtcMibObject 5 }

opticsIMRadioCLAEnabled OBJECT-TYPE
     SYNTAX					TruthValue
     MAX-ACCESS			read-write
     STATUS					current
     DESCRIPTION
          "This object specifies if the CLA procedure is currently allowed to work or not. The true value 
            indicates that the CLA procedure is allowed to work and the false value that the procedure is not 
            allowed to work. "
::= { opticsIMRadioCLAMngt 1 }


opticsIMRadioCLAReset OBJECT-TYPE
     SYNTAX  INTEGER {
         resetting (1),
         notResetting (2) 
         }
     MAX-ACCESS			read-write
     STATUS					current
     DESCRIPTION
          "This object is used to trigger a reset of a ComonLossAlarm defect. 
           As consequence, a notification of the clearing of the alarm is emitted and the defect is removed 
           from the activeProblemTable. 
           When the reset has been completed, the agent has to change the value back to notResetting."
::= { opticsIMRadioCLAMngt 2 }

opticsIMRadioCLAAlarms OBJECT IDENTIFIER ::= { opticsIMRadioCLAMngt 3 }

-- common loss alarm

opticsIMAlarmCLARaise NOTIFICATION-TYPE
OBJECTS { tsdimEventObjectClassIdentifier,
                          tsdimEventObjectInstanceIdentifier, 
                          tsdimEventNotificationId,
                          tsdimEventTime,
                          tsdimAlarmSeverity,
                          tsdimAlarmSpecProblem,
                          opticsIMAdditionalText,
                          opticsIMAlarmType}
      STATUS current
      DESCRIPTION 
          "This notification reports the CLA defect raise."
::= { opticsIMRadioCLAAlarms 1 }

opticsIMAlarmCLAClear NOTIFICATION-TYPE
OBJECTS { tsdimEventObjectClassIdentifier,
                          tsdimEventObjectInstanceIdentifier, 
                          tsdimEventNotificationId,
                          tsdimEventTime,
                          tsdimAlarmSeverity,
                          tsdimAlarmSpecProblem,
                          opticsIMAdditionalText,
                          opticsIMAlarmType}
      STATUS current
      DESCRIPTION 
          "This notification reports the CLA defect clear."
::= { opticsIMRadioCLAAlarms 2 }

opticsIMRadioCLAStatus OBJECT-TYPE
SYNTAX  INTEGER {
         active (1),
         notActive (2) 
         }
     MAX-ACCESS			read-only
     STATUS				current
     DESCRIPTION
          "This object specifies the status of the CLA procedure (active or notActive). When the CLA 
           procedure is active an abnormal condition indication is generated."
::= { opticsIMRadioCLAMngt 4 }


