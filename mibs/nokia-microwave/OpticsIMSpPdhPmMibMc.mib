-- OPTICSIM-PDH-PM-MC DEFINITIONS ::= BEGIN
--       IMPORTS            
--       MODULE-IDENTITY, OBJECT-TYPE, OBJECT-IDENTITY FROM SNMPv2-SMI
--       MODULE-COMPLIANCE, NOTIFICATION-GROUP, OBJECT-GROUP FROM SNMPv2-CONF
--       opticsimSdhPdhMC FROM OPTICSIM-RADIOREG-MIB;


-- opticsIMPdhPmMCCompl MODULE-IDENTITY
--       LAST-UPDATED "0201250000Z"
--       ORGANIZATION "Alcatel TND"
--       CONTACT-INFO "Alcatel TND"
--       DESCRIPTION 
--           "Initial Release of PDH PM Module Compliance."
-- ::= { opticsIMPdhPmMCConf 1 }

opticsIMPdhPmMCConf         OBJECT IDENTIFIER ::= { opticsimSdhPdhMC  7  }
opticsIMPdhPmMCCompl      OBJECT IDENTIFIER ::= { opticsIMPdhPmMCConf 1 }
opticsIMPdhPmMCGroup      OBJECT IDENTIFIER ::= { opticsIMPdhPmMCConf 2 }

opticsIMPdhPmMc MODULE-COMPLIANCE
      STATUS current
      DESCRIPTION 
          "This module compliance describes a set of objects required for Optics-IM Agent 
            implementation. These objects are defined inside opticsIMPdhPmMib. "

       MODULE -- opticsIMPdhPmMib  


MANDATORY-GROUPS { opticsIMPdhFrameHopCurrentDataGroup,
                                            opticsIMPdhFrameHopHistoryDataGroup,
                                            opticsIMPdhFrameHopThresholdDataGroup,
                                            opticsIMPdhFrameLinkCurrentDataGroup,
                                            opticsIMPdhFrameLinkHistoryDataGroup,
                                            opticsIMPdhFrameLinkThresholdDataGroup,
                                            opticsIMDs3CurrentDataGroup,
