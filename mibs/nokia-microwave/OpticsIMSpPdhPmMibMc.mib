-- Performances E1

opticsIME1CurrentDataTable OBJECT-TYPE
       SYNTAX SEQUENCE OF OpticsIME1CurrentDataEntry
       MAX-ACCESS not-accessible
       STATUS current
       DESCRIPTION
             " This table contains the current data for the Performance Monitoring on E1. "
::= { opticsIMPdhPmMibObject 17 }

opticsIME1CurrentDataEntry OBJECT-TYPE
       SYNTAX OpticsIME1CurrentDataEntry
       MAX-ACCESS not-accessible
       STATUS current
       DESCRIPTION
            "An entry of the E1CurrentDataTable.
             An unavailable condition starts when 10 consecutive severely errored seconds have been 
            detected; these 10 seconds belong to the unavailable time. An unavailable condition 
            ends when 10 consecutive seconds with no severely errored second are detected. 
            These 10 seconds belong to  the available time.   
            If an unavailable period is ending then the UAT Clear shall be sent.
            These performance event counts are inhibited during unavailable time.

            In the objects where a Default Value is specified, the write operation is allowed only to the 
            indicated default value.
            The write operation to one counter is applied to all the counters of all the the associated objects, 
            which have a defined default."
       INDEX          {  ifIndex, pmE1CDIndex}
::= { opticsIME1CurrentDataTable 1 }   

OpticsIME1CurrentDataEntry ::= SEQUENCE {
   pmE1CDIndex                                 OpticsIMPmIndex,
   pmE1CDElapsedTime                     OpticsIMPmElapsedTime,
   pmE1CDGranularityPeriod              OpticsIMPmGranularityPeriod, 
   pmE1CDMaxSuppressedIntervals  OpticsIMPmMaxSuppressedIntervals, 
   pmE1CDNumSuppressedIntervals OpticsIMPmNumSuppressedIntervals,
   pmE1CDSuspectIntervalFlag         OpticsIMPmSuspectIntervalFlag,
   pmE1CDThresholdDataInstance    OpticsIMPmThresholdDataInstance,
   pmE1CDStartByOS                        TsdimManagerType,
   pmE1CDSes                                   Gauge32,
   pmE1CDUas                                   Gauge32,
   pmE1CDEs                                     Gauge32,
   pmE1CDRowStatus                        RowStatus,
   pmE1CDAsapIndex                        Integer32,
   pmE1CDBbe                                  Gauge32
   }

pmE1CDIndex OBJECT-TYPE
       SYNTAX OpticsIMPmIndex
       MAX-ACCESS not-accessible
       STATUS current
       DESCRIPTION
           "See Textual Conventions"
::= { opticsIME1CurrentDataEntry 1 }

