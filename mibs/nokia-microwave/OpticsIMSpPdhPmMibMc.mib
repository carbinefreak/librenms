       STATUS current
       DESCRIPTION
            "See Textual Conventions"
::= { opticsIME1CurrentDataEntry 3 }

pmE1CDMaxSuppressedIntervals OBJECT-TYPE
       SYNTAX OpticsIMPmMaxSuppressedIntervals
       MAX-ACCESS read-create
       STATUS current
       DESCRIPTION
            "See Textual Conventions"
::= { opticsIME1CurrentDataEntry 4 }

