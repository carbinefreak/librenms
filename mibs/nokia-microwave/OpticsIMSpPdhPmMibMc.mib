   pmPdhFrameHopEsHighThr          Unsigned32,
   pmPdhFrameHopEsLowThr           Unsigned32,
   pmPdhFrameHopUserLabel           OpticsIMUserLabel,
   pmPdhFrameHopRowStatus          RowStatus
   }

pmPdhFrameHopThrIndex OBJECT-TYPE
