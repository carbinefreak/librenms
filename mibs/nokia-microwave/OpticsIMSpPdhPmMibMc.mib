-- Performances DS3

opticsIMDs3CurrentDataTable OBJECT-TYPE
       SYNTAX SEQUENCE OF OpticsIMDs3CurrentDataEntry
       MAX-ACCESS not-accessible
       STATUS current
       DESCRIPTION
             " This table contains the current data for the Performance Monitoring on DS3. "
::= { opticsIMPdhPmMibObject 9 }

opticsIMDs3CurrentDataEntry OBJECT-TYPE
       SYNTAX OpticsIMDs3CurrentDataEntry
       MAX-ACCESS not-accessible
       STATUS current
       DESCRIPTION
            "An entry of the Ds3CurrentDataTable.
             An unavailable condition starts when 10 consecutive severely errored seconds have been 
            detected; these 10 seconds belong to the unavailable time. An unavailable condition 
            ends when 10 consecutive seconds with no severely errored second are detected. 
            These 10 seconds belong to  the available time.   
            If an unavailable period is ending then the UAT Clear shall be sent.
            These performance event counts are inhibited during unavailable time.

            In the objects where a Default Value is specified, the write operation is allowed only to the 
            indicated default value.
            The write operation to one counter is applied to all the counters of all the the associated objects, 
            which have a defined default."
       INDEX          {  ifIndex, pmDs3CDIndex}
::= { opticsIMDs3CurrentDataTable 1 }   

OpticsIMDs3CurrentDataEntry ::= SEQUENCE {
   pmDs3CDIndex                                 OpticsIMPmIndex,
   pmDs3CDElapsedTime                     	OpticsIMPmElapsedTime,
   pmDs3CDGranularityPeriod              	OpticsIMPmGranularityPeriod, 
   pmDs3CDMaxSuppressedIntervals  		OpticsIMPmMaxSuppressedIntervals, 
   pmDs3CDNumSuppressedIntervals 		OpticsIMPmNumSuppressedIntervals,
   pmDs3CDSuspectIntervalFlag         		OpticsIMPmSuspectIntervalFlag,
   pmDs3CDThresholdDataInstance    		OpticsIMPmThresholdDataInstance,
   pmDs3CDStartByOS                        	TsdimManagerType,
   pmDs3CDSes                                   Gauge32,
   pmDs3CDUas                                   Gauge32,
   pmDs3CDEs                                    Gauge32,
   pmDs3CDRowStatus                        	RowStatus,
   pmDs3CDAsapIndex                        	Integer32,
   pmDs3CDBbe                                 	Gauge32
   }

pmDs3CDIndex OBJECT-TYPE
       SYNTAX OpticsIMPmIndex
       MAX-ACCESS not-accessible
       STATUS current
       DESCRIPTION
           "See Textual Conventions"
::= { opticsIMDs3CurrentDataEntry 1 }

 pmDs3CDElapsedTime OBJECT-TYPE
       SYNTAX OpticsIMPmElapsedTime
       MAX-ACCESS read-only
       STATUS current
       DESCRIPTION
            "See Textual Conventions"
::= { opticsIMDs3CurrentDataEntry 2 }

pmDs3CDGranularityPeriod OBJECT-TYPE
       SYNTAX OpticsIMPmGranularityPeriod
       MAX-ACCESS read-only
       STATUS current
       DESCRIPTION
            "See Textual Conventions"
::= { opticsIMDs3CurrentDataEntry 3 }

pmDs3CDMaxSuppressedIntervals OBJECT-TYPE
       SYNTAX OpticsIMPmMaxSuppressedIntervals
       MAX-ACCESS read-create
       STATUS current
       DESCRIPTION
            "See Textual Conventions"
::= { opticsIMDs3CurrentDataEntry 4 }

pmDs3CDNumSuppressedIntervals OBJECT-TYPE
       SYNTAX OpticsIMPmNumSuppressedIntervals
       MAX-ACCESS read-only
       STATUS current
       DESCRIPTION
            "See Textual Conventions"
::= { opticsIMDs3CurrentDataEntry 5 }

pmDs3CDSuspectIntervalFlag OBJECT-TYPE
       SYNTAX OpticsIMPmSuspectIntervalFlag
       MAX-ACCESS read-create
       STATUS current
       DESCRIPTION
            "See Textual Conventions"
       DEFVAL {1} -- True
::= { opticsIMDs3CurrentDataEntry 6 }

pmDs3CDThresholdDataInstance OBJECT-TYPE
       SYNTAX  OpticsIMPmThresholdDataInstance
       MAX-ACCESS read-create
       STATUS current
       DESCRIPTION
            "See Textual Conventions"
::= { opticsIMDs3CurrentDataEntry 7 }

pmDs3CDStartByOS OBJECT-TYPE
       SYNTAX TsdimManagerType
       MAX-ACCESS read-only
       STATUS current
       DESCRIPTION
            " See Textual Conventions"
::= { opticsIMDs3CurrentDataEntry 8 }

pmDs3CDSes  OBJECT-TYPE
       SYNTAX Gauge32
       MAX-ACCESS read-create
       STATUS current
       DESCRIPTION
            "The number of SES. "
       DEFVAL {0} 
::= { opticsIMDs3CurrentDataEntry 9 }

pmDs3CDUas OBJECT-TYPE
       SYNTAX Gauge32
       MAX-ACCESS read-create
       STATUS current
       DESCRIPTION
            "The number of UAS.  "
       DEFVAL {0} 
::= { opticsIMDs3CurrentDataEntry 10 }

pmDs3CDEs  OBJECT-TYPE
       SYNTAX Gauge32
       MAX-ACCESS read-create
       STATUS current
       DESCRIPTION
            "The number of ES."
       DEFVAL {0} 
::= { opticsIMDs3CurrentDataEntry 11 }

pmDs3CDRowStatus OBJECT-TYPE
       SYNTAX RowStatus
       MAX-ACCESS read-create
       STATUS current
       DESCRIPTION
         "When an entry of this table is deleted the corresponding entries of HD table are deleted.
          When an entry of this table is put to not in service, the measures of this CD are frozen, that is all 
          the counters are stopped."
::= { opticsIMDs3CurrentDataEntry 12 }

pmDs3CDAsapIndex OBJECT-TYPE
       SYNTAX Integer32 
       MAX-ACCESS read-create 
       STATUS current
       DESCRIPTION
         "It indicates the ASAP object associated to this CD."
::= { opticsIMDs3CurrentDataEntry 13 }

pmDs3CDBbe OBJECT-TYPE
       SYNTAX Gauge32
       MAX-ACCESS read-create
       STATUS current
       DESCRIPTION
            "The number of BBE."
       DEFVAL {0} 
::= { opticsIMDs3CurrentDataEntry 14 }


opticsIMDs3HistoryDataTable OBJECT-TYPE
       SYNTAX SEQUENCE OF OpticsIMDs3HistoryDataEntry
       MAX-ACCESS not-accessible
       STATUS current
       DESCRIPTION
            " This table contains the History Data for the Performance Monitoring on DS3 level" 
::= { opticsIMPdhPmMibObject 10 }

opticsIMDs3HistoryDataEntry OBJECT-TYPE
       SYNTAX OpticsIMDs3HistoryDataEntry
       MAX-ACCESS not-accessible
       STATUS current
       DESCRIPTION
            " An entry of the Ds3HistoryDataTable.
              One entry of this table is created at the end of the time interval of the related CD (defined by 
              granularity Period).
              At most n entries of opticsIMDs3HistoryDataTable can be created indexed by the
              indexes of the corresponding CD entry and by the time of the measure 
              (pmDs3HDPeriodEndTime). 
              This set of n entries is wrapped, when the n+1 measure is provided. The n+1 measure is written 
              in the row of the table indexed by the smallest value of PeriodEndTime. "
       INDEX       { ifIndex, pmDs3CDIndex, pmDs3HDPeriodEndTime }
::= { opticsIMDs3HistoryDataTable 1 }

OpticsIMDs3HistoryDataEntry ::= SEQUENCE {
   pmDs3HDElapsedTime                    	OpticsIMPmElapsedTime,
   pmDs3HDGranularityPeriod               	OpticsIMPmGranularityPeriod, 
   pmDs3HDNumSuppressedIntervals   		OpticsIMPmNumSuppressedIntervals,
   pmDs3HDPeriodEndTime                		OpticsIMPmPeriodTime,
   pmDs3HDSuspectIntervalFlag           	OpticsIMPmSuspectIntervalFlag,
   pmDs3HDStartByOS                          	TsdimManagerType,
   pmDs3HDSes                                   Gauge32,
   pmDs3HDUas                                   Gauge32,
   pmDs3HDEs                                    Gauge32,
   pmDs3HDBbe                                   Gauge32
   }

 pmDs3HDElapsedTime OBJECT-TYPE
     SYNTAX OpticsIMPmElapsedTime
