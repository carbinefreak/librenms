OPTICSIM-PDH-PM-MIB DEFINITIONS ::= BEGIN
       IMPORTS
       MODULE-IDENTITY, OBJECT-TYPE, 
       Integer32, Unsigned32, Gauge32 FROM SNMPv2-SMI
       RowStatus FROM SNMPv2-TC
       ifIndex FROM IF-MIB
       MODULE-COMPLIANCE, OBJECT-GROUP FROM SNMPv2-CONF
       OpticsIMPmIndex, OpticsIMPmElapsedTime, OpticsIMPmGranularityPeriod, 
       OpticsIMPmMaxSuppressedIntervals, OpticsIMPmNumSuppressedIntervals, 
       OpticsIMPmSuspectIntervalFlag, OpticsIMPmThresholdDataInstance, 
       OpticsIMPmPeriodTime, OpticsIMThrIndexNext2 FROM  OPTICSIM-COMMON-TC
       opticsimSdhPdhMib,opticsimSdhPdhMC FROM OPTICSIM-RADIOREG-MIB
       TsdimManagerType, OpticsIMUserLabel FROM TSDIM-SNMP-TC;

 opticsIMPdhPmMib MODULE-IDENTITY
       LAST-UPDATED "1107270000Z"
       ORGANIZATION "Alcatel TND"
       CONTACT-INFO "Alcatel TND"
       DESCRIPTION
                "Added BBE counter on DS1 and DS3 performance monitoring."

       REVISION "0808070000Z" 
       DESCRIPTION
                "Fixed inconsistent GROUP name"

       REVISION "0805290000Z"
       DESCRIPTION
                "Added BBE counter on E1 performance monitoring."
       REVISION "0610190000Z"
       DESCRIPTION
                "Added DS1, E1, E3 Performance Monitoring tables."
       REVISION "0406150000Z"

       DESCRIPTION
                "Added DS3 Performance Monitoring tables."
       REVISION "0211050000Z"
       DESCRIPTION
                "Change of some syntax types due to renaming of Common PM Textual Conventions."
       REVISION "0211050000Z"
       DESCRIPTION
                "Initial Release of PDH PM MIB"
 ::= {  opticsimSdhPdhMib  7}


opticsIMPdhPmMibObject      OBJECT IDENTIFIER ::= { opticsIMPdhPmMib 1 }




opticsIMPdhFrameHopCurrentDataTable OBJECT-TYPE
       SYNTAX SEQUENCE OF OpticsIMPdhFrameHopCurrentDataEntry
       MAX-ACCESS not-accessible
       STATUS current
       DESCRIPTION
             " This table contains the current data for the Performance Monitoring on PDH Frame at Radio 
               Hop level. "
::= { opticsIMPdhPmMibObject 1 }

opticsIMPdhFrameHopCurrentDataEntry OBJECT-TYPE
       SYNTAX OpticsIMPdhFrameHopCurrentDataEntry
       MAX-ACCESS not-accessible
       STATUS current
       DESCRIPTION
            "An entry of the pdhFrameHopCurrentDataTable.
             An unavailable condition starts when 10 consecutive severely errored seconds have been 
            detected; these 10 seconds belong to the unavailable time. An unavailable condition 
            ends when 10 consecutive seconds with no severely errored second are detected. 
            These 10 seconds belong to  the available time.   
            If an unavailable period is ending then the UAT Clear shall be sent.
            These performance event counts are inhibited during unavailable time.

            In the objects where a Default Value is specified, the write operation is allowed only to the 
            indicated default value.
            The write operation to one counter is applied to all the counters of all the the associated objects, 
            which have a defined default."
       INDEX          {  ifIndex, pmPdhFrameHopCDIndex}
::= { opticsIMPdhFrameHopCurrentDataTable 1 }   

OpticsIMPdhFrameHopCurrentDataEntry ::= SEQUENCE {
   pmPdhFrameHopCDIndex                                OpticsIMPmIndex,
   pmPdhFrameHopCDElapsedTime                    OpticsIMPmElapsedTime,
   pmPdhFrameHopCDGranularityPeriod             OpticsIMPmGranularityPeriod, 
   pmPdhFrameHopCDMaxSuppressedIntervals OpticsIMPmMaxSuppressedIntervals, 
   pmPdhFrameHopCDNumSuppressedIntervals OpticsIMPmNumSuppressedIntervals,
   pmPdhFrameHopCDSuspectIntervalFlag         OpticsIMPmSuspectIntervalFlag,
   pmPdhFrameHopCDThresholdDataInstance   OpticsIMPmThresholdDataInstance,
   pmPdhFrameHopCDStartByOS                       TsdimManagerType,
   pmPdhFrameHopCDSes                                  Gauge32,
   pmPdhFrameHopCDUas                                  Gauge32,
   pmPdhFrameHopCDBbe                                  Gauge32,
   pmPdhFrameHopCDEs                                    Gauge32,
   pmPdhFrameHopCDRowStatus                       RowStatus,
   pmPdhFrameHopCDAsapIndex                       Integer32
   }

pmPdhFrameHopCDIndex OBJECT-TYPE
       SYNTAX OpticsIMPmIndex
       MAX-ACCESS not-accessible
       STATUS current
       DESCRIPTION
           "See Textual Conventions"
::= { opticsIMPdhFrameHopCurrentDataEntry 1 }

 pmPdhFrameHopCDElapsedTime OBJECT-TYPE
       SYNTAX OpticsIMPmElapsedTime
       MAX-ACCESS read-only
       STATUS current
       DESCRIPTION
            "See Textual Conventions"
::= { opticsIMPdhFrameHopCurrentDataEntry 2 }

pmPdhFrameHopCDGranularityPeriod OBJECT-TYPE
       SYNTAX OpticsIMPmGranularityPeriod
       MAX-ACCESS read-only
       STATUS current
       DESCRIPTION
            "See Textual Conventions"
::= { opticsIMPdhFrameHopCurrentDataEntry 3 }

pmPdhFrameHopCDMaxSuppressedIntervals OBJECT-TYPE
       SYNTAX OpticsIMPmMaxSuppressedIntervals
       MAX-ACCESS read-create
       STATUS current
       DESCRIPTION
            "See Textual Conventions"
::= { opticsIMPdhFrameHopCurrentDataEntry 4 }

pmPdhFrameHopCDNumSuppressedIntervals OBJECT-TYPE
       SYNTAX OpticsIMPmNumSuppressedIntervals
       MAX-ACCESS read-only
       STATUS current
       DESCRIPTION
            "See Textual Conventions"
::= { opticsIMPdhFrameHopCurrentDataEntry 5 }

pmPdhFrameHopCDSuspectIntervalFlag OBJECT-TYPE
       SYNTAX OpticsIMPmSuspectIntervalFlag
       MAX-ACCESS read-create
       STATUS current
       DESCRIPTION
            "See Textual Conventions"
       DEFVAL {1} -- True
::= { opticsIMPdhFrameHopCurrentDataEntry 6 }

pmPdhFrameHopCDThresholdDataInstance OBJECT-TYPE
       SYNTAX  OpticsIMPmThresholdDataInstance
       MAX-ACCESS read-create
       STATUS current
       DESCRIPTION
            "See Textual Conventions"
::= { opticsIMPdhFrameHopCurrentDataEntry 7 }

pmPdhFrameHopCDStartByOS OBJECT-TYPE
       SYNTAX TsdimManagerType
       MAX-ACCESS read-only
       STATUS current
       DESCRIPTION
            " See Textual Conventions"
::= { opticsIMPdhFrameHopCurrentDataEntry 8 }

pmPdhFrameHopCDSes  OBJECT-TYPE
       SYNTAX Gauge32
       MAX-ACCESS read-create
       STATUS current
       DESCRIPTION
            "The number of SES. "
       DEFVAL {0} 
::= { opticsIMPdhFrameHopCurrentDataEntry 9 }

pmPdhFrameHopCDUas OBJECT-TYPE
       SYNTAX Gauge32
       MAX-ACCESS read-create
       STATUS current
       DESCRIPTION
            "The number of UAS.  "
       DEFVAL {0} 
::= { opticsIMPdhFrameHopCurrentDataEntry 10 }

pmPdhFrameHopCDBbe OBJECT-TYPE
       SYNTAX Gauge32
       MAX-ACCESS read-create
       STATUS current
       DESCRIPTION
            "The number of BBE."
       DEFVAL {0} 
::= { opticsIMPdhFrameHopCurrentDataEntry 11 }

pmPdhFrameHopCDEs  OBJECT-TYPE
       SYNTAX Gauge32
       MAX-ACCESS read-create
       STATUS current
       DESCRIPTION
            "The number of ES."
       DEFVAL {0} 
::= { opticsIMPdhFrameHopCurrentDataEntry 12 }

pmPdhFrameHopCDRowStatus OBJECT-TYPE
       SYNTAX RowStatus
       MAX-ACCESS read-create
       STATUS current
       DESCRIPTION
         "When an entry of this table is deleted the corresponding entries of HD table are deleted.
          When an entry of this table is put to not in service, the measures of this CD are frozen, that is all 
          the counters are stopped."
::= { opticsIMPdhFrameHopCurrentDataEntry 13 }

pmPdhFrameHopCDAsapIndex OBJECT-TYPE
       SYNTAX Integer32 
       MAX-ACCESS read-create 
       STATUS current
       DESCRIPTION
         "It indicates the ASAP object associated to this CD."
::= { opticsIMPdhFrameHopCurrentDataEntry 14 }


opticsIMPdhFrameHopHistoryDataTable OBJECT-TYPE
       SYNTAX SEQUENCE OF OpticsIMPdhFrameHopHistoryDataEntry
       MAX-ACCESS not-accessible
       STATUS current
       DESCRIPTION
            " This table contains the History Data for the Performance Monitoring on PDH Frame at Radio 
               Hop level.. "
::= { opticsIMPdhPmMibObject 2 }

opticsIMPdhFrameHopHistoryDataEntry OBJECT-TYPE
       SYNTAX OpticsIMPdhFrameHopHistoryDataEntry
       MAX-ACCESS not-accessible
       STATUS current
       DESCRIPTION
            " An entry of the pdhFrameHopHistoryDataTable.
              One entry of this table is created at the end of the time interval of the related CD (defined by 
              granularity Period).
              At most n entries of opticsIMPdhFrameHopHistoryDataTable can be created indexed by the
              indexes of the corresponding CD entry and by the time of the measure 
              (pmPdhFrameHopHDPeriodEndTime). 
              This set of n entries is wrapped, when the n+1 measure is provided. The n+1 measure is written 
              in the row of the table indexed by the smallest value of PeriodEndTime. "
       INDEX       { ifIndex, pmPdhFrameHopCDIndex, pmPdhFrameHopHDPeriodEndTime }
::= { opticsIMPdhFrameHopHistoryDataTable 1 }

OpticsIMPdhFrameHopHistoryDataEntry ::= SEQUENCE {
   pmPdhFrameHopHDElapsedTime                    OpticsIMPmElapsedTime,
   pmPdhFrameHopHDGranularityPeriod             OpticsIMPmGranularityPeriod, 
   pmPdhFrameHopHDNumSuppressedIntervals OpticsIMPmNumSuppressedIntervals,
   pmPdhFrameHopHDPeriodEndTime                OpticsIMPmPeriodTime,
   pmPdhFrameHopHDSuspectIntervalFlag         OpticsIMPmSuspectIntervalFlag,
   pmPdhFrameHopHDStartByOS                        TsdimManagerType,
   pmPdhFrameHopHDSes                                   Gauge32,
   pmPdhFrameHopHDUas                                   Gauge32,
   pmPdhFrameHopHDBbe                                   Gauge32,
   pmPdhFrameHopHDEs                                     Gauge32
   }

 pmPdhFrameHopHDElapsedTime OBJECT-TYPE
     SYNTAX OpticsIMPmElapsedTime
     MAX-ACCESS read-only
     STATUS current
     DESCRIPTION
          "See Textual Conventions."
::= { opticsIMPdhFrameHopHistoryDataEntry 1 }

