OPTICSIM-RADIO-PM-MIB DEFINITIONS ::= BEGIN
       IMPORTS
       MODULE-IDENTITY, OBJECT-TYPE, Integer32, Unsigned32, Gauge32 FROM SNMPv2-SMI
       TruthValue, RowStatus FROM SNMPv2-TC
       ifIndex FROM IF-MIB
       MODULE-COMPLIANCE, OBJECT-GROUP FROM SNMPv2-CONF
       OpticsIMPmIndex, OpticsIMPmElapsedTime, OpticsIMPmGranularityPeriod, 
       OpticsIMPmMaxSuppressedIntervals, OpticsIMPmNumSuppressedIntervals, 
       OpticsIMPmSuspectIntervalFlag, OpticsIMPmThresholdDataInstance,
       OpticsIMPmPeriodTime, OpticsIMThrIndexNext2 FROM OPTICSIM-COMMON-TC
       opticsimRadioMib,opticsimRadioMC FROM OPTICSIM-RADIOREG-MIB
       TsdimManagerType, OpticsIMUserLabel FROM TSDIM-SNMP-TC;
   

opticsIMRadioPmMib MODULE-IDENTITY
       LAST-UPDATED "1703280000Z"
       ORGANIZATION "Alcatel TND"
       CONTACT-INFO "Alcatel TND"
       DESCRIPTION
                " Radio PM MIB."

      REVISION "1703280000Z"
       DESCRIPTION
    	"Added new tables: 
		- opticsIMPeakAndAverageCurrentDataTable 
 		- opticsIMPeakAndAverageHistoryDataTable           
   	"

       REVISION "1702280000Z"
       DESCRIPTION
    	"- SNMPIDL-529: addition of new counters on opticsIMAdaptiveModulationCurrentDataTable : 
                        - pmAdaptiveModulationCDUsageTimeBPskOneFourth
                        - pmAdaptiveModulationCDUsageTimeBPskOneHalf
                        - pmAdaptiveModulationCDUsageTimeBPsk
                and on opticsIMAdaptiveModulationHistoryDataTable :
                        - pmAdaptiveModulationHDUsageTimeBPskOneFourth
                        - pmAdaptiveModulationHDUsageTimeBPskOneHalf
                        - pmAdaptiveModulationHDUsageTimeBPsk
   	"

      REVISION "1511130000Z"
       DESCRIPTION
    	"- SNMPIDL-507, update LAST-UPDATED and REVISION date format adding the 2 digits missing (20) for yers after 1999.
Added a REVISION block corresponding to the LAST-UPDATED timestamp.
      	 - SNMPIDL-508, added a space between opening and closing braces and the enclosed content.
    	"

       REVISION "1307060000Z"
       DESCRIPTION
                " OPTnm21897 - D.Spreafico
		  - Added opticsIMRSLDivHopCurrentDataTable / opticsIMRSLDivHopHistoryDataTable
                          opticsIMRSLDivLinkCurrentDataTable / opticsIMRSLDivLinkHistoryDataTable
                  OPTnm - D.Spreafico
		  -  Addition a new counter on opticsIMAdaptiveModulationCurrentDataTable (pmAdaptiveModulationCDUsageTime4096QAM)
                     and on  opticsIMAdaptiveModulationHistoryDataTable (pmAdaptiveModulationHDUsageTime4096QAM)
                ."

       REVISION "1301100000Z"

       DESCRIPTION
                " Addition of new counters on opticsIMAdaptiveModulationCurrentDataTable : 
			- pmAdaptiveModulationCDUsageTime512QAM               
  			- pmAdaptiveModulationCDUsageTime1024QAM               
   			- pmAdaptiveModulationCDUsageTime2048QAM 
                and on opticsIMAdaptiveModulationHistoryDataTable :
			- pmAdaptiveModulationHDUsageTime512QAM             
   			- pmAdaptiveModulationHDUsageTime1024QAM            
   			- pmAdaptiveModulationHDUsageTime2048QAM 
                ."

       REVISION "1009300000Z"
       DESCRIPTION
                " Addition of new table for TSL (Transmit Signal Level) Performance Monitoring:
                  -- opticsIMTSLHopCurrentDataTable 
                  -- opticsIMTSLHopHistoryDataTable 
	 	  Added scalar object opticsIMSLSuppressedIntervals
                 ."

       REVISION "0904230000Z"
       DESCRIPTION
                " Addition of new table for RSL Receive Signal Level) Performance Monitoring:
                  -- opticsIMRSLHopCurrentDataTable 
                  -- opticsIMRSLHopHistoryDataTable 
                  -- opticsIMRSLLinkCurrentDataTable 
                  -- opticsIMRSLLinkHistoryDataTable 
                 ."

       REVISION "0808070000Z"
       DESCRIPTION
                " Addition of new counters to Adaptive Modulation Performance Monitoring tables."

       REVISION "0710110000Z"
       DESCRIPTION
                " Addition of Adaptive Modulation Performance Monitoring tables."

       REVISION "0406150000Z"
       DESCRIPTION
                " Addition of RFCOH Performance Monitoring tables."

       REVISION "0201250000Z"
       DESCRIPTION
                "Initial Release of Radio PM MIB."
 ::= {  opticsimRadioMib 5 }


opticsIMRadioPmMibObject      OBJECT IDENTIFIER ::= { opticsIMRadioPmMib 1 }



opticsIMRpsCriteriaCurrentDataTable OBJECT-TYPE
       SYNTAX SEQUENCE OF	OpticsIMRpsCriteriaCurrentDataEntry
       MAX-ACCESS		not-accessible
       STATUS				current
       DESCRIPTION
             "This table contains the Current Data for the Radio Protection Switching (RPS) Criteria 
              Monitoring. "
::= { opticsIMRadioPmMibObject 1 }

opticsIMRpsCriteriaCurrentDataEntry OBJECT-TYPE
       SYNTAX			OpticsIMRpsCriteriaCurrentDataEntry
       MAX-ACCESS	not-accessible
       STATUS			current
       DESCRIPTION
            "An entry of the RPS Criteria Monitoring Current Data table. 
             In the objects where a Default Value is specified, the write operation is allowed only to the 
             indicated default value.
             The write operation to one counter is applied to all the counters of all the associated objects, 
             which have a defined default."
       INDEX    {  ifIndex, pmRpsCriteriaCDIndex }
::= { opticsIMRpsCriteriaCurrentDataTable 1 } 

OpticsIMRpsCriteriaCurrentDataEntry ::= SEQUENCE {
   pmRpsCriteriaCDIndex					OpticsIMPmIndex,
   pmRpsCriteriaCDElapsedTime		OpticsIMPmElapsedTime,
   pmRpsCriteriaCDGranularityPeriod				OpticsIMPmGranularityPeriod, 
   pmRpsCriteriaCDMaxSuppressedIntervals		OpticsIMPmMaxSuppressedIntervals, 
   pmRpsCriteriaCDNumSuppressedIntervals	OpticsIMPmNumSuppressedIntervals,
   pmRpsCriteriaCDSuspectIntervalFlag			OpticsIMPmSuspectIntervalFlag,
   pmRpsCriteriaCDStartByOS		TsdimManagerType,
   pmRpsCriteriaCDEwsc				Gauge32,
   pmRpsCriteriaCDLbersc			Gauge32,
   pmRpsCriteriaCDHbersc			Gauge32,
   pmRpsCriteriaCDSfsc				Gauge32,
   pmRpsCriteriaCDRowStatus		RowStatus
   }

pmRpsCriteriaCDIndex OBJECT-TYPE
       SYNTAX			OpticsIMPmIndex
       MAX-ACCESS	not-accessible
       STATUS			current
       DESCRIPTION
           "See Textual Conventions."
::= { opticsIMRpsCriteriaCurrentDataEntry 1 }

