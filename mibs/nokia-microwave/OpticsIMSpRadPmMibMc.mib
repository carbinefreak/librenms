-- opticsIMAdaptiveModulationCurrentDataTable 

opticsIMAdaptiveModulationCurrentDataTable OBJECT-TYPE
       SYNTAX SEQUENCE OF OpticsIMAdaptiveModulationCurrentDataEntry
       MAX-ACCESS not-accessible
       STATUS current
       DESCRIPTION
             "This table contains the current data for the Adaptive Modulation PM. "
::= { opticsIMRadioPmMibObject 9 }

opticsIMAdaptiveModulationCurrentDataEntry OBJECT-TYPE
       SYNTAX OpticsIMAdaptiveModulationCurrentDataEntry
       MAX-ACCESS not-accessible
       STATUS current
       DESCRIPTION
           "An entry of the Adaptive Modulation current data table. 

            In the objects where a Default Value is specified, the write operation is allowed only to the 
            indicated default value.
            The write operation to one counter is applied to all the counters of all the associated objects, 
            which have a defined default."
       INDEX          {  ifIndex, pmAdaptiveModulationCDIndex}
       ::= { opticsIMAdaptiveModulationCurrentDataTable 1 }   

OpticsIMAdaptiveModulationCurrentDataEntry ::= SEQUENCE {
   pmAdaptiveModulationCDIndex                         OpticsIMPmIndex,
   pmAdaptiveModulationCDElapsedTime            	 OpticsIMPmElapsedTime,
   pmAdaptiveModulationCDGranularityPeriod             OpticsIMPmGranularityPeriod, 
   pmAdaptiveModulationCDSuspectIntervalFlag           OpticsIMPmSuspectIntervalFlag,
   pmAdaptiveModulationCDStartByOS            		 TsdimManagerType,
   pmAdaptiveModulationCDUsageTime4QAM                 Gauge32,
   pmAdaptiveModulationCDUsageTime16QAM                Gauge32,
   pmAdaptiveModulationCDUsageTime64QAM                Gauge32,
   pmAdaptiveModulationCDRowStatus          		 RowStatus,
   pmAdaptiveModulationCDUsageTime8QAM                 Gauge32,
   pmAdaptiveModulationCDUsageTime32QAM               Gauge32,
   pmAdaptiveModulationCDUsageTime128QAM               Gauge32,
   pmAdaptiveModulationCDUsageTime256QAM               Gauge32,
   pmAdaptiveModulationCDUsageTime512QAM               Gauge32,
   pmAdaptiveModulationCDUsageTime1024QAM               Gauge32,
   pmAdaptiveModulationCDUsageTime2048QAM               Gauge32,
   pmAdaptiveModulationCDUsageTime4096QAM               Gauge32,
   pmAdaptiveModulationCDUsageTimeBPskOneFourth		Gauge32,
   pmAdaptiveModulationCDUsageTimeBPskOneHalf		Gauge32,
   pmAdaptiveModulationCDUsageTimeBPsk			Gauge32
   }

pmAdaptiveModulationCDIndex OBJECT-TYPE
       SYNTAX OpticsIMPmIndex
