-- OPTICSIM-RADIO-PM-MC DEFINITIONS ::= BEGIN
--       IMPORTS            
--       MODULE-IDENTITY, OBJECT-TYPE, OBJECT-IDENTITY FROM SNMPv2-SMI
--       MODULE-COMPLIANCE, NOTIFICATION-GROUP, OBJECT-GROUP FROM SNMPv2-CONF
--       opticsimRadioMC FROM OPTICSIM-RADIOREG-MIB;


-- opticsIMRadioPmMCCompl MODULE-IDENTITY
--       LAST-UPDATED "0201250000Z"
--       ORGANIZATION "Alcatel TND"
--       CONTACT-INFO "Alcatel TND"
--       DESCRIPTION 
--           "Initial Release of Radio PM Module Compliance."
    
-- ::= { opticsIMRadioPmMCConf 1 }

opticsIMRadioPmMCConf         OBJECT IDENTIFIER ::= { opticsimRadioMC 5  }
opticsIMRadioPmMCCompl      OBJECT IDENTIFIER ::= { opticsIMRadioPmMCConf 1 }
opticsIMRadioPmMCGroup      OBJECT IDENTIFIER ::= { opticsIMRadioPmMCConf 2 }

opticsIRadioPmMc MODULE-COMPLIANCE
      STATUS current
      DESCRIPTION 
          "This module compliance describes a set of objects required for Optics-IM Agent 
            implementation. These objects are defined inside opticsIMRadioPmMib. "

      MODULE -- opticsIMRadioPmMib  


GROUP opticsIMRpsCriteriaMonitoringGroup
      DESCRIPTION
          " This group contains the RPS Criteria Monitoring objects."

GROUP opticsIMRpsPMGroup
      DESCRIPTION
          " This group contains the RPS Performance Monitoring objects. "

GROUP opticsIMRfcohPMGroup
      DESCRIPTION
          " This group contains the RFCOH Performance Monitoring objects. "

