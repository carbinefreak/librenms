pmRpsCriteriaCDRowStatus OBJECT-TYPE
       SYNTAX			RowStatus
       MAX-ACCESS	read-create
       STATUS			current
       DESCRIPTION
         "See Textual Conventions.
          When an entry of this table is deleted the corresponding entries of HD table are deleted.
          When an entry of this table is put to not in service, the measures of this CD are frozen, that is all 
          the counters are stopped."
::= { opticsIMRpsCriteriaCurrentDataEntry 12 }



opticsIMRpsCriteriaHistoryDataTable OBJECT-TYPE
       SYNTAX SEQUENCE OF	OpticsIMRpsCriteriaHistoryDataEntry
       MAX-ACCESS		not-accessible
       STATUS				current
       DESCRIPTION
            "This table contains the History Data for the Radio Protection Switching (RPS) Criteria 
              Monitoring. "
::= { opticsIMRadioPmMibObject 2 }

opticsIMRpsCriteriaHistoryDataEntry OBJECT-TYPE
       SYNTAX			OpticsIMRpsCriteriaHistoryDataEntry
       MAX-ACCESS	not-accessible
       STATUS			current
       DESCRIPTION
            "One entry of this table is created at the end of the time interval of the related CD (defined by 
             granularity Period).

             At most n entries of opticsIMRpsCriteriaHistoryDataTable can be created indexed by the indexes 
             of the corresponding CD entry and by the time of the measure 
             (pmRpsCriteriaHDPeriodEndTime). 
             This set of n entries is wrapped, when the n+1 measure is provided. The n+1 measure is written 
             in the row of the table indexed by the smallest value of pmRpsCriteriaHDPeriodEndTime. "
       INDEX   { ifIndex, pmRpsCriteriaCDIndex, pmRpsCriteriaHDPeriodEndTime }
::= { opticsIMRpsCriteriaHistoryDataTable 1 }

OpticsIMRpsCriteriaHistoryDataEntry ::= SEQUENCE {
   pmRpsCriteriaHDElapsedTime			OpticsIMPmElapsedTime,
   pmRpsCriteriaHDGranularityPeriod		OpticsIMPmGranularityPeriod, 
   pmRpsCriteriaHDNumSuppressedIntervals	OpticsIMPmNumSuppressedIntervals, 
   pmRpsCriteriaHDPeriodEndTime					OpticsIMPmPeriodTime,
   pmRpsCriteriaHDSuspectIntervalFlag			OpticsIMPmSuspectIntervalFlag,
   pmRpsCriteriaHDStartByOS		TsdimManagerType,
   pmRpsCriteriaHDEwsc				Gauge32,
   pmRpsCriteriaHDLbersc			Gauge32,
   pmRpsCriteriaHDHbersc			Gauge32,
   pmRpsCriteriaHDSfsc				Gauge32
   }

