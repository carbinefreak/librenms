opticsIMRfcohCurrentDataTable OBJECT-TYPE
       SYNTAX SEQUENCE OF OpticsIMRfcohCurrentDataEntry
       MAX-ACCESS not-accessible
       STATUS current
       DESCRIPTION
             "This table contains the current data for the RFCOH PM. "
::= { opticsIMRadioPmMibObject 5 }

opticsIMRfcohCurrentDataEntry OBJECT-TYPE
       SYNTAX OpticsIMRfcohCurrentDataEntry
       MAX-ACCESS not-accessible
       STATUS current
       DESCRIPTION
           "An entry of the RFCOH current data table. 

            An unavailable condition starts when 10 consecutive severely errored seconds have been 
            detected; these 10 seconds belong to the unavailable time. An unavailable condition 
            ends when 10 consecutive seconds with no severely errored second are detected. 
            These 10 seconds belong to the available time.   
            If an unavailable period is ending then the UAT Clear shall be sent.
            These performance event counts are inhibited during unavailable time.
            In the objects where a Default Value is specified, the write operation is allowed only to the 
            indicated default value.
            The write operation to one counter is applied to all the counters of all the associated objects, 
            which have a defined default."
       INDEX          {  ifIndex, pmRfcohCDIndex}
       ::= { opticsIMRfcohCurrentDataTable 1 }   

OpticsIMRfcohCurrentDataEntry ::= SEQUENCE {
   pmRfcohCDIndex                        OpticsIMPmIndex,
   pmRfcohCDElapsedTime            OpticsIMPmElapsedTime,
   pmRfcohCDGranularityPeriod             OpticsIMPmGranularityPeriod, 
   pmRfcohCDMaxSuppressedIntervals OpticsIMPmMaxSuppressedIntervals, 
   pmRfcohCDNumSuppressedIntervals OpticsIMPmNumSuppressedIntervals,
   pmRfcohCDSuspectIntervalFlag         OpticsIMPmSuspectIntervalFlag,
   pmRfcohCDThresholdDataInstance   OpticsIMPmThresholdDataInstance,
   pmRfcohCDStartByOS            TsdimManagerType,
   pmRfcohCDSes                      Gauge32,
   pmRfcohCDUas                      Gauge32,
   pmRfcohCDBbe                      Gauge32,
   pmRfcohCDEs                        Gauge32,
   pmRfcohCDOfs                      Gauge32,
   pmRfcohCDRowStatus          RowStatus,
   pmRfcohCDAsapIndex           Integer32
   }

pmRfcohCDIndex OBJECT-TYPE
       SYNTAX OpticsIMPmIndex
       MAX-ACCESS not-accessible
       STATUS current
       DESCRIPTION
           "See Textual Conventions."
::= { opticsIMRfcohCurrentDataEntry 1 }

