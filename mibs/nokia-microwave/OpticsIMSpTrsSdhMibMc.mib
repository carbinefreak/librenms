-- OPTICSIM-TRS-SDH-MC DEFINITIONS ::= BEGIN
--       IMPORTS
--       MODULE-IDENTITY, OBJECT-TYPE, OBJECT-IDENTITY FROM SNMPv2-SMI
--       MODULE-COMPLIANCE, NOTIFICATION-GROUP, OBJECT-GROUP FROM SNMPv2-CONF
--       opticsimSdhPdhMC FROM OPTICSIM-RADIOREG-MIB;


-- opticsIMTrsSdhMCCompl MODULE-IDENTITY
--       LAST-UPDATED "0201250000Z"
--       ORGANIZATION "Alcatel TND"
--       CONTACT-INFO "Alcatel TND"
--       DESCRIPTION 
--           "Initial Release of SDH Transmission Module Compliance."
    
-- ::= { opticsIMTrsSdhMCConf 1 }

opticsIMTrsSdhMCConf         OBJECT IDENTIFIER ::= { opticsimSdhPdhMC 1 }
opticsIMTrsSdhMCCompl      OBJECT IDENTIFIER ::= { opticsIMTrsSdhMCConf 1 }
opticsIMTrsSdhMCGroup      OBJECT IDENTIFIER ::= { opticsIMTrsSdhMCConf 2 }

opticsIMTrsSdhMc MODULE-COMPLIANCE
      STATUS current
      DESCRIPTION 
          "This module compliance describes a set of objects required for Optics-IM Agent 
            implementation. These objects are defined inside opticsIMTrsSdhMib. "

       MODULE -- opticsIMTrsSdhMib  

MANDATORY-GROUPS { opticsIMRsTTPGroup }

GROUP opticsIMElectricalSPITTPGroup
      DESCRIPTION
          " This group describes the objects related to the Electrical SPI. "

GROUP opticsIMOpticalSPITTPGroup
      DESCRIPTION
          " This group describes the objects related to the Optical SPI. "

GROUP opticsIMAlsHandlerGroup
      DESCRIPTION
          " This group describes the objects related to the ALS. "

GROUP opticsIMMsTTPGroup
      DESCRIPTION
          " This group describes the objects related to the Multiplex Section Termination. "

GROUP opticsIMVc4TTPGroup
      DESCRIPTION
          " This group describes the objects related to the VC-4 Termination. "


GROUP opticsIMVc3TTPGroup
      DESCRIPTION
          " This group describes the objects related to the VC-3 Termination. "

GROUP opticsIMAu4Group
      DESCRIPTION
          " This group describes the objects related to the AU-4 Termination. "

GROUP opticsIMTu3Group
      DESCRIPTION
          " This group describes the objects related to the TU-3 Termination. "

::= { opticsIMTrsSdhMCCompl 1 }


opticsIMElectricalSPITTPGroup OBJECT-GROUP
      OBJECTS { eSPITTPBidOperationalState,
                          eSPITTPBidAsapIndex
                          }
      STATUS current 
      DESCRIPTION 
          " This group describes the Electrical SPI objects." 
::= { opticsIMTrsSdhMCGroup 1 }

opticsIMOpticalSPITTPGroup OBJECT-GROUP
      OBJECTS { oSPITTPBidReach,
                          oSPITTPBidWavelenght,
                          oSPITTPBidOperationalState,
                          oSPITTPBidAsapIndex
                          }
      STATUS current 
      DESCRIPTION 
          " This group describes the Optical SPI objects." 
::= { opticsIMTrsSdhMCGroup 2 }

opticsIMAlsHandlerGroup OBJECT-GROUP
      OBJECTS { alsControl,
                          alsCurrentState,
                          alsAutoRestartEnabled,
                          alsManualRestartEnabled,
                          alsInvokeManualRestart,
                          alsInvokeTestRestart,
                          alsRowStatus
                          }
      STATUS current 
      DESCRIPTION 
          " This group describes the ALS objects." 
::= { opticsIMTrsSdhMCGroup 3 }

opticsIMRsTTPGroup OBJECT-GROUP
OBJECTS { rsTTPBidTIReceivedValue,
                    rsTTPBidTIExpectedMode, 
                    rsTTPBidTIExpectedValue,
                    rsTTPBidTISentMode,
                    rsTTPBidTISentValue,
                    rsTTPBidOperationalState,
                    rsTTPBidAsapIndex
                    }
      STATUS current 
      DESCRIPTION 
          " This group describes the RST objects." 
::= { opticsIMTrsSdhMCGroup 4 }

opticsIMMsTTPGroup OBJECT-GROUP
      OBJECTS { msTTPBidOperationalState,
                          msTTPBidAsapIndex
                          }
      STATUS current 
      DESCRIPTION 
          " This group describes the MST objects." 
::= { opticsIMTrsSdhMCGroup 5 }

opticsIMVc4TTPGroup OBJECT-GROUP
      OBJECTS { vc4TTPBidVcnMappingForFE,
                          vc4TTPBidEnableE1ForFE,
                          vc4TTPBidOperationalState,
                          vc4TTPBidAsapIndex
                          }
      STATUS current 
      DESCRIPTION 
          " This group describes the VC4 objects." 
::= { opticsIMTrsSdhMCGroup 6 }

opticsIMVc3TTPGroup OBJECT-GROUP
      OBJECTS { vc3TTPBidEnableE1ForFE,
                          vc3TTPBidOperationalState,
                          vc3TTPBidAsapIndex
                          }
      STATUS current 
      DESCRIPTION 
          " This group describes the VC3 objects." 
::= { opticsIMTrsSdhMCGroup 7 }

opticsIMAu4Group OBJECT-GROUP
      OBJECTS { vc3TTPBidEnableE1ForFE,
                          vc3TTPBidOperationalState,
                          vc3TTPBidAsapIndex
                          }
      STATUS current 
      DESCRIPTION 
          " This group describes the AU4 objects." 
::= { opticsIMTrsSdhMCGroup 8 }


opticsIMTu3Group OBJECT-GROUP
      OBJECTS { vc3TTPBidEnableE1ForFE,
                          vc3TTPBidOperationalState,
                          vc3TTPBidAsapIndex
                          }
      STATUS current 
      DESCRIPTION 
          " This group describes the TU3 objects." 
::= { opticsIMTrsSdhMCGroup 9 }


END

