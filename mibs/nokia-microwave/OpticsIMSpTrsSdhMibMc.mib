OpticsIMAu4Entry ::= SEQUENCE {
   au4OperationalState		TsdimOperationalState,
   au4AsapIndex				Integer32
   }

au4OperationalState OBJECT-TYPE
     SYNTAX					TsdimOperationalState 
     MAX-ACCESS			read-only
     STATUS					current
     DESCRIPTION
       " See Textual Conventions."
::= { opticsIMAu4Entry 1 }

au4AsapIndex OBJECT-TYPE
     SYNTAX					Integer32 
     MAX-ACCESS			read-write 
     STATUS					current
     DESCRIPTION
