            trails. "
::= { opticsIMTrsSdhMibObject 7 }

opticsIMVc3TTPBidEntry OBJECT-TYPE
     SYNTAX						OpticsIMVc3TTPBidEntry
     MAX-ACCESS				not-accessible
     STATUS						current
     DESCRIPTION
          " An entry of the vc3TTPBidTable. Each entry corresponds to a VC3 termination. "
     INDEX  { ifIndex }
::= { opticsIMVc3TTPBidTable 1 } 

OpticsIMVc3TTPBidEntry ::= SEQUENCE {
   vc3TTPBidEnableE1ForFE		TruthValue,
   vc3TTPBidOperationalState		TsdimOperationalState,
   vc3TTPBidAsapIndex				Integer32
   }

vc3TTPBidEnableE1ForFE OBJECT-TYPE
     SYNTAX					TruthValue
     MAX-ACCESS			read-write
     STATUS					current
     DESCRIPTION
         "When the vc3Mapping is selected (see vc4TTPBidTable), this object specifies if E1 signals, 
          mapped in the VC3, are enabled in applications with Fast Ethernet signals."
::= { opticsIMVc3TTPBidEntry 1 }

vc3TTPBidOperationalState OBJECT-TYPE
     SYNTAX					TsdimOperationalState 
     MAX-ACCESS			read-only
     STATUS					current
     DESCRIPTION
       " See Textual Conventions."
::= { opticsIMVc3TTPBidEntry 2 }

vc3TTPBidAsapIndex OBJECT-TYPE
     SYNTAX					Integer32 
     MAX-ACCESS			read-write 
     STATUS					current
     DESCRIPTION
       "This object defines the ASAP object associated to this entry."
::= { opticsIMVc3TTPBidEntry 3 }

opticsIMAu4Table OBJECT-TYPE
     SYNTAX SEQUENCE OF	OpticsIMAu4Entry
     MAX-ACCESS					not-accessible
     STATUS							current
     DESCRIPTION
          "This table contains the information related to the termination and to the origination of the au4 
            trails. "
::= { opticsIMTrsSdhMibObject 8 }

opticsIMAu4Entry OBJECT-TYPE
     SYNTAX						OpticsIMAu4Entry
     MAX-ACCESS				not-accessible
     STATUS						current
     DESCRIPTION
          " An entry of the au4Table. Each entry corresponds to a AU4 termination . "
