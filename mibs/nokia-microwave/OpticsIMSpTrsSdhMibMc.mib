::= { opticsIMTrsSdhMibObject 13 }

opticsIMTu12Entry OBJECT-TYPE
     SYNTAX						OpticsIMTu12Entry
     MAX-ACCESS				not-accessible
     STATUS						current
     DESCRIPTION
          " An entry of the tu12Table. Each entry corresponds to a Tu12 termination . "
     INDEX  { ifIndex }
::= { opticsIMTu12Table 1 }  

OpticsIMTu12Entry ::= SEQUENCE {
   tu12OperationalState		TsdimOperationalState,
   tu12AsapIndex				Integer32
   }

tu12OperationalState OBJECT-TYPE
     SYNTAX					TsdimOperationalState 
     MAX-ACCESS			read-only
     STATUS					current
     DESCRIPTION
       " See Textual Conventions."
::= { opticsIMTu12Entry 1 }

tu12AsapIndex OBJECT-TYPE
     SYNTAX					Integer32 
     MAX-ACCESS			read-write 
     STATUS					current
     DESCRIPTION
       "This object defines the ASAP object associated to this entry."
::= { opticsIMTu12Entry 2 }


-- VC12 table

opticsIMVc12Table OBJECT-TYPE
     SYNTAX SEQUENCE OF	OpticsIMVc12Entry
     MAX-ACCESS		not-accessible
     STATUS		current
     DESCRIPTION
          "This table contains the information related to the termination and to the origination of the VC12
            trails. "
::= { opticsIMTrsSdhMibObject 14 }

opticsIMVc12Entry OBJECT-TYPE
     SYNTAX		OpticsIMVc12Entry
     MAX-ACCESS		not-accessible
     STATUS						current
     DESCRIPTION
          " An entry of the vc12Table. Each entry corresponds to a Vc12 termination . "
     INDEX  { ifIndex }
::= { opticsIMVc12Table 1 }  

OpticsIMVc12Entry ::= SEQUENCE {
   vc12OperationalState		TsdimOperationalState,
   vc12AsapIndex				Integer32
   }

vc12OperationalState OBJECT-TYPE
     SYNTAX					TsdimOperationalState 
     MAX-ACCESS			read-only
     STATUS					current
     DESCRIPTION
       " See Textual Conventions."
::= { opticsIMVc12Entry 1 }

vc12AsapIndex OBJECT-TYPE
     SYNTAX					Integer32 
     MAX-ACCESS			read-write 
     STATUS					current
     DESCRIPTION
       "This object defines the ASAP object associated to this entry."
::= { opticsIMVc12Entry 2 }

--  Rs monitoring table

opticsIMRsMonitoringTable OBJECT-TYPE
     SYNTAX SEQUENCE OF	OpticsIMRsMonitoringEntry
     MAX-ACCESS					not-accessible
     STATUS							current
     DESCRIPTION
          " This table contains the information related to the RS monitoring(link trace monitoring) of the SDH Regenerator Section trails "
::= { opticsIMTrsSdhMibObject 10 }

opticsIMRsMonitoringEntry OBJECT-TYPE
     SYNTAX						OpticsIMRsMonitoringEntry
     MAX-ACCESS				not-accessible
     STATUS						current
     DESCRIPTION
          " An entry of the rsMonitoringTable. Each entry corresponds to a Regenerator Section Monitoring. "
     INDEX  { ifIndex }
::= { opticsIMRsMonitoringTable 1 }  

OpticsIMRsMonitoringEntry ::= SEQUENCE {
  rsMonitoringTIExpectedMode			OpticsIMTIExpectedMode, 
  rsMonitoringTIExpectedValue			OpticsIMTIExpectedValue,
  rsMonitoringAsapIndex 			Integer32
  }

rsMonitoringTIExpectedMode			OBJECT-TYPE
     SYNTAX					OpticsIMTIExpectedMode
     MAX-ACCESS			read-write 
     STATUS					current
     DESCRIPTION
        " See Textual Conventions. 
          The associated value is contained in rsMonitoringTIExpectedValue object."
::= { opticsIMRsMonitoringEntry 1 }

rsMonitoringTIExpectedValue			OBJECT-TYPE
     SYNTAX					OpticsIMTIExpectedValue
     MAX-ACCESS			read-write 
     STATUS					current
     DESCRIPTION
        " See Textual Conventions. "
::= { opticsIMRsMonitoringEntry 2 }

rsMonitoringAsapIndex 			OBJECT-TYPE
     SYNTAX					Integer32 
     MAX-ACCESS			read-write 
     STATUS					current
     DESCRIPTION
       "This object defines the ASAP object associated to this entry."
::= { opticsIMRsMonitoringEntry 3 }

--

opticsIMUnidirectionalMSProtectionGroupTable OBJECT-TYPE
  SYNTAX SEQUENCE OF OpticsIMUnidirectionalMSProtectionGroupEntry
  MAX-ACCESS         not-accessible
  STATUS             current
  DESCRIPTION
    "This table is used to manage all the protection schemes related to the Unidirectional MSP."
::= { opticsIMTrsSdhMibObject 11 }

opticsIMUnidirectionalMSProtectionGroupEntry OBJECT-TYPE
  SYNTAX         OpticsIMUnidirectionalMSProtectionGroupEntry
  MAX-ACCESS     not-accessible
  STATUS         current
  DESCRIPTION
   "An entry of the opticsIMUnidirectionalMSProtectionGroup table. 
    Each entry corresponds to an Unidirectional MSP protection scheme and allows to define all 
    the related common management functions.
    Each entry can be created as consequence of the equipment provisioning or directly by the managing systems.
   "
  INDEX   { opticsIMUnidirectionalMSProtectionGroupIndex }
::= { opticsIMUnidirectionalMSProtectionGroupTable 1 }

OpticsIMUnidirectionalMSProtectionGroupEntry ::= SEQUENCE {
  opticsIMUnidirectionalMSProtectionGroupIndex             Unsigned32,
  opticsIMUnidirectionalMSProtectionGroupType              OpticsIMProtectionGroupType,
  opticsIMUnidirectionalMSProtectionGroupRevertive         OpticsIMRevertive,
  opticsIMUnidirectionalMSProtectionGroupOperationalState  TsdimOperationalState,
  opticsIMUnidirectionalMSProtectionGroupRowStatus         RowStatus
}

opticsIMUnidirectionalMSProtectionGroupIndex OBJECT-TYPE
  SYNTAX      Unsigned32
  MAX-ACCESS  not-accessible
  STATUS      current
  DESCRIPTION
    "This object is the identifier of the opticsIMUnidirectionalMSProtectionGroupTable"
::= { opticsIMUnidirectionalMSProtectionGroupEntry 1 }

opticsIMUnidirectionalMSProtectionGroupType OBJECT-TYPE
  SYNTAX       OpticsIMProtectionGroupType
  MAX-ACCESS   read-only
  STATUS       current
  DESCRIPTION
    "See Textual Conventions."
::= { opticsIMUnidirectionalMSProtectionGroupEntry 2 }

opticsIMUnidirectionalMSProtectionGroupRevertive OBJECT-TYPE
  SYNTAX      OpticsIMRevertive
  MAX-ACCESS  read-create
  STATUS      current
  DESCRIPTION
    "See Textual Conventions."
::= { opticsIMUnidirectionalMSProtectionGroupEntry 3 }

opticsIMUnidirectionalMSProtectionGroupOperationalState OBJECT-TYPE
  SYNTAX       TsdimOperationalState 
  MAX-ACCESS   read-only
  STATUS       current
  DESCRIPTION
    "See Textual Conventions."
::= { opticsIMUnidirectionalMSProtectionGroupEntry 4 }

opticsIMUnidirectionalMSProtectionGroupRowStatus OBJECT-TYPE
  SYNTAX        RowStatus
  MAX-ACCESS    read-create
  STATUS        current
  DESCRIPTION
    "See Textual Conventions.
     When an entry of this table is deleted the corresponding entries of
     equipmentProtectionUnit table are deleted."
::= { opticsIMUnidirectionalMSProtectionGroupEntry 5 }



opticsIMUnidirectionalMSProtectionUnitTable OBJECT-TYPE
  SYNTAX SEQUENCE OF   OpticsIMUnidirectionalMSProtectionUnitEntry
  MAX-ACCESS                     not-accessible
  STATUS                               current
  DESCRIPTION
  " This table contains the Unidirectional MSP Unit associated to each Unidirectional MSP Protection Group."
::= { opticsIMTrsSdhMibObject 12 }

opticsIMUnidirectionalMSProtectionUnitEntry OBJECT-TYPE
  SYNTAX       OpticsIMUnidirectionalMSProtectionUnitEntry
  MAX-ACCESS   not-accessible
  STATUS       current
  DESCRIPTION
    "An entry in the opticsIMUnidirectionalMSProtectionUnit table. Entries of this table are 
     created when the associated UnidirectionalMSP Protection Group is created. "
  INDEX { opticsIMUnidirectionalMSProtectionGroupIndex,
          opticsIMUnidirectionalMSProtectionUnitIndex }
::= { opticsIMUnidirectionalMSProtectionUnitTable 1 }

OpticsIMUnidirectionalMSProtectionUnitEntry ::= SEQUENCE {
  opticsIMUnidirectionalMSProtectionUnitIndex          Integer32,
  opticsIMUnidirectionalMSProtectionUnitType           OpticsIMProtectionUnitType,
  opticsIMUnidirectionalMSProtectionUnitSwitchCommand  OpticsIMProtectionSwitchCommand,
  opticsIMUnidirectionalMSProtectionUnitSwitchCriteria
                                   		       INTEGER,
  opticsIMUnidirectionalMSProtectionUnitSwitchStatus   OpticsIMProtectionSwitchStatus,
  opticsIMUnidirectionalMSProtectionUnitPriority       OpticsIMProtectionPriority
}

opticsIMUnidirectionalMSProtectionUnitIndex OBJECT-TYPE
  SYNTAX       Integer32
  MAX-ACCESS   not-accessible
  STATUS       current
  DESCRIPTION
    "This object identifies the index of the protection unit for each equipment
     protection group."
::= { opticsIMUnidirectionalMSProtectionUnitEntry 1 }

opticsIMUnidirectionalMSProtectionUnitType           OBJECT-TYPE
  SYNTAX          OpticsIMProtectionUnitType
  MAX-ACCESS      read-only
  STATUS          current
  DESCRIPTION
    "See Textual Conventions."
::= { opticsIMUnidirectionalMSProtectionUnitEntry 2 }

opticsIMUnidirectionalMSProtectionUnitSwitchCommand  OBJECT-TYPE
  SYNTAX          OpticsIMProtectionSwitchCommand
  MAX-ACCESS      read-write
  STATUS          current
  DESCRIPTION
    "See Textual Conventions."
::= { opticsIMUnidirectionalMSProtectionUnitEntry 3 }

opticsIMUnidirectionalMSProtectionUnitSwitchCriteria  OBJECT-TYPE
  SYNTAX	INTEGER {
			noOne(0),
			equipmentFailure        (1), 
			lowBer   (2),
 			highBer   (3),
			signalFail   (4)
         		}
  MAX-ACCESS      read-only
  STATUS          current
  DESCRIPTION
    "This object contains the highest priority automatic switch request
     currently active on the channel. "
::= { opticsIMUnidirectionalMSProtectionUnitEntry 4 }

opticsIMUnidirectionalMSProtectionUnitSwitchStatus  OBJECT-TYPE
  SYNTAX        OpticsIMProtectionSwitchStatus
  MAX-ACCESS    read-only
  STATUS        current
  DESCRIPTION
    "See Textual Conventions."
::= { opticsIMUnidirectionalMSProtectionUnitEntry 5 }

opticsIMUnidirectionalMSProtectionUnitPriority OBJECT-TYPE
  SYNTAX          OpticsIMProtectionPriority
  MAX-ACCESS      read-write
  STATUS          current
  DESCRIPTION
" See Textual Conventions. "
::= { opticsIMUnidirectionalMSProtectionUnitEntry 6 }

