OPTICSIM-SYNCHRO-MIB DEFINITIONS ::= BEGIN
       IMPORTS
       MODULE-IDENTITY, OBJECT-TYPE, 
       Unsigned32, Integer32                                         FROM SNMPv2-SMI
       RowStatus, TruthValue,  TEXTUAL-CONVENTION                    FROM SNMPv2-TC
       InterfaceIndex, InterfaceIndexOrZero                          FROM IF-MIB
       MODULE-COMPLIANCE, OBJECT-GROUP                               FROM SNMPv2-CONF
       OpticsIMProtectionPriority, OpticsIMProtectionGroupType, 
       OpticsIMProtectionSwitchStatus,    
       OpticsIMProtectionSwitchCommand, OpticsIMRevertive            FROM OPTICSIM-COMMON-TC
       TsdimOperationalState                                         FROM TSDIM-SNMP-TC
       opticsimSdhPdhMib, opticsimSdhPdhMC   FROM OPTICSIM-RADIOREG-MIB;

opticsIMSynchroMib MODULE-IDENTITY
    LAST-UPDATED "202310050000Z"
    ORGANIZATION "Alcatel TND"
    CONTACT-INFO "Alcatel TND"
    DESCRIPTION
      "Synchronization MIB "

