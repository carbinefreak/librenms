OPTICSIM-COMMROU-MIB DEFINITIONS ::= BEGIN

IMPORTS
    MODULE-IDENTITY, OBJECT-TYPE, IpAddress, Integer32, Unsigned32 FROM SNMPv2-SMI
    DisplayString, TruthValue, RowStatus, MacAddress, TEXTUAL-CONVENTION FROM SNMPv2-TC
    InterfaceIndexOrZero, ifIndex, InterfaceIndex FROM IF-MIB
    TsdimUdpPort, TsdimNotificationId, TsdimEventTimeInt, 
    TsdimManagerType  FROM TSDIM-SNMP-TC
    MODULE-COMPLIANCE, OBJECT-GROUP FROM SNMPv2-CONF
    OpticsIMIpRoutingProtocol, OpticsIMPtpIpInterfaceType,
    OpticsIMPtpIpInterfaceMode FROM OPTICSIM-COMMON-TC
    tsdimBasicMib,tsdimBasicMC FROM TSDIM-BASICREG-MIB
   InetAddressIPv6 FROM TSDIM-SUPPORT-MIB
;

 opticsIMCommRouMib MODULE-IDENTITY
    LAST-UPDATED "202403010000Z"
    ORGANIZATION "Alcatel TND"
    CONTACT-INFO "Alcatel TND"
    DESCRIPTION
       "Optics-IM Communication and Routing MIB"

    REVISION "202403010000Z"
    DESCRIPTION
    	"- Updated some mistakes for wrong sequence definition on the followig table:
		-- opticsIMInfoPolledTable
		-- opticsIMMgrPollingInfoTable
		-- opticsIMOspfAreaTable
		-- opticsIMIpStaticRoutingInfoTable
		-- opticsIMIpRoutingInfoTable
		-- opticsIMLocalEthernetTable
		-- opticsIMPointToPointIPTable
		-- opticsIMIPTunnelTable
		-- opticsIMCLNPTunnelTable
		-- opticsIMOspfV3AreaTable
		-- opticsIMIPv6StaticRoutingInfoTable
		-- opticsIMIPv6RoutingInfoTable

    	"

    REVISION "202311220000Z"
    DESCRIPTION
    	"Added the attribute opticsIMIfDataManagementPlaneL3MacAddress to opticsIMIfDataManagementPlaneL3Table.
    	"

    REVISION "202107070000Z"
    DESCRIPTION
    	"Added the attribute opticsIMIfDataManagementPlaneL3InBandForwardingStatus to opticsIMIfDataManagementPlaneL3Table.
    	"

    REVISION "201802200000Z"
    DESCRIPTION
    	"Added 2 new attributes to opticsIMIfDataManagementPlaneL3Table:
          - opticsIMIfDataManagementPlaneL3DefGateway,
          - opticsIMIfDataManagementPlaneL3IPv6DefGateway
    	"
    
    REVISION "201511130000Z"
    DESCRIPTION
    	"- SNMPIDL-507, update LAST-UPDATED and REVISION date format adding the 2 digits missing (20) for yers after 1999.
    Added a REVISION block corresponding to the LAST-UPDATED timestamp.
      	 - SNMPIDL-508, added a space between opening and closing braces and the enclosed content.
    	"
    REVISION "201401060000Z"
    DESCRIPTION
       "- OPTnm25246: D.Spreafico.
             Added a new attribute, 		    	opticsIMPointToPointIPRemoteSysName to 	opticsIMPointToPointIPTable.

	"
    
    REVISION "201307060000Z"
    DESCRIPTION
       "- OPTnm20366: D.Spreafico.
             Added a new attribute, opticsIMIfDataManagementPlaneL3PCP, to opticsIMIfDataManagementPlaneL3Table.

        - D. Spreafico: for compilation problems removed a P on opticsIMOptPointToPointIPv6PGroup 
                           (to opticsIMOptPointToPointIPv6Group) .   		
	"
    
    REVISION "1206080000Z"
    DESCRIPTION
       "OPTnm10120: Daniela Spreafico.
 	        1. Following attribute is added in opticsIMMgrPollingInfoTable:
 		       	- opticsIMMgrPollingIPv6Address

    	 	2. Following attribute is added to opticsIMLocalEthernetTable:
       			- opticsIMLocalEthernetIPv6Address   		
   	 		- opticsIMLocalEthernetIPv6PrefixLength  	
   	 		- opticsIMLocalEthernetIPv6RoutingProtocol  	
   	 		- opticsIMLocalEthernetOspfv3AreaPointer

   		3. Following attribute is to opticsIMPointToPointIPTable:
 			- opticsIMPointToPointIPv6RemoteAddress 
  	  		- opticsIMPointToPointIPv6RoutingProtocol
   	 		- opticsIMPointToPointOspfv3AreaPointer

 	        4. Following tables are added:
  		      	- opticsIMOspfV3AreaTable
			- opticsIMIPv6StaticRoutingInfoTable
			- opticsIMIPv6RoutingInfoTable 

      		5. Following scalar objects are added:
			- opticsIMIpStackVersion
			- opticsIMOspfV3RouterId
     		   	- opticsIMIPv6StaticIndexNext    

 		6. Following attribute is added in opticsIMIfDataManagementPlaneL3Table:
    		    	- opticsIMIfDataManagementPlaneL3IPv6Address		
     			- opticsIMIfDataManagementPlaneL3IPv6PrefixLength	
     			- opticsIMIfDataManagementPlaneL3IPv6RoutingProtocol	
     			- opticsIMIfDataManagementPlaneL3Ospfv3AreaPointer

        OPTnm10404: Daniela Spreafico.
                Following attribute is added to opticsIMIfDataManagementPlaneL3Table:
        	- opticsIMIfDataManagementPlaneL3DSCP    		

	"
    
    REVISION "1201260000Z"
    DESCRIPTION
       "OPTnm04640: Daniela Spreafico.
        Following attribute is added in opticsIMPointToPointIPTable:
        - opticsIMPointToPointIPStatus
        - opticsIMPointToPointIPRemoteIfIndex
	"
    
    REVISION "1111030000Z"
    DESCRIPTION
       "TSDnm93501: Michael Qiu.
        Following attribute is added in OpticsIMIfDataManagementPlaneTable
        - opticsIMIfDataManagementPlaneEthernetPppStatus"
    
    REVISION "1101270000Z"
    DESCRIPTION
       " Following three attributes are added in OpticsIMIfDataManagementPlaneTable
       - opticsIMIfDataManagementPlaneMode
       - opticsIMIfDataManagementPlaneVLANId
       - opticsIMIfDataManagementPlaneTMPLSVLANId "
  
    REVISION "1008040000Z"
    DESCRIPTION
       "Extended the range for opticsIMPointToPointIPId from Integer32 (1..99) to Integer32 (1..999)    "

    REVISION "1005130000Z"
    DESCRIPTION
       "Added tables OpticsIMIfDataManagementPlaneL3Table and opticsIMIfDataManagementPlaneL3PortListTable"

    REVISION "0805290000Z"
    DESCRIPTION
       "Added scalar object opticsIMDHCPStatus"

    REVISION "0711290000Z"
    DESCRIPTION
       "Added opticsIMIfDataManagementPlanePppStatus to OpticsIMIfDataManagementPlaneEntry"

    REVISION "0701280000Z"
    DESCRIPTION
       "Added asapIndex to LocalEthernet table."
    REVISION "0612210000Z"
    DESCRIPTION
       "Added the neighbor NE Table for NE auto-discovery: opticsIMNeighborNeTable."
    REVISION "0602160000Z"
    DESCRIPTION
       "Added the CLNS management: opticsIMClnsStatus."
    REVISION "200506070000Z"
    DESCRIPTION
       "Ed. 10
        Addition of the following objects:
        - opticsIMIfDataManagementPlaneTable
       "        
    REVISION "0411300000Z"
    DESCRIPTION
       "Spreafico:
        in opticsIMOspfAreaTable the behaviour is changed to manage 
        backbone area: opticsIMOspfAreaID SINTAX change from 
        integer32 (1..999) to integer32 (0..999). 
        Conseguently: opticsIMLocalEthernetOspfAreaPointer (in 
        opticsIMLocalEthernetTable) and opticsIMPointToPointIPOspfAreaPointer
        (in opticsIMPointToPointIPTable) and opticsIMCLNPTunnelOspfAreaPointer 
        (in opticsIMCLNPTunnelTable) change from Integer32 (1..3) to
        Integer32 (0..999).
        In opticsIMLocalEthernetTable: opticsIMLocalEthernetId changes from 
        integer32 (1..3) to integer32 (1..999).
        In opticsIMStaticRoutingInfoTable: opticsIMIpStaticInterfaceIndex change 
        from integer32 (1..2147483647) to integer32 (0..2147483647)."
    REVISION "0406150000Z"
    DESCRIPTION
        "Hongtao Ren:
           Added the CLNP tunnel management: opticsIMCLNPTunnelTable.
         Gariani, Spreafico:
           Bug detection in opticsIMOspfAreaTable and 
           opticsIMPointToPointTable. The two indexes SINTAX, 
           respectively opticsIMOspfAreaId and opticsIMPointToPointId,
           is integer32 (1..3), while it changed as (1..999) and (1..99)."
    REVISION "0307250000Z"
    DESCRIPTION
        "Added the IP tunnel table and the ASAP object to the 
         opticsIMPointToPointIPTable."
    REVISION "0303140000Z"
    DESCRIPTION
        "Added the LAPD management and the IP remote address in the 
         point-to-point IP interfaces table. Renaming of 
         opticsIMLocalPtpIpInterfaceTable in opticsIMPointToPointIPTable"
    REVISION  "0211050000Z"
    DESCRIPTION
        "Changed the syntax of the OSPF Area pointer objects in 
         opticsIMLocalEthernet and opticsIMPointToPointIP tables and 
         the syntax of opticsIMIpRoutingProtocol object in 
         opticsIMIpRoutingInfoTable.
         NeRestartFlag object has been deprecated."
    REVISION  "0207240000Z"
    DESCRIPTION
        "Added new features to IP Routing functionality objects 
         (OSPF and interface objects"
    REVISION "200107180000Z"
    DESCRIPTION
        "The GenEvent notification and time have been added to 
         the polled table"
    REVISION "200104130000Z"
    DESCRIPTION
        "The event notification and time have been added to 
         the polled table"
    REVISION "0005090000Z"
    DESCRIPTION
        "Initial Release Optics-IM Communication and Routing MIB"
::= { tsdimBasicMib 6 }

-- OpticsIMNeighborConnectionType

OpticsIMNeighborConnectionType  ::= TEXTUAL-CONVENTION
	STATUS current
	DESCRIPTION
	" This object indicates the connection type of neighbor NE "
	SYNTAX INTEGER {
               direct   (1),
               pointToPoint     (2)
       }



opticsIMCommRouMibObject      OBJECT IDENTIFIER ::= { opticsIMCommRouMib 1 }


opticsIMIpStackVersion OBJECT-TYPE
 SYNTAX INTEGER { 
        ipv4 (1),
        ipv6 (2),
        dualStack (3) }
  MAX-ACCESS read-write
  STATUS current
  DESCRIPTION
    "This scalar object defines the current IP stack working on the NE. 
     if 'ipv4' is selected then the NE is able to receive, forward, route IP packets containing address in IPv4 format.
     if 'ipv6' is selected then the NE is able to receive, forward, route IP packets containing address in IPv6 format.
     if 'dualStack' is selected then the NE is able to receive , forward, route IP packets containing address whether in IPv4 or IPv6 format.
    "
::= { opticsIMCommRouMibObject 25 }

-- opticsIMInfoPolledTable 

opticsIMInfoPolledTable OBJECT-TYPE
    SYNTAX SEQUENCE OF OpticsIMInfoPolledEntry
    MAX-ACCESS not-accessible
    STATUS current
    DESCRIPTION 
        "This table contains the information that managing systems
         will read with polling messages."
::= { opticsIMCommRouMibObject 7 }

opticsIMInfoPolledEntry OBJECT-TYPE
    SYNTAX OpticsIMInfoPolledEntry
    MAX-ACCESS not-accessible
    STATUS current
    DESCRIPTION 
        "The row describes the information that managing systems
         will read with polling messages."
    INDEX { opticsIMInfoIndex }
::= { opticsIMInfoPolledTable 1 }

OpticsIMInfoPolledEntry ::= SEQUENCE {
    opticsIMInfoIndex                   Integer32,
    opticsIMInfoLastAlarmNotificationId TsdimNotificationId,
    opticsIMInfoLastAlarmTime           TsdimEventTimeInt, 
    opticsIMInfoNERestartFlag           TruthValue,
    opticsIMInfoLastEventNotificationId TsdimNotificationId,
    opticsIMInfoLastEventTime           TsdimEventTimeInt, 
    opticsIMInfoLastGenEventNotificationId TsdimNotificationId,
    opticsIMInfoLastGenEventTime           TsdimEventTimeInt 
    }

opticsIMInfoIndex OBJECT-TYPE 
    SYNTAX Integer32 
    MAX-ACCESS not-accessible
    STATUS current 
    DESCRIPTION  
        "This object defines the index of the table." 
::= { opticsIMInfoPolledEntry 1 } 

opticsIMInfoLastAlarmNotificationId OBJECT-TYPE 
    SYNTAX TsdimNotificationId 
    MAX-ACCESS read-only 
    STATUS current 
    DESCRIPTION   
        "This object contains the notification identifier of the last alarm
         stored inside AlarmLog." 
::= { opticsIMInfoPolledEntry 2 } 

opticsIMInfoLastAlarmTime OBJECT-TYPE 
    SYNTAX TsdimEventTimeInt 
    MAX-ACCESS read-only 
    STATUS current 
    DESCRIPTION 
        "This object contains the time of the last alarm stored  
         inside AlarmLog." 
::= { opticsIMInfoPolledEntry 3 } 

opticsIMInfoNERestartFlag OBJECT-TYPE 
    SYNTAX TruthValue 
    MAX-ACCESS read-write 
    STATUS deprecated 
    DESCRIPTION 
        "This is the NE restart attribute.
         It is set by NE at each restart, and reset by manager after
         having read it"
::= { opticsIMInfoPolledEntry 4 } 

opticsIMInfoLastEventNotificationId OBJECT-TYPE 
    SYNTAX TsdimNotificationId 
    MAX-ACCESS read-only 
    STATUS current 
    DESCRIPTION   
        "This object contains the notification identifier of the last Event
         stored inside EventLog." 
::= { opticsIMInfoPolledEntry 5 } 

opticsIMInfoLastEventTime OBJECT-TYPE 
    SYNTAX TsdimEventTimeInt 
    MAX-ACCESS read-only 
    STATUS current 
    DESCRIPTION 
        "This object contains the time of the last Event stored  
         inside EventLog." 
::= { opticsIMInfoPolledEntry 6 } 

opticsIMInfoLastGenEventNotificationId OBJECT-TYPE 
    SYNTAX TsdimNotificationId 
    MAX-ACCESS read-only 
    STATUS current 
    DESCRIPTION   
        "This object contains the notification identifier of the last Event
         stored inside GenEventLog." 
::= { opticsIMInfoPolledEntry 7 } 

opticsIMInfoLastGenEventTime OBJECT-TYPE 
    SYNTAX TsdimEventTimeInt 
    MAX-ACCESS read-only 
    STATUS current 
    DESCRIPTION 
        "This object contains the time of the last Event stored  
         inside GenEventLog." 
::= { opticsIMInfoPolledEntry 8 } 

-- opticsIMMgrPollingInfoTable 

opticsIMMgrPollingInfoTable OBJECT-TYPE
    SYNTAX SEQUENCE OF OpticsIMMgrPollingInfoEntry
    MAX-ACCESS not-accessible
    STATUS current
    DESCRIPTION 
        "This table contains the manager polling information. This polling
         mechanism is used in order to simulate a connection oriented 
         association between Manager and Agent."
::= { opticsIMCommRouMibObject 8 }

opticsIMMgrPollingInfoEntry OBJECT-TYPE
    SYNTAX OpticsIMMgrPollingInfoEntry
    MAX-ACCESS not-accessible
    STATUS current
    DESCRIPTION 
        "The row describes the manager configuration parameters for 
         Polling functionality"
    INDEX { opticsIMMgrPollingIndex }
::= { opticsIMMgrPollingInfoTable 1 }

OpticsIMMgrPollingInfoEntry ::= SEQUENCE {
    opticsIMMgrPollingIndex         Integer32,
    opticsIMMgrPollingIpAddress     IpAddress,
    opticsIMMgrPollingUdpPort       TsdimUdpPort,
    opticsIMMgrPollingTimeOut       Integer32,
    opticsIMMgrPollingManagerType   TsdimManagerType,
    opticsIMMgrPollingRowStatus     RowStatus,
    opticsIMMgrPollingIPv6Address   InetAddressIPv6
    }

opticsIMMgrPollingIndex OBJECT-TYPE 
    SYNTAX Integer32 
    MAX-ACCESS not-accessible
    STATUS current 
    DESCRIPTION  
        "This object defines the index of the table." 
::= { opticsIMMgrPollingInfoEntry 1 } 

opticsIMMgrPollingIpAddress OBJECT-TYPE  
    SYNTAX IpAddress 
    MAX-ACCESS read-create 
    STATUS current 
    DESCRIPTION  
        "This is the IP address information of the manager that support 
         the polling mechanism." 
::= { opticsIMMgrPollingInfoEntry 2 } 

opticsIMMgrPollingUdpPort OBJECT-TYPE  
    SYNTAX TsdimUdpPort 
    MAX-ACCESS read-create 
    STATUS current 
    DESCRIPTION  
        "See textual conventions." 
::= { opticsIMMgrPollingInfoEntry 3 } 

opticsIMMgrPollingTimeOut OBJECT-TYPE 
    SYNTAX Integer32 
    UNITS "seconds" 
    MAX-ACCESS read-create 
    STATUS current 
    DESCRIPTION  
        "This is the time-out value used by Manager during the  
         polling mechanism. It is used from the agent to calculate  
         the proper delay before declaring a manager unreachable" 
::= { opticsIMMgrPollingInfoEntry 4 } 

opticsIMMgrPollingManagerType OBJECT-TYPE  
    SYNTAX TsdimManagerType 
    MAX-ACCESS read-create 
    STATUS current 
    DESCRIPTION  
        "See textual conventions." 
::= { opticsIMMgrPollingInfoEntry 5 } 

opticsIMMgrPollingRowStatus OBJECT-TYPE
    SYNTAX RowStatus
    MAX-ACCESS read-create
    STATUS current
    DESCRIPTION 
        "This object is used to create / delete a row."
::= { opticsIMMgrPollingInfoEntry 6 }

opticsIMMgrPollingIPv6Address OBJECT-TYPE
    SYNTAX InetAddressIPv6
    MAX-ACCESS read-create
    STATUS current
    DESCRIPTION 
        "This is the IP address information of the manager that support 
         the polling mechanism in the IPv6 format." 
::= { opticsIMMgrPollingInfoEntry 7 }

-- opticsIMOspfAreaTable 

opticsIMOspfAreaTable OBJECT-TYPE
    SYNTAX SEQUENCE OF OpticsIMOspfAreaEntry
    MAX-ACCESS not-accessible
    STATUS current
    DESCRIPTION 
        "This table contains the Ospf Area routing information. 
         This information are used in order to manage the IP routing
         functionality."
::= { opticsIMCommRouMibObject 10 }

opticsIMOspfAreaEntry OBJECT-TYPE
    SYNTAX OpticsIMOspfAreaEntry
    MAX-ACCESS not-accessible
    STATUS current
    DESCRIPTION 
        "Each row describes the Ospf Area routing information.
         The row identified by AreaId 0 and IpAddress 0.0.0.0 is used for the
         Ospf backbone default value. This row is created by the agent and not        
         managed (deleted or modified) by management system."
    INDEX { opticsIMOspfAreaId }
::= { opticsIMOspfAreaTable 1 }

OpticsIMOspfAreaEntry ::= SEQUENCE {
    opticsIMOspfAreaId        Integer32,
    opticsIMOspfAreaIpAddress IpAddress,
    opticsIMOspfAreaIpMask    IpAddress,
    opticsIMOspfAreaStubFlag  TruthValue,  
        opticsIMOspfAreaRowStatus RowStatus
    }

opticsIMOspfAreaId OBJECT-TYPE
    SYNTAX Integer32 (0..999) 
    MAX-ACCESS not-accessible
    STATUS current
    DESCRIPTION 
        "This is the Ospf area identifier number. "
::= { opticsIMOspfAreaEntry 1 }

opticsIMOspfAreaIpAddress OBJECT-TYPE
    SYNTAX IpAddress
    MAX-ACCESS read-create
    STATUS current
    DESCRIPTION 
        "This is the Ospf area address."
::= { opticsIMOspfAreaEntry 2 }

opticsIMOspfAreaIpMask OBJECT-TYPE
    SYNTAX IpAddress
    MAX-ACCESS read-create
    STATUS current
    DESCRIPTION 
        "This is the Ospf area mask."
::= { opticsIMOspfAreaEntry 3 }

opticsIMOspfAreaStubFlag OBJECT-TYPE
    SYNTAX TruthValue
    MAX-ACCESS read-create
    STATUS current
    DESCRIPTION 
        "This is the Ospf stub flag."
::= { opticsIMOspfAreaEntry 4 }

opticsIMOspfAreaRowStatus OBJECT-TYPE
    SYNTAX RowStatus
    MAX-ACCESS read-create
    STATUS current
    DESCRIPTION 
        "This object is used to create / delete an OSPF area."
::= { opticsIMOspfAreaEntry 5 }

-- opticsIMIpStaticRoutingInfoTable 

opticsIMIpStaticRoutingInfoTable OBJECT-TYPE
    SYNTAX SEQUENCE OF OpticsIMIpStaticRoutingInfoEntry
    MAX-ACCESS not-accessible
    STATUS current
    DESCRIPTION 
        "This table contains the Ip static routing  information. 
         This information are used in order to manage the IP routing
         functionality"
::= { opticsIMCommRouMibObject 11 }

opticsIMIpStaticRoutingInfoEntry OBJECT-TYPE
    SYNTAX OpticsIMIpStaticRoutingInfoEntry
    MAX-ACCESS not-accessible
    STATUS current
    DESCRIPTION 
        "Each row describes the IP static routing information."
    INDEX { opticsIMIpStaticIpAddress }
::= { opticsIMIpStaticRoutingInfoTable 1 }

OpticsIMIpStaticRoutingInfoEntry ::= SEQUENCE {
    opticsIMIpStaticIpAddress   IpAddress,
    opticsIMIpStaticIpMask      IpAddress,
    opticsIMIpStaticDefGateway  IpAddress,
    opticsIMIpStaticInterfaceIndex InterfaceIndexOrZero,
    opticsIMIpStaticRowStatus   RowStatus
    }

opticsIMIpStaticIpAddress OBJECT-TYPE
    SYNTAX IpAddress
    MAX-ACCESS not-accessible
    STATUS current
    DESCRIPTION 
        "The host or network IpAddress."
::= { opticsIMIpStaticRoutingInfoEntry 1 }

opticsIMIpStaticIpMask OBJECT-TYPE
    SYNTAX IpAddress
    MAX-ACCESS read-create
    STATUS current
    DESCRIPTION 
        "This object defines the  mask associated to the 
         network IP address."
::= { opticsIMIpStaticRoutingInfoEntry 2 }

opticsIMIpStaticDefGateway OBJECT-TYPE
    SYNTAX IpAddress
    MAX-ACCESS read-create
    STATUS current
    DESCRIPTION 
        "The ip address of the default gateway."
::= { opticsIMIpStaticRoutingInfoEntry 3 }

opticsIMIpStaticInterfaceIndex OBJECT-TYPE
    SYNTAX InterfaceIndexOrZero
    MAX-ACCESS read-create
    STATUS current
    DESCRIPTION 
        "This object identifies the entry inside the ifTable 
         which describes the AAL interface."
::= { opticsIMIpStaticRoutingInfoEntry 4 }

opticsIMIpStaticRowStatus OBJECT-TYPE
    SYNTAX RowStatus
    MAX-ACCESS read-create
    STATUS current
    DESCRIPTION 
        "This object is used to create / delete a row."
::= { opticsIMIpStaticRoutingInfoEntry 5 }

-- opticsIMIpRoutingInfoTable 

opticsIMIpRoutingInfoTable OBJECT-TYPE
    SYNTAX SEQUENCE OF OpticsIMIpRoutingInfoEntry
    MAX-ACCESS not-accessible
    STATUS current
    DESCRIPTION 
        "This table contains the Ip routing  information. 
         This information can be retrieve by managers for maintenance 
         purposes. 
         The agent can fill in this table only as a consequence of a 
         GET-Request from a manager"
::= { opticsIMCommRouMibObject 12 }

opticsIMIpRoutingInfoEntry OBJECT-TYPE
    SYNTAX OpticsIMIpRoutingInfoEntry
    MAX-ACCESS not-accessible
    STATUS current
    DESCRIPTION 
        "Each row describes the IP  routing information."
    INDEX { opticsIMIpRoutingDestIpAddress }
::= { opticsIMIpRoutingInfoTable 1 }

OpticsIMIpRoutingInfoEntry ::= SEQUENCE {
    opticsIMIpRoutingDestIpAddress   IpAddress,
    opticsIMIpRoutingDestIpMask      IpAddress,
    opticsIMIpRoutingDefGateway  IpAddress,
    opticsIMIpRoutingMetricValue Integer32,
    opticsIMIpRoutingRouteAge    Integer32,
    opticsIMIpRoutingRouteType   INTEGER,
    opticsIMIpRoutingProtocol    OpticsIMIpRoutingProtocol,
    opticsIMIpRoutingLocalPtpInterface    Integer32
    }

opticsIMIpRoutingDestIpAddress OBJECT-TYPE
    SYNTAX IpAddress
    MAX-ACCESS not-accessible
    STATUS current
    DESCRIPTION 
        "This object describes the host or network IpAddress."
::= { opticsIMIpRoutingInfoEntry 1 }

opticsIMIpRoutingDestIpMask OBJECT-TYPE
    SYNTAX IpAddress
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION 
        "The mask related to the network IP address."
::= { opticsIMIpRoutingInfoEntry 2 }

opticsIMIpRoutingDefGateway OBJECT-TYPE
    SYNTAX IpAddress
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION 
        "The ip address of the default gateway."
::= { opticsIMIpRoutingInfoEntry 3 }

opticsIMIpRoutingMetricValue OBJECT-TYPE
    SYNTAX Integer32
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION 
        "This object represents the metric information ."
::= { opticsIMIpRoutingInfoEntry 4 }

opticsIMIpRoutingRouteAge OBJECT-TYPE
    SYNTAX Integer32
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION 
        "This object represents the route age information ."
::= { opticsIMIpRoutingInfoEntry 5 }

opticsIMIpRoutingRouteType OBJECT-TYPE
    SYNTAX INTEGER {
        indirect ( 1 ),
        direct   ( 2 ) }
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION 
        "This object represents the route type information ."
::= { opticsIMIpRoutingInfoEntry 6 }

opticsIMIpRoutingProtocol OBJECT-TYPE
    SYNTAX OpticsIMIpRoutingProtocol
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION 
        "This object represents the routing protocol information ."
::= { opticsIMIpRoutingInfoEntry 7 }

opticsIMIpRoutingLocalPtpInterface OBJECT-TYPE
    SYNTAX Integer32
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION 
        "This object represents the routing point to point interface ."
::= { opticsIMIpRoutingInfoEntry 8 }

-- opticsIMLocalEthernetTable 

opticsIMLocalEthernetTable OBJECT-TYPE
    SYNTAX SEQUENCE OF OpticsIMLocalEthernetEntry
    MAX-ACCESS not-accessible
    STATUS current
    DESCRIPTION 
      "This table contains the information needed to manage NEs which
       provide LAN ethernet interfaces."
::= { opticsIMCommRouMibObject 13 }

opticsIMLocalEthernetEntry OBJECT-TYPE
    SYNTAX OpticsIMLocalEthernetEntry
    MAX-ACCESS not-accessible
    STATUS current
    DESCRIPTION 
        "Each row describes the ethernet interface information."
    INDEX { opticsIMLocalEthernetId }
::= { opticsIMLocalEthernetTable 1 }


OpticsIMLocalEthernetEntry ::= SEQUENCE {
    opticsIMLocalEthernetId   Integer32,

    opticsIMLocalEthernetMacAddress    MacAddress,

    opticsIMLocalEthernetIpAddress 		IpAddress,
    opticsIMLocalEthernetIpMask  		IpAddress,
    opticsIMLocalEthernetIpRoutingProtocol  	OpticsIMIpRoutingProtocol,
    opticsIMLocalEthernetOspfAreaPointer  	Integer32,
    opticsIMLocalEthernetRowStatus   		RowStatus,
    opticsIMLocalEthernetAsapIndex   		Integer32,
    opticsIMLocalEthernetIPv6Address   		InetAddressIPv6,
    opticsIMLocalEthernetIPv6PrefixLength  	Unsigned32,
    opticsIMLocalEthernetIPv6RoutingProtocol  	OpticsIMIpRoutingProtocol,
    opticsIMLocalEthernetOspfv3AreaPointer  	Integer32

    }

opticsIMLocalEthernetId OBJECT-TYPE
    SYNTAX Integer32 (1..999) 
    MAX-ACCESS not-accessible
    STATUS current
    DESCRIPTION 
        "This is the local ethernet interface identifier number. "
::= { opticsIMLocalEthernetEntry 1 }

opticsIMLocalEthernetMacAddress OBJECT-TYPE
    SYNTAX MacAddress
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION 
        "This is the MAC address of the local ethernet interface."
::= { opticsIMLocalEthernetEntry 2 }

opticsIMLocalEthernetIpAddress OBJECT-TYPE
    SYNTAX IpAddress
    MAX-ACCESS read-create
    STATUS current
    DESCRIPTION 
        "This is the local ethernet interface address."
::= { opticsIMLocalEthernetEntry 3 }

opticsIMLocalEthernetIpMask OBJECT-TYPE
    SYNTAX IpAddress
    MAX-ACCESS read-create
    STATUS current
    DESCRIPTION 
        "This is the local ethernet interface mask."
::= { opticsIMLocalEthernetEntry 4 }

opticsIMLocalEthernetIpRoutingProtocol OBJECT-TYPE
    SYNTAX  OpticsIMIpRoutingProtocol 
    MAX-ACCESS read-create
    STATUS current
    DESCRIPTION 
        "This object represents the routing protocol information."
