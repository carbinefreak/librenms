OpticsIMCLNPTunnelEntry ::= SEQUENCE {
    opticsIMCLNPTunnelId   Integer32,
    opticsIMCLNPTunnelIPRoutingProtocol  OpticsIMIpRoutingProtocol,
    opticsIMCLNPTunnelOspfAreaPointer  Integer32,
    opticsIMCLNPTunnelRemoteNsapAddress DisplayString, 
    opticsIMCLNPTunnelRowStatus   RowStatus,
    opticsIMCLNPTunnelAsapIndex   Integer32
    }

opticsIMCLNPTunnelId OBJECT-TYPE
    SYNTAX Integer32 (1..3) 
    MAX-ACCESS not-accessible
    STATUS current
    DESCRIPTION 
        "This is the CLNP tunnel identifier number. "
::= { opticsIMCLNPTunnelEntry 1 }

opticsIMCLNPTunnelIPRoutingProtocol OBJECT-TYPE
    SYNTAX  OpticsIMIpRoutingProtocol 
    MAX-ACCESS read-create
    STATUS current
    DESCRIPTION 
        "This object represents the IP routing protocol information."
::= { opticsIMCLNPTunnelEntry 2 }

opticsIMCLNPTunnelOspfAreaPointer OBJECT-TYPE
    SYNTAX Integer32 (0..999)
    MAX-ACCESS read-create
    STATUS current
    DESCRIPTION 
        "This is the pointer to the associated OSPF area."
::= { opticsIMCLNPTunnelEntry 3 }

opticsIMCLNPTunnelRemoteNsapAddress OBJECT-TYPE
    SYNTAX DisplayString
    MAX-ACCESS read-create
    STATUS current
    DESCRIPTION 
        "This is the NSAP address of the remote point of CLNP tunnel."
