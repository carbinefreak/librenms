-- opticsIMPointToPointIPTable 

opticsIMPointToPointIPTable OBJECT-TYPE
    SYNTAX SEQUENCE OF OpticsIMPointToPointIPEntry
    MAX-ACCESS not-accessible
    STATUS current
    DESCRIPTION 
      "This table contains IP point-to-point addressing information."
::= { opticsIMCommRouMibObject 14 }

opticsIMPointToPointIPEntry OBJECT-TYPE
    SYNTAX OpticsIMPointToPointIPEntry
    MAX-ACCESS not-accessible
    STATUS current
    DESCRIPTION 
        "Each row describes the IP point-to-point interface information."
    INDEX { opticsIMPointToPointIPId }
::= { opticsIMPointToPointIPTable 1 }


OpticsIMPointToPointIPEntry ::= SEQUENCE {
    opticsIMPointToPointIPId   Integer32,

    opticsIMPointToPointIPType  OpticsIMPtpIpInterfaceType,

    opticsIMPointToPointIPMode  OpticsIMPtpIpInterfaceMode,

    opticsIMPointToPointIPRoutingProtocol    OpticsIMIpRoutingProtocol,
    opticsIMPointToPointIPOspfAreaPointer    Integer32,
    opticsIMPointToPointIPRemoteAddress      IpAddress, 
    opticsIMPointToPointIPRowStatus          RowStatus,
    opticsIMPointToPointIPAsapIndex          Integer32,
    opticsIMPointToPointIPStatus   	     INTEGER,
    opticsIMPointToPointIPRemoteIfIndex      InterfaceIndex,
    opticsIMPointToPointIPv6RemoteAddress    InetAddressIPv6,
    opticsIMPointToPointIPv6RoutingProtocol  OpticsIMIpRoutingProtocol,
    opticsIMPointToPointOspfv3AreaPointer    Integer32,
-- begin OPTnmxxxx
    opticsIMPointToPointIPRemoteSysName   DisplayString
-- end OPTnmxxxx

    }

opticsIMPointToPointIPId OBJECT-TYPE
    SYNTAX Integer32 (1..999) 
    MAX-ACCESS not-accessible
    STATUS current
    DESCRIPTION 
        "This is the IP point-to-point interface identifier number. "
::= { opticsIMPointToPointIPEntry 1 }

opticsIMPointToPointIPType OBJECT-TYPE
    SYNTAX OpticsIMPtpIpInterfaceType
    MAX-ACCESS read-create
    STATUS current
    DESCRIPTION 
        "This object defines the IP point-to-point port type."
::= { opticsIMPointToPointIPEntry 2 }

opticsIMPointToPointIPMode OBJECT-TYPE
    SYNTAX OpticsIMPtpIpInterfaceMode
    MAX-ACCESS read-create
    STATUS current
    DESCRIPTION 
        "This object defines the mode of working of the IP point-to-point
         interface."
::= { opticsIMPointToPointIPEntry 3 }

opticsIMPointToPointIPRoutingProtocol OBJECT-TYPE
    SYNTAX  OpticsIMIpRoutingProtocol 
    MAX-ACCESS read-create
    STATUS current
    DESCRIPTION 
        "This object represents the routing protocol information."
::= { opticsIMPointToPointIPEntry 4 }

opticsIMPointToPointIPOspfAreaPointer OBJECT-TYPE
    SYNTAX Integer32 (0..999)
    MAX-ACCESS read-create
    STATUS current
    DESCRIPTION 
        "This is the pointer to the associated OSPF area."
::= { opticsIMPointToPointIPEntry 5 }

opticsIMPointToPointIPRemoteAddress OBJECT-TYPE
    SYNTAX IpAddress
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION 
        "This is the IP address of the remote interface."
::= { opticsIMPointToPointIPEntry 6 }

opticsIMPointToPointIPRowStatus OBJECT-TYPE
    SYNTAX RowStatus
    MAX-ACCESS read-create
    STATUS current
    DESCRIPTION 
       "This object is used to create / delete an IP point-to-point
        interface."

::= { opticsIMPointToPointIPEntry 7 }

opticsIMPointToPointIPAsapIndex OBJECT-TYPE
    SYNTAX Integer32
    MAX-ACCESS read-create
    STATUS current
    DESCRIPTION 
       "This object defines the ASAP object associated to this point-to-
        point interface."

::= { opticsIMPointToPointIPEntry 8 }

opticsIMPointToPointIPStatus   OBJECT-TYPE
    SYNTAX INTEGER {
         enabled    (1),
         disabled   (2)
     }
    MAX-ACCESS read-create
    STATUS current
    DESCRIPTION 
       "This object allow the managing system to enable or disable the point-to-
        point on this interface ."

::= { opticsIMPointToPointIPEntry 9 }

opticsIMPointToPointIPRemoteIfIndex    OBJECT-TYPE
    SYNTAX InterfaceIndex
    MAX-ACCESS read-create
    STATUS current
    DESCRIPTION 
       "This is the IfIndex of the remote interface"

::= { opticsIMPointToPointIPEntry 10 }

opticsIMPointToPointIPv6RemoteAddress    OBJECT-TYPE
    SYNTAX InetAddressIPv6
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION 
        "This is the IP address of the remote interface in the IPv6 format."
::= { opticsIMPointToPointIPEntry 11 }

opticsIMPointToPointIPv6RoutingProtocol  OBJECT-TYPE
    SYNTAX  OpticsIMIpRoutingProtocol 
    MAX-ACCESS read-create
    STATUS current
    DESCRIPTION 
        "This object represents the routing protocol information when the IPv6 addressing is used."
::= { opticsIMPointToPointIPEntry 12 }

opticsIMPointToPointOspfv3AreaPointer  OBJECT-TYPE
    SYNTAX Integer32 (0..999)
    MAX-ACCESS read-create
    STATUS current
    DESCRIPTION 
        "This is the pointer to the associated OSPF area when the IPv6 addressing is used."
::= { opticsIMPointToPointIPEntry 13 }

-- begin OPTnm25246
opticsIMPointToPointIPRemoteSysName   OBJECT-TYPE
    SYNTAX DisplayString
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION 
        "This is the sysName of the remote interface."
::= { opticsIMPointToPointIPEntry 14 }
-- end OPTnm25246

-- opticsIMLAPDTable 

opticsIMLAPDTable OBJECT-TYPE
    SYNTAX SEQUENCE OF OpticsIMLAPDEntry
    MAX-ACCESS not-accessible
    STATUS current
    DESCRIPTION
       "This table contains the information useful to manage the LAPD 
        ports."
::= { opticsIMCommRouMibObject 15 }

opticsIMLAPDEntry OBJECT-TYPE
    SYNTAX OpticsIMLAPDEntry
    MAX-ACCESS not-accessible
    STATUS current
    DESCRIPTION
       "An entry of the LAPD ports table. "
    INDEX { ifIndex }
::= { opticsIMLAPDTable 1 } 

OpticsIMLAPDEntry ::= SEQUENCE {
   opticsIMLAPDPhysicalLayer INTEGER,
   opticsIMLAPDStatus INTEGER,
   opticsIMLAPDRole INTEGER
   }

opticsIMLAPDPhysicalLayer OBJECT-TYPE
    SYNTAX INTEGER {
       rs  (1),
       rfcoh  (2)
       }
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION
       " This object provides the LAPD physical layer."
::= { opticsIMLAPDEntry 1 }

opticsIMLAPDStatus OBJECT-TYPE
    SYNTAX INTEGER {
       enabled  (1),
       disabled (2)
       }
    MAX-ACCESS read-write
    STATUS current
    DESCRIPTION
       " This object provides the status of the LAPD port (enabled or 
         disabled)."
::= { opticsIMLAPDEntry 2 }

opticsIMLAPDRole OBJECT-TYPE
    SYNTAX INTEGER {
       user (1),
       network (2)
       }
    MAX-ACCESS read-write
    STATUS current
    DESCRIPTION
       " This object provides the role of the LAPD port (user or network)."
::= { opticsIMLAPDEntry 3 }

-- opticsIMIPTunnelTable 

opticsIMIPTunnelTable OBJECT-TYPE
    SYNTAX SEQUENCE OF OpticsIMIPTunnelEntry
    MAX-ACCESS not-accessible
    STATUS current
    DESCRIPTION 
      "This table contains the information needed to manage the IP tunnel."
