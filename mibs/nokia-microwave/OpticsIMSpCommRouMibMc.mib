opticsIMLocalEthernetRowStatus OBJECT-TYPE
    SYNTAX RowStatus
    MAX-ACCESS read-create
    STATUS current
    DESCRIPTION 
       "This object is used to create / delete a local ethernet interface."
::= { opticsIMLocalEthernetEntry 7 }

opticsIMLocalEthernetAsapIndex OBJECT-TYPE
    SYNTAX Integer32
    MAX-ACCESS read-create
    STATUS current
    DESCRIPTION 
       "This object defines the ASAP object associated to this local ethernet interface."
::= { opticsIMLocalEthernetEntry 8 }

opticsIMLocalEthernetIPv6Address   OBJECT-TYPE
    SYNTAX InetAddressIPv6
    MAX-ACCESS read-create
    STATUS current
    DESCRIPTION 
        "This is the local ethernet interface address in the IPv6 format."
::= { opticsIMLocalEthernetEntry 9 }

opticsIMLocalEthernetIPv6PrefixLength  OBJECT-TYPE
    SYNTAX Unsigned32 (0..128)
    MAX-ACCESS read-create
    STATUS current
    DESCRIPTION 
       "This is the length of local ethernet interface prefix when the IPv6 addressing is used."
::= { opticsIMLocalEthernetEntry 10 }

opticsIMLocalEthernetIPv6RoutingProtocol  OBJECT-TYPE
    SYNTAX OpticsIMIpRoutingProtocol
    MAX-ACCESS read-create
    STATUS current
    DESCRIPTION 
        "This object represents the routing protocol information when the IPv6 addressing is used."
::= { opticsIMLocalEthernetEntry 11 }

opticsIMLocalEthernetOspfv3AreaPointer  OBJECT-TYPE
    SYNTAX Integer32
    MAX-ACCESS read-create
