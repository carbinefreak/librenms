OpticsIMIPTunnelEntry ::= SEQUENCE {
    opticsIMIPTunnelId   Integer32,

    opticsIMIPTunnelIPAddress   IpAddress,
    opticsIMIPTunnelRowStatus   RowStatus

    }

opticsIMIPTunnelId OBJECT-TYPE
    SYNTAX Integer32 
    MAX-ACCESS not-accessible
    STATUS current
    DESCRIPTION 
        "This is the IP tunnel index. "
