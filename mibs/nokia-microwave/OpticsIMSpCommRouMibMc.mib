opticsIMCLNPTunnelRowStatus OBJECT-TYPE
    SYNTAX RowStatus
    MAX-ACCESS read-create
    STATUS current
    DESCRIPTION 
       "This object is used to create / delete an IP over CLNP tunnel."
::= { opticsIMCLNPTunnelEntry 5 }

opticsIMCLNPTunnelAsapIndex OBJECT-TYPE
    SYNTAX Integer32
    MAX-ACCESS read-create
    STATUS current
    DESCRIPTION 
       "This object defines the ASAP object associated to the CLNP tunnel."

::= { opticsIMCLNPTunnelEntry 6 }

-- opticsIMIfDataManagementPlaneTable

opticsIMIfDataManagementPlaneTable OBJECT-TYPE
    SYNTAX SEQUENCE OF OpticsIMIfDataManagementPlaneEntry
    MAX-ACCESS not-accessible
    STATUS current
    DESCRIPTION 
        "This table contains the configuration of management plane carried by data interfaced (In Fiber/In Band), in fact it references the IfTable."
::= { opticsIMCommRouMibObject 19 }

opticsIMIfDataManagementPlaneEntry OBJECT-TYPE
    SYNTAX OpticsIMIfDataManagementPlaneEntry
    MAX-ACCESS not-accessible
    STATUS current
    DESCRIPTION 
		"This is the configured management plane In-Fiber In-Band interface."
    INDEX { ifIndex }
::= { opticsIMIfDataManagementPlaneTable 1 }

OpticsIMIfDataManagementPlaneEntry ::= SEQUENCE {
    opticsIMIfDataManagementPlaneId       Integer32,
    opticsIMIfDataManagementPlaneLabel    Integer32,
    opticsIMIfDataManagementPlaneIpRoutingProtocol OpticsIMIpRoutingProtocol,
    opticsIMIfDataManagementPlaneOspfAreaPointer   Integer32,
    opticsIMIfDataManagementPlaneRowStatus   RowStatus,
--- CRB Oct2007 Begin
    opticsIMIfDataManagementPlanePppStatus       INTEGER,
--- CRB Oct2007 End
--- CRB Jan2011 Begin
    opticsIMIfDataManagementPlaneMode       INTEGER,
    opticsIMIfDataManagementPlaneVLANId     Integer32,
    opticsIMIfDataManagementPlaneTMPLSVLANId  Integer32,
--- CRB Jan2011 End

--- CRB Oct2011 Begin
    opticsIMIfDataManagementPlaneEthernetPppStatus   INTEGER
--- CRB Oct2011 End
}

opticsIMIfDataManagementPlaneId OBJECT-TYPE
    SYNTAX Integer32
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION 
        "This is the identifier of the un-numbered interface."
::= { opticsIMIfDataManagementPlaneEntry 1 }

opticsIMIfDataManagementPlaneLabel OBJECT-TYPE
    SYNTAX Integer32
    MAX-ACCESS read-create
    STATUS current
    DESCRIPTION 
		"This is the label which tags the management plane packets,
		 discriminating them from the data plane ones.
		 In case of Ethernet interface the label is the VLAN
		 and the default value is 4094."
::= { opticsIMIfDataManagementPlaneEntry 2 }

opticsIMIfDataManagementPlaneIpRoutingProtocol OBJECT-TYPE
    SYNTAX OpticsIMIpRoutingProtocol
    MAX-ACCESS read-create
    STATUS current
    DESCRIPTION 
		"This specifies the routing protocol used for the Management Plane packets."
::= { opticsIMIfDataManagementPlaneEntry 3 }

opticsIMIfDataManagementPlaneOspfAreaPointer OBJECT-TYPE
    SYNTAX Integer32
    MAX-ACCESS read-create
    STATUS current
    DESCRIPTION 
		"This is the pointer to the associated Ospf Area."
::= { opticsIMIfDataManagementPlaneEntry 4 }

opticsIMIfDataManagementPlaneRowStatus OBJECT-TYPE
    SYNTAX RowStatus
    MAX-ACCESS read-create
    STATUS current
    DESCRIPTION 
		"This is object is used to create/delete an
		 In-Fiber/In-Band Management Plane interface.
		 The creation is dependent to the presence of
		 the corresponding data interface identified by IfIndex."
::= { opticsIMIfDataManagementPlaneEntry 5 }

--- CRB Oct2007 Begin

opticsIMIfDataManagementPlanePppStatus OBJECT-TYPE
    SYNTAX INTEGER {
       enabled  (1),
       disabled (2)
       }
    MAX-ACCESS read-create
    STATUS current
    DESCRIPTION 
      "This scalar object specify the PPP work status (enabled or 
         disabled). default value is enabled"
::= { opticsIMIfDataManagementPlaneEntry  6 }

--- CRB Oct2007 End
                   
--- CRB Jan2011 Begin                   
opticsIMIfDataManagementPlaneMode OBJECT-TYPE
    SYNTAX INTEGER {
       singleDCNStack  (0),
       doubleDCNStack (1)
       }
    MAX-ACCESS read-create
    STATUS current
    DESCRIPTION 
		"This is the DCN stack mode configuration.
		 SingleDCNStack (0) -- default value, [in order to manage currently 
		 mutually exclusive options: either VLAN or MPLS label]
		 DoubleDCNStack (1) --in this case both VLAN and MPLS label can be used. "
::= { opticsIMIfDataManagementPlaneEntry 7 }

opticsIMIfDataManagementPlaneVLANId OBJECT-TYPE
    SYNTAX Integer32
    MAX-ACCESS read-create
    STATUS current
    DESCRIPTION 
		"This is the VLAN ID which tags the management plane packets,
		 discriminating them from the data plane ones if opticsIMIfDataManagementPlaneMode 
		 is configured as 'DoubleDCNStack'.
		 In case of Ethernet interface the label is the VLAN and the default value is 4094"
::= { opticsIMIfDataManagementPlaneEntry 8 }

opticsIMIfDataManagementPlaneTMPLSVLANId OBJECT-TYPE
    SYNTAX Integer32
    MAX-ACCESS read-create
    STATUS current
    DESCRIPTION 
		"This is used if opticsIMIfDataManagementPlaneMode is configured as DoubleDCNStack (1), 
		It is used to specify the VLAN ID which is used by TMPLS in-fiber in-band packets 
		which are requested to be transported over Ethernet (the VLAN ID before tunnel label)"
::= { opticsIMIfDataManagementPlaneEntry 9 }     
--- CRB Jan2011 End 

--- CRB Oct2011 Begin 
opticsIMIfDataManagementPlaneEthernetPppStatus OBJECT-TYPE
    SYNTAX INTEGER {
       enabled  (1),
       disabled (2)
       }
    MAX-ACCESS read-create
    STATUS current
    DESCRIPTION 
      "This scalar object specify the PPP work status (enabled or 
         disabled) for VLAN based management plane. default value is enabled,
this attribute is used when the DoubleDCNMode is used."
::= { opticsIMIfDataManagementPlaneEntry  10 }
--- CRB Oct2011 End                                                 
                                                 
-- ******************************************************************
-- opticsIMIfDataManagementPlaneL3Table
-- ******************************************************************

opticsIMIfDataManagementPlaneL3Table OBJECT-TYPE
    SYNTAX SEQUENCE OF OpticsIMIfDataManagementPlaneL3Entry
    MAX-ACCESS not-accessible
    STATUS current
    DESCRIPTION 
        "This table contains the configuration of management plane carried by data interfaced (In Band) using L3."
::= { opticsIMCommRouMibObject 23 }

opticsIMIfDataManagementPlaneL3Entry OBJECT-TYPE
    SYNTAX OpticsIMIfDataManagementPlaneL3Entry
    MAX-ACCESS not-accessible
    STATUS current
    DESCRIPTION 
        "This is the configured management plane In-Band interface using L3."
    INDEX { opticsIMIfDataManagementPlaneL3Id }
::= { opticsIMIfDataManagementPlaneL3Table 1 }

OpticsIMIfDataManagementPlaneL3Entry ::= SEQUENCE {
     opticsIMIfDataManagementPlaneL3Id			Integer32,
     opticsIMIfDataManagementPlaneL3IpAddress		IpAddress,
     opticsIMIfDataManagementPlaneL3IpMask		IpAddress,
     opticsIMIfDataManagementPlaneL3IpRoutingProtocol	OpticsIMIpRoutingProtocol,
     opticsIMIfDataManagementPlaneL3OspfAreaPointer  	Integer32,
     opticsIMIfDataManagementPlaneL3Label		Integer32,
     opticsIMIfDataManagementPlaneL3RowStatus		RowStatus,
     opticsIMIfDataManagementPlaneL3IPv6Address		InetAddressIPv6,
     opticsIMIfDataManagementPlaneL3IPv6PrefixLength	Unsigned32,
     opticsIMIfDataManagementPlaneL3IPv6RoutingProtocol	OpticsIMIpRoutingProtocol,
     opticsIMIfDataManagementPlaneL3Ospfv3AreaPointer   Integer32,
     opticsIMIfDataManagementPlaneL3DSCP    		INTEGER,
     opticsIMIfDataManagementPlaneL3PCP    		INTEGER,
     opticsIMIfDataManagementPlaneL3DefGateway          IpAddress,
     opticsIMIfDataManagementPlaneL3IPv6DefGateway      InetAddressIPv6,
opticsIMIfDataManagementPlaneL3InBandForwardingStatus INTEGER,
opticsIMIfDataManagementPlaneL3MacAddress MacAddress
    }

opticsIMIfDataManagementPlaneL3Id OBJECT-TYPE
    SYNTAX Integer32 (1..999) 
    MAX-ACCESS not-accessible
    STATUS current
    DESCRIPTION 
        "This is the number identifier of the In-band interface. "
::= { opticsIMIfDataManagementPlaneL3Entry 1 }

opticsIMIfDataManagementPlaneL3IpAddress OBJECT-TYPE
    SYNTAX IpAddress
    MAX-ACCESS read-create
    STATUS current
    DESCRIPTION 
        "This is the the In-band interface address."
::= { opticsIMIfDataManagementPlaneL3Entry 2 }

opticsIMIfDataManagementPlaneL3IpMask OBJECT-TYPE
    SYNTAX IpAddress
    MAX-ACCESS read-create
    STATUS current
    DESCRIPTION 
        "This is the In-band interface mask."
::= { opticsIMIfDataManagementPlaneL3Entry 3 }

opticsIMIfDataManagementPlaneL3IpRoutingProtocol OBJECT-TYPE
    SYNTAX  OpticsIMIpRoutingProtocol 
    MAX-ACCESS read-create
    STATUS current
    DESCRIPTION 
        "This object represents the routing protocol information."
::= { opticsIMIfDataManagementPlaneL3Entry 4 }

opticsIMIfDataManagementPlaneL3OspfAreaPointer OBJECT-TYPE
    SYNTAX Integer32 (0..999)
    MAX-ACCESS read-create
    STATUS current
    DESCRIPTION 
        "This is the pointer to the associated OSPF area."
::= { opticsIMIfDataManagementPlaneL3Entry 5 }

opticsIMIfDataManagementPlaneL3Label OBJECT-TYPE
    SYNTAX Integer32
    MAX-ACCESS read-create
    STATUS current
    DESCRIPTION 
		"This is the label which tags the management plane packets,
		 discriminating them from the data plane ones.
		 In case of Ethernet interface the label is the VLAN."
::= { opticsIMIfDataManagementPlaneL3Entry 6 }


opticsIMIfDataManagementPlaneL3RowStatus OBJECT-TYPE
    SYNTAX RowStatus
    MAX-ACCESS read-create
    STATUS current
    DESCRIPTION 
       "This object is used to create / delete a In-band interface."
::= { opticsIMIfDataManagementPlaneL3Entry 7 }

opticsIMIfDataManagementPlaneL3IPv6Address OBJECT-TYPE
    SYNTAX InetAddressIPv6
    MAX-ACCESS read-create
    STATUS current
    DESCRIPTION 
        "This is the the In-band interface address in the IPv6 format."
::= { opticsIMIfDataManagementPlaneL3Entry 8 }

opticsIMIfDataManagementPlaneL3IPv6PrefixLength OBJECT-TYPE
    SYNTAX Unsigned32 (0..128)
    MAX-ACCESS read-create
    STATUS current
    DESCRIPTION 
        "This object defines the  length of the prefix associated to the 
         In-band interface IP address when the IPv6 addressing is used."
::= { opticsIMIfDataManagementPlaneL3Entry 9 }

opticsIMIfDataManagementPlaneL3IPv6RoutingProtocol OBJECT-TYPE
    SYNTAX  OpticsIMIpRoutingProtocol 
    MAX-ACCESS read-create
    STATUS current
    DESCRIPTION 
        "This object represents the routing protocol information."
::= { opticsIMIfDataManagementPlaneL3Entry 10 }

opticsIMIfDataManagementPlaneL3Ospfv3AreaPointer OBJECT-TYPE
    SYNTAX Integer32 (0..999)
    MAX-ACCESS read-create
    STATUS current
    DESCRIPTION 
        "This is the pointer to the associated OSPF area."
::= { opticsIMIfDataManagementPlaneL3Entry 11 }

opticsIMIfDataManagementPlaneL3DSCP  OBJECT-TYPE
    SYNTAX INTEGER (0..63)
    MAX-ACCESS read-write
    STATUS current
    DESCRIPTION 
        "The DSCP value provided by managing system for the frames of the In-band interface"
::= { opticsIMIfDataManagementPlaneL3Entry 12 }

opticsIMIfDataManagementPlaneL3PCP  OBJECT-TYPE
    SYNTAX INTEGER (0..7)
    MAX-ACCESS read-write
    STATUS current
    DESCRIPTION 
        "The PCP value provided by managing system for the frames of the In-band interface.
         Default value is 7."
::= { opticsIMIfDataManagementPlaneL3Entry 13 }

opticsIMIfDataManagementPlaneL3DefGateway OBJECT-TYPE
    SYNTAX IpAddress
    MAX-ACCESS read-write
    STATUS current
    DESCRIPTION 
        "The ip address of the default gateway."
::= { opticsIMIfDataManagementPlaneL3Entry 14 }

opticsIMIfDataManagementPlaneL3IPv6DefGateway  OBJECT-TYPE
    SYNTAX InetAddressIPv6
    MAX-ACCESS read-write
    STATUS current
    DESCRIPTION 
        "The ip address (IPV6 format) of the default gateway."
::= { opticsIMIfDataManagementPlaneL3Entry 15 }

opticsIMIfDataManagementPlaneL3InBandForwardingStatus  OBJECT-TYPE
    SYNTAX INTEGER {
       enabled  (1),
       disabled (2)
       }
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION 
        "The TMN In-Band Forwarding status (enabled/disabled)."
::= { opticsIMIfDataManagementPlaneL3Entry 16 }

opticsIMIfDataManagementPlaneL3MacAddress  OBJECT-TYPE
    SYNTAX MacAddress
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION 
        "This is the MAC address of the TMN in Band interface."
::= { opticsIMIfDataManagementPlaneL3Entry 17 }

 
-- ******************************************************************
-- The list of ethernet ports allowed for an In-band interface
-- ******************************************************************

opticsIMIfDataManagementPlaneL3PortListTable OBJECT-TYPE
    SYNTAX      SEQUENCE OF OpticsIMIfDataManagementPlaneL3PortListEntry
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION
       "List of ports in NE that are allowed to trasmit/receive frames for an In-band interface.
        Since SNMP SMI does not allow to state in a MIB that an object in 
        a table is an array, the information has to be stored in another 
        table with two indices, being the first index, the index of the table 
        that contains the list or array.
       "
    ::= { opticsIMCommRouMibObject 24 }

opticsIMIfDataManagementPlaneL3PortListEntry OBJECT-TYPE
    SYNTAX      OpticsIMIfDataManagementPlaneL3PortListEntry
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION
       "The allowed ports table entry."
    INDEX { opticsIMIfDataManagementPlaneL3Id,
            opticsIMIfDataManagementPlaneL3PortIfIndex
          }
    ::= { opticsIMIfDataManagementPlaneL3PortListTable 1 }

OpticsIMIfDataManagementPlaneL3PortListEntry ::= SEQUENCE {
      opticsIMIfDataManagementPlaneL3PortIfIndex  	InterfaceIndex,
      opticsIMIfDataManagementPlaneL3PortListRowStatus  RowStatus
    }

opticsIMIfDataManagementPlaneL3PortIfIndex  	OBJECT-TYPE
    SYNTAX      InterfaceIndex
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION
       "The index of the physical interface where the Management interface (TMN) In-Band is enabled"
    ::= { opticsIMIfDataManagementPlaneL3PortListEntry 1 }

opticsIMIfDataManagementPlaneL3PortListRowStatus  OBJECT-TYPE
    SYNTAX      RowStatus
    MAX-ACCESS  read-create
    STATUS      current
    DESCRIPTION
       "The status of the row. Read SNMPv2-TC (RFC1903) for an
        explanation of the possible values this object can take.
       "
    ::= { opticsIMIfDataManagementPlaneL3PortListEntry 2 }

--

opticsIMClnsStatus OBJECT-TYPE
    SYNTAX INTEGER {
       enabled  (1),
       disabled (2)
       }
    MAX-ACCESS read-write
    STATUS current
    DESCRIPTION 
      "This scalar object specify the CLNS work status(enabled or 
         disabled)."
    DEFVAL { enabled }
::= { opticsIMCommRouMibObject 20 }

-- opticsIMNeighborNeTable --

opticsIMNeighborNeTable OBJECT-TYPE
    SYNTAX SEQUENCE OF OpticsIMNeighborNeEntry
    MAX-ACCESS not-accessible
    STATUS current
    DESCRIPTION 
        "This table contains the information of NE's neighbor retrieved by auto-discovery functions."
::= { opticsIMCommRouMibObject 21 }

opticsIMNeighborNeEntry OBJECT-TYPE
    SYNTAX OpticsIMNeighborNeEntry
    MAX-ACCESS not-accessible
    STATUS current
    DESCRIPTION 
		"This is the information of NE's neighbor retrieved by auto-discovery functions."
    INDEX { opticsIMNeighborNeId }
::= { opticsIMNeighborNeTable 1 }

OpticsIMNeighborNeEntry ::= SEQUENCE {
    opticsIMNeighborNeId                 Integer32,
    opticsIMNeighborNeIpAddress          IpAddress,
    opticsIMNeighborNeConnectionType     OpticsIMNeighborConnectionType     
}

opticsIMNeighborNeId OBJECT-TYPE
    SYNTAX Integer32 (1..999) 
    MAX-ACCESS not-accessible
    STATUS current
    DESCRIPTION 
        "This is the neighbor identifier number. "
::= { opticsIMNeighborNeEntry 1 }

opticsIMNeighborNeIpAddress OBJECT-TYPE  
    SYNTAX IpAddress 
    MAX-ACCESS read-create 
    STATUS current 
    DESCRIPTION  
        "This is the IP address information of the neighbor" 
::= { opticsIMNeighborNeEntry 2 }

opticsIMNeighborNeConnectionType OBJECT-TYPE
    SYNTAX OpticsIMNeighborConnectionType
    MAX-ACCESS read-create
    STATUS current
    DESCRIPTION 
        "This object indicates the connection type of neighbor NE."
::= { opticsIMNeighborNeEntry 3 }

opticsIMDhcpStatus OBJECT-TYPE
    SYNTAX INTEGER {
       enabled  (1),
       disabled (2)
       }
    MAX-ACCESS read-write
    STATUS current
    DESCRIPTION 
      "This scalar object specify the DHCP server status (enabled or 
         disabled)."
    DEFVAL { enabled }
::= { opticsIMCommRouMibObject 22 }


-- ****************************************************************************
-- The Ospf Area table for protocol v3 to use when the IPv6 addressing is used
-- ****************************************************************************


opticsIMOspfV3RouterId OBJECT-TYPE
  SYNTAX IpAddress
  MAX-ACCESS read-write
  STATUS current
  DESCRIPTION
    "This scalar object defines the RouterId of the NE used by OspfV3 protocol"
::= { opticsIMCommRouMibObject 26 }


opticsIMOspfV3AreaTable OBJECT-TYPE
    SYNTAX SEQUENCE OF OpticsIMOspfV3AreaEntry
    MAX-ACCESS not-accessible
    STATUS current
    DESCRIPTION 
        "This table contains the Ospf Area routing information for protocol Version 3. 
         This information are used in order to manage the IP routing
         functionality."
::= { opticsIMCommRouMibObject 27 }

opticsIMOspfV3AreaEntry OBJECT-TYPE
    SYNTAX OpticsIMOspfV3AreaEntry
    MAX-ACCESS not-accessible
    STATUS current
    DESCRIPTION 
        "Each row describes the Ospf Area routing information.
         The row identified by AreaId 0 and IpAddress 0.0.0.0 is used for the
         Ospf backbone default value. This row is created by the agent and not        
         managed (deleted or modified) by management system."
    INDEX { opticsIMOspfV3AreaId }
::= { opticsIMOspfV3AreaTable 1 }

OpticsIMOspfV3AreaEntry ::= SEQUENCE {
    opticsIMOspfV3AreaId        Integer32,
    opticsIMOspfV3AreaIpAddress IpAddress,
    opticsIMOspfV3AreaStubFlag  TruthValue,  
    opticsIMOspfV3AreaRowStatus RowStatus
    }

opticsIMOspfV3AreaId OBJECT-TYPE
    SYNTAX Integer32 (0..999) 
    MAX-ACCESS not-accessible
    STATUS current
    DESCRIPTION 
        "This is the Ospf area identifier number. "
::= { opticsIMOspfV3AreaEntry 1 }

opticsIMOspfV3AreaIpAddress OBJECT-TYPE
    SYNTAX IpAddress
    MAX-ACCESS read-create
    STATUS current
    DESCRIPTION 
        "This is the Ospf area address."
::= { opticsIMOspfV3AreaEntry 2 }

opticsIMOspfV3AreaStubFlag OBJECT-TYPE
    SYNTAX TruthValue
    MAX-ACCESS read-create
    STATUS current
    DESCRIPTION 
        "This is the Ospf stub flag."
::= { opticsIMOspfV3AreaEntry 3 }

opticsIMOspfV3AreaRowStatus OBJECT-TYPE
    SYNTAX RowStatus
    MAX-ACCESS read-create
    STATUS current
    DESCRIPTION 
        "This object is used to create / delete an OSPF area."
::= { opticsIMOspfV3AreaEntry 4 }


-- ******************************************************************
-- The Static Routing table to use when the IPv6 addressing is used
-- ******************************************************************

 opticsIMIPv6StaticIndexNext OBJECT-TYPE  
       SYNTAX            Unsigned32  
       MAX-ACCESS        read-only  
       STATUS            current  
       DESCRIPTION  
           "This object contains an appropriate value to be used  
            for opticsIMIIPv6StaticIndex when creating entries in the  
            opticsIMIPv6StaticRoutingInfoTable. The value 0 indicates that no  
            unassigned entries are available.  To obtain the  
            value of opticsIMIIPv6StaticIndex for a new entry in the  
            opticsIMIPv6StaticRoutingInfoTable , the manager issues a management  
            protocol retrieval operation. The agent will determine 
            through its local policy when this index value will be made  
            available for reuse."  
        
::= { opticsIMCommRouMibObject 28 }

opticsIMIPv6StaticRoutingInfoTable OBJECT-TYPE
    SYNTAX SEQUENCE OF OpticsIMIPv6StaticRoutingInfoEntry
    MAX-ACCESS not-accessible
    STATUS current
    DESCRIPTION 
        "This table contains the Ip static routing  information in IPv6 format. 
         This information are used in order to manage the IP routing
         functionality"
::= { opticsIMCommRouMibObject 29 }

opticsIMIPv6StaticRoutingInfoEntry OBJECT-TYPE
    SYNTAX OpticsIMIPv6StaticRoutingInfoEntry
    MAX-ACCESS not-accessible
    STATUS current
    DESCRIPTION 
        "Each row describes the IP static routing information."
    INDEX { opticsIMIPv6StaticIndex}
::= { opticsIMIPv6StaticRoutingInfoTable 1 }

OpticsIMIPv6StaticRoutingInfoEntry ::= SEQUENCE {
    opticsIMIPv6StaticIndex		INTEGER,
    opticsIMIPv6StaticIPv6Address  	InetAddressIPv6,
    opticsIMIPv6StaticIPv6PrefixLength	Unsigned32,
    opticsIMIPv6StaticDefGateway 	InetAddressIPv6,
    opticsIMIPv6StaticInterfaceIndex    InterfaceIndexOrZero,
    opticsIMIPv6StaticRowStatus   	RowStatus
    }

opticsIMIPv6StaticIndex OBJECT-TYPE
    SYNTAX INTEGER
    MAX-ACCESS not-accessible
    STATUS current
    DESCRIPTION 
        "The index of this table."
::= { opticsIMIPv6StaticRoutingInfoEntry 1 }

opticsIMIPv6StaticIPv6Address OBJECT-TYPE
    SYNTAX InetAddressIPv6
    MAX-ACCESS read-create
    STATUS current
    DESCRIPTION 
        "The host or network IpAddress in IPv6 format."
::= { opticsIMIPv6StaticRoutingInfoEntry 2 }

opticsIMIPv6StaticIPv6PrefixLength OBJECT-TYPE
    SYNTAX Unsigned32 (0..128)
    MAX-ACCESS read-create
    STATUS current
    DESCRIPTION 
        "This object defines the  length of the prefix associated to the 
         network IP address when the IPv6 addressing is used."
::= { opticsIMIPv6StaticRoutingInfoEntry 3 }

opticsIMIPv6StaticDefGateway OBJECT-TYPE
    SYNTAX InetAddressIPv6
    MAX-ACCESS read-create
    STATUS current
    DESCRIPTION 
        "The ip address in IPv6 format of the default gateway."
::= { opticsIMIPv6StaticRoutingInfoEntry 4 }

opticsIMIPv6StaticInterfaceIndex OBJECT-TYPE
    SYNTAX InterfaceIndexOrZero
    MAX-ACCESS read-create
    STATUS current
    DESCRIPTION 
        "This object identifies the entry inside the ifTable 
         which describes the AAL interface."
::= { opticsIMIPv6StaticRoutingInfoEntry 5 }

opticsIMIPv6StaticRowStatus OBJECT-TYPE
    SYNTAX RowStatus
    MAX-ACCESS read-create
    STATUS current
    DESCRIPTION 
        "This object is used to create / delete a row."
::= { opticsIMIPv6StaticRoutingInfoEntry 6 }


-- ******************************************************************
-- The Ip Routing information table reported when the IPv6 addressing is used
-- ******************************************************************

opticsIMIPv6RoutingInfoTable OBJECT-TYPE
    SYNTAX SEQUENCE OF OpticsIMIPv6RoutingInfoEntry
    MAX-ACCESS not-accessible
    STATUS current
    DESCRIPTION 
        "This table contains the Ip routing  information in IPv6 format. 
         This information can be retrieve by managers for maintenance 
         purposes. 
         The agent can fill in this table only as a consequence of a 
         GET-Request from a manager"
::= { opticsIMCommRouMibObject 30 }

opticsIMIPv6RoutingInfoEntry OBJECT-TYPE
    SYNTAX OpticsIMIPv6RoutingInfoEntry
    MAX-ACCESS not-accessible
    STATUS current
    DESCRIPTION 
        "Each row describes the IP  routing information."
    INDEX { opticsIMIPv6RoutingInfoIndex }
::= { opticsIMIPv6RoutingInfoTable 1 }

OpticsIMIPv6RoutingInfoEntry ::= SEQUENCE {
    opticsIMIPv6RoutingInfoIndex		INTEGER,
    opticsIMIPv6RoutingDestIPv6Address  	InetAddressIPv6,
    opticsIMIPv6RoutingDestIPv6PrefixLength    	Unsigned32,
    opticsIMIPv6RoutingDefGateway  		InetAddressIPv6,
    opticsIMIPv6RoutingMetricValue 		Integer32,
    opticsIMIPv6RoutingRouteAge  		Integer32,
    opticsIMIPv6RoutingRouteType  		INTEGER,
    opticsIMIPv6RoutingProtocol   		OpticsIMIpRoutingProtocol,
    opticsIMIPv6RoutingLocalPtpInterface    	Integer32
    }

opticsIMIPv6RoutingInfoIndex OBJECT-TYPE
    SYNTAX INTEGER
    MAX-ACCESS not-accessible
    STATUS current
    DESCRIPTION 
        "The index of the table."
::= { opticsIMIPv6RoutingInfoEntry 1 }

opticsIMIPv6RoutingDestIPv6Address  OBJECT-TYPE
    SYNTAX InetAddressIPv6
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION 
        "This object describes the host or network IpAddress in the IPv6 format."
::= { opticsIMIPv6RoutingInfoEntry 2 }

opticsIMIPv6RoutingDestIPv6PrefixLength    	OBJECT-TYPE
    SYNTAX Unsigned32 (0..128)
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION 
       "This object defines the  length of the prefix associated to the 
         network IP address when the IPv6 addressing is used."
::= { opticsIMIPv6RoutingInfoEntry 3 }

opticsIMIPv6RoutingDefGateway OBJECT-TYPE
    SYNTAX InetAddressIPv6
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION 
        "The ip address of the default gateway in the IPv6 format."
::= { opticsIMIPv6RoutingInfoEntry 4 }

opticsIMIPv6RoutingMetricValue OBJECT-TYPE
    SYNTAX Integer32
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION 
        "This object represents the metric information ."
::= { opticsIMIPv6RoutingInfoEntry 5 }

opticsIMIPv6RoutingRouteAge OBJECT-TYPE
    SYNTAX Integer32
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION 
        "This object represents the route age information ."
::= { opticsIMIPv6RoutingInfoEntry 6 }

opticsIMIPv6RoutingRouteType OBJECT-TYPE
    SYNTAX INTEGER {
        indirect ( 1 ),
        direct   ( 2 ) }
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION 
        "This object represents the route type information ."
::= { opticsIMIPv6RoutingInfoEntry 7 }

opticsIMIPv6RoutingProtocol OBJECT-TYPE
    SYNTAX OpticsIMIpRoutingProtocol
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION 
        "This object represents the routing protocol information ."
::= { opticsIMIPv6RoutingInfoEntry 8 }

opticsIMIPv6RoutingLocalPtpInterface OBJECT-TYPE
    SYNTAX Integer32
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION 
        "This object represents the routing point to point interface ."
::= { opticsIMIPv6RoutingInfoEntry 9 }


--  END

-- TSDIM-CommRou-MC DEFINITIONS ::= BEGIN
--     IMPORTS
--     MODULE-IDENTITY, OBJECT-TYPE FROM SNMPv2-SMI
--     MODULE-COMPLIANCE, NOTIFICATION-GROUP, OBJECT-GROUP FROM SNMPv2-CONF
--     opticsIMBasicMC FROM TSDIM-BASICREG-MIB;

-- opticsIMCommRouMCCompl

-- opticsIMCommRouMCCompl MODULE-IDENTITY
-- LAST-UPDATED "0107180000Z"
-- ORGANIZATION "Alcatel TND"
-- CONTACT-INFO "Alcatel TND"
-- DESCRIPTION
--       "Joined the MIB and MC for ATM and IP equipments.
--        Added GenEvent object"
-- REVISION "0104130000Z"
-- DESCRIPTION
--       "The event notification and time have been added to 
--        the polled table"
-- REVISION "0009290000Z"
-- DESCRIPTION
--      "Bug Fixing"
-- REVISION "0004140000Z"
-- DESCRIPTION
--      "Initial Release"
-- ::= { opticsIMCommRouMCConf 1 }

opticsIMCommRouMCConf       OBJECT IDENTIFIER ::= { tsdimBasicMC 3 }
opticsIMCommRouMCCompl      OBJECT IDENTIFIER ::= { opticsIMCommRouMCConf 1 }
opticsIMCommRouMCGroup      OBJECT IDENTIFIER ::= { opticsIMCommRouMCConf 2 }

opticsIMCommRouMc MODULE-COMPLIANCE
    STATUS current
    DESCRIPTION 
        "This module compliance describes a set of objects required 
         for TSD-IM SNMP Agent implementation. These objects are
         defined inside opticsIMCommRouMib"

    MODULE -- opticsIMCommRouMib

GROUP opticsIMOptCommRouPollingGroup
    DESCRIPTION
        "This group contains the objects used in Manager-Agent
         polling management."

GROUP opticsIMOptIpRoutingGroup
    DESCRIPTION
        "This group contains the objects used in non IP equipment for IP
         routing management."

GROUP opticsIMOptIPv6RoutingGroup
    DESCRIPTION
        "This group contains the objects used in non IP equipment for IP
         routing management when IPv6 addressing is used."

GROUP opticsIMOptCommRouOptPollingGroup
    DESCRIPTION
        "This group contains the optional objects used in Manager-Agent
         polling management."


GROUP opticsIMOptLocalEthernetGroup
    DESCRIPTION
        "This group describes the objects needed for the for the local
         ethernet port management."

GROUP opticsIMOptLocalEthernetIPv6Group
    DESCRIPTION
        "This group describes the objects needed for the for the local
         ethernet port management."

GROUP opticsIMOptPointToPointIPGroup
    DESCRIPTION
        "This group describes the objects needed for the point-to-point IP
         ports management."

GROUP opticsIMOptPointToPointIPv6Group
    DESCRIPTION
        "This group describes the objects needed for the point-to-point IP
         ports management."

GROUP opticsIMLAPDGroup
DESCRIPTION
          " This group describes the objects related to the LAPD ports."

GROUP opticsIMIPTunnelGroup
DESCRIPTION
          " This group describes the objects related to the IP tunnel."

GROUP opticsIMAutoDiscoveryGroup
DESCRIPTION
          " This group describes the objects related to the NE autodiscovery."

::= { opticsIMCommRouMCCompl 1 }

-- Units of conformance

opticsIMOptCommRouPollingGroup OBJECT-GROUP
    OBJECTS { opticsIMMgrPollingIpAddress,
        opticsIMMgrPollingIPv6Address,
        opticsIMMgrPollingUdpPort,
        opticsIMMgrPollingTimeOut,
        opticsIMInfoLastAlarmNotificationId,
        opticsIMInfoLastAlarmTime ,
        opticsIMInfoNERestartFlag,  
        opticsIMInfoLastEventNotificationId,
        opticsIMInfoLastEventTime ,
        opticsIMMgrPollingRowStatus  }
    STATUS current
    DESCRIPTION 
        "This group describes the objects needed for the polling
         handling"
::= { opticsIMCommRouMCGroup 1 }

opticsIMOptIpRoutingGroup OBJECT-GROUP
    OBJECTS { opticsIMOspfAreaIpAddress,
        opticsIMOspfAreaIpMask,
        opticsIMOspfAreaStubFlag,
        opticsIMIpStaticIpMask,
        opticsIMIpStaticDefGateway,
        opticsIMIpStaticInterfaceIndex,
        opticsIMIpStaticRowStatus,
        opticsIMIpRoutingDestIpMask,
        opticsIMIpRoutingDefGateway,
        opticsIMIpRoutingMetricValue,
        opticsIMIpRoutingRouteAge,
        opticsIMIpRoutingRouteType,
        opticsIMIpRoutingProtocol,
        opticsIMIpRoutingLocalPtpInterface }
    STATUS current
    DESCRIPTION 
        "This group describes the objects needed for the IP routing
         management. It is mandatory only for agent that provide

         the IP routing functionality."
::= { opticsIMCommRouMCGroup 2 }

opticsIMOptIPv6RoutingGroup OBJECT-GROUP
    OBJECTS { opticsIMOspfV3RouterId,
        opticsIMOspfV3AreaIpAddress,
        opticsIMOspfV3AreaStubFlag,
        opticsIMIPv6StaticIPv6Address, 	
        opticsIMIPv6StaticIPv6PrefixLength,	
        opticsIMIPv6StaticDefGateway,
        opticsIMIPv6StaticInterfaceIndex,
        opticsIMIPv6StaticRowStatus,

        opticsIMIPv6RoutingDestIPv6Address, 	
        opticsIMIPv6RoutingDestIPv6PrefixLength,	
        opticsIMIPv6RoutingDefGateway,
        opticsIMIPv6RoutingMetricValue,
        opticsIMIPv6RoutingRouteAge,	
        opticsIMIPv6RoutingRouteType,  		
        opticsIMIPv6RoutingProtocol, 		
        opticsIMIPv6RoutingLocalPtpInterface }
    STATUS current
    DESCRIPTION 
        "This group describes the objects needed for the IP routing
         management. It is mandatory only for agent that provide

         the IP routing functionality when the IPv6 addressing is used."
::= { opticsIMCommRouMCGroup 9 }

opticsIMOptCommRouOptPollingGroup OBJECT-GROUP
    OBJECTS { opticsIMInfoLastGenEventNotificationId,
        opticsIMInfoLastGenEventTime }
    STATUS current
    DESCRIPTION 
        "This group describes the optional objects to be added to 
         the polling functionality "
::= { opticsIMCommRouMCGroup 3 }

opticsIMOptLocalEthernetGroup OBJECT-GROUP
    OBJECTS {opticsIMLocalEthernetMacAddress,

        opticsIMLocalEthernetIpAddress,
        opticsIMLocalEthernetIpMask,
        opticsIMLocalEthernetIpRoutingProtocol,
        opticsIMLocalEthernetOspfAreaPointer,
        opticsIMLocalEthernetRowStatus,
        opticsIMLocalEthernetAsapIndex  }
    STATUS current
    DESCRIPTION 
        "This group describes the objects needed for the local ethernet 
         port management."
::= { opticsIMCommRouMCGroup 4 }

opticsIMOptLocalEthernetIPv6Group OBJECT-GROUP
    OBJECTS {opticsIMLocalEthernetIPv6Address,		
    	opticsIMLocalEthernetIPv6PrefixLength,	
    	opticsIMLocalEthernetIPv6RoutingProtocol,	
    	opticsIMLocalEthernetOspfv3AreaPointer}
    STATUS current
    DESCRIPTION 
        "This group describes the objects needed for the local ethernet 
         port management when the IPv6 addressing is used."
::= { opticsIMCommRouMCGroup 10 }

opticsIMOptPointToPointIPGroup OBJECT-GROUP
    OBJECTS { opticsIMPointToPointIPType,
        opticsIMPointToPointIPMode,
        opticsIMPointToPointIPRoutingProtocol,
        opticsIMPointToPointIPOspfAreaPointer,
        opticsIMPointToPointIPRemoteAddress, 
        opticsIMPointToPointIPRowStatus,
        opticsIMPointToPointIPAsapIndex }
    STATUS current
    DESCRIPTION 
        "This group describes the objects needed for the point-to-point IP
         ports management."
::= { opticsIMCommRouMCGroup 5 }

opticsIMOptPointToPointIPv6Group OBJECT-GROUP
    OBJECTS { opticsIMPointToPointIPv6RemoteAddress,
        opticsIMPointToPointIPv6RoutingProtocol,
        opticsIMPointToPointOspfv3AreaPointer }
    STATUS current
    DESCRIPTION 
        "This group describes the objects needed for the point-to-point IP
         ports management when the IPv6 addressing is used."
::= { opticsIMCommRouMCGroup 11 }

opticsIMLAPDGroup OBJECT-GROUP
    OBJECTS { opticsIMLAPDPhysicalLayer,
              opticsIMLAPDStatus,
              opticsIMLAPDRole
              }
    STATUS current 
    DESCRIPTION 
        " This group describes the LAPD objects." 
::= { opticsIMCommRouMCGroup 6 }

opticsIMIPTunnelGroup OBJECT-GROUP
    OBJECTS { opticsIMIPTunnelIPAddress,
              opticsIMIPTunnelRowStatus
              }
    STATUS current 
    DESCRIPTION 
        " This group describes the IP tunnel objects." 
::= { opticsIMCommRouMCGroup 7 }

opticsIMAutoDiscoveryGroup OBJECT-GROUP
    OBJECTS { opticsIMNeighborNeIpAddress,
              opticsIMNeighborNeConnectionType
              }
    STATUS current 
    DESCRIPTION 
        " This group describes the objects related to NE auto-discovery." 
::= { opticsIMCommRouMCGroup 8 }

END

